            "value": "推定値が増えると分析情報も充実します"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีค่าประมาณเพิ่ม การวิเคราะห์ก็ละเอียดขึ้น"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S dalšími měřeními přibývají poznatky"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli approfondimenti si arricchiscono con le misurazioni"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mérésekkel újabb összefüggések rajzolódnak ki"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu fiecare măsurătoare apar noi informații"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε νέα μέτρηση προσθέτει πληροφορίες"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolejne pomiary dostarczają więcej informacji"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé meranie prináša nové poznatky"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje mätning ger mer information"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תובנות נוספות מצטברות עם המדידות"
          }
        }
      }
