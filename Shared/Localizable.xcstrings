    "No outdoor walks, runs, or hikes found in Apple Health. Those are the sessions Apple Health can draw a new estimate from.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No outdoor walks, runs, or hikes found in Apple Health. Those are the sessions Apple Health can draw a new estimate from."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Apple Health wurden keine Spaziergänge, Läufe oder Wanderungen im Freien gefunden. Das sind die Sitzungen, aus denen Apple Health eine neue Schätzung ableiten kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune promenade, course ou randonnée en plein air trouvée dans Apple Health. Ce sont les sessions à partir desquelles Apple Health peut tirer une nouvelle estimation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen buitenwandelingen, hardloopsessies of trektochten gevonden in Apple Health. Dat zijn de sessies waar Apple Health een nieuwe schatting uit kan halen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 中未發現戶外散步、跑步或遠足。這些是會話 Apple Health 可以從中得到新的估計。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Apple Health не обнаружено прогулок, пробежек или походов на свежем воздухе. Это сеансы, на основе которых Apple Health может получить новую оценку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على جولات مشي أو ركض أو مشي لمسافات طويلة في الهواء الطلق في Apple Health. تلك هي الجلسات التي يمكن لـ Apple Health استخلاص تقدير جديد منها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron caminatas, carreras o caminatas al aire libre en Apple Health. Esas son las sesiones de las que Apple Health puede extraer una nueva estimación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health には屋外の散歩、ランニング、ハイキングが見つかりません。これらは、Apple Health が新しい推定値を引き出すことができるセッションです。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบการเดิน วิ่ง หรือเดินป่ากลางแจ้งใน Apple Health สิ่งเหล่านี้คือเซสชัน Apple Health สามารถประมาณค่าใหม่ได้"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V Apple Health nebyly nalezeny žádné venkovní procházky, běhy ani túry. Z těchto relací může Apple Health čerpat nový odhad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna passeggiata, corsa o escursione all'aperto trovata in Apple Health. Queste sono le sessioni da cui Apple Health può trarre una nuova stima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Health területén nem található szabadtéri séták, futások vagy túrák. Ezek azok a munkamenetek, amelyekből Apple Health új becslést tud készíteni."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-au găsit plimbări, alergări sau drumeții în aer liber în Apple Health. Acestea sunt sesiunile din care Apple Health poate extrage o nouă estimare."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκαν υπαίθριοι περίπατοι, τρεξίματα ή πεζοπορίες στο Apple Health. Αυτές είναι οι συνεδρίες από τις οποίες το Apple Health μπορεί να αντλήσει μια νέα εκτίμηση."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Apple Health nie znaleziono spacerów, biegów ani wędrówek na świeżym powietrzu. Są to sesje, z których Apple Health może wyciągnąć nowe oszacowanie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V Apple Health sa nenachádzajú žiadne vonkajšie prechádzky, beh ani túry. Toto sú relácie, z ktorých môže Apple Health čerpať nový odhad."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga utomhuspromenader, löpturer eller vandringar hittades i Apple Health. Det är dessa sessioner Apple Health kan dra en ny uppskattning från."
          }
        }
      }
    },
