    "A cardio fitness trend is motivational context, not a medical assessment.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cardio fitness trend is motivational context, not a medical assessment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Cardio-Fitness-Trend ist ein Motivationskontext und keine medizinische Beurteilung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tendance en matière de cardio-fitness est un contexte de motivation et non une évaluation médicale."
          }
        },
        "nl": {
