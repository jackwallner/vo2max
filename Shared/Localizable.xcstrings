        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Acquisto una tantum. Accesso a vita, nessun abbonamento."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Egyszeri vásárlás. Élethosszig tartó hozzáférés, előfizetés nélkül."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Achiziție unică. Acces pe viață, fără abonament."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Εφάπαξ αγορά. Δια βίου πρόσβαση, χωρίς συνδρομή."
