        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجل Apple Health تقدير VO2 max بعد تمرين خارجي مؤهل باستخدام Apple Watch. %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health registra una estimación VO2 max después de un entrenamiento calificado al aire libre con Apple Watch. %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health は、Apple Watch による適格な屋外トレーニング後の VO2 max 推定値を記録します。 %1$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health บันทึกค่าประมาณ VO2 max หลังจากการออกกำลังกายกลางแจ้งตามเกณฑ์ด้วย Apple Watch %1$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health zaznamenává odhad VO2 max po kvalifikačním venkovním cvičení s Apple Watch. %1$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health registra una stima VO2 max dopo un allenamento outdoor qualificante con Apple Watch. %1$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Health VO2 max becslést rögzít a Apple Watch minősítő szabadtéri edzés után. %1$@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health înregistrează o estimare VO2 max după un antrenament de calificare în aer liber cu Apple Watch. %1$@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple Health καταγράφει μια εκτίμηση VO2 max μετά από μια κατάλληλη προπόνηση σε εξωτερικό χώρο με το Apple Watch. %1$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health rejestruje szacunkową wartość VO2 max po kwalifikacyjnym treningu na świeżym powietrzu z użyciem Apple Watch. %1$@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health zaznamenáva odhad VO2 max po kvalifikačnom cvičení vonku s Apple Watch. %1$@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health registrerar en VO2 max uppskattning efter ett kvalificerande utomhuspass med Apple Watch. %1$@"
          }
        }
      }
    },
