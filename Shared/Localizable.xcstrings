    "Four Apple Health estimates within 90 days are needed before the app labels a direction.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four Apple Health estimates within 90 days are needed before the app labels a direction."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App zeigt erst dann eine Entwicklung an, wenn innerhalb von 90 Tagen mindestens vier Apple Health-Schätzungen vorliegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut quatre estimations Apple Health sur 90 jours avant que l’app indique une tendance."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app geeft pas een trend aan als er binnen 90 dagen vier Apple Health-schattingen zijn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "90 天內至少要有四筆 Apple Health 估算值，App 才會顯示趨勢方向。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы приложение показало направление динамики, нужны как минимум четыре оценки Apple Health за 90 дней."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم توفر أربعة تقديرات من Apple Health خلال 90 يومًا حتى يعرض التطبيق اتجاهًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app necesita cuatro estimaciones de Apple Health en 90 días para indicar una tendencia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推移を表示するには、90日以内にApple Healthの推定値が4件必要です。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องมีค่าประมาณจาก Apple Health อย่างน้อย 4 รายการภายใน 90 วัน จึงจะแสดงแนวโน้มได้"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby aplikace určila směr vývoje, potřebuje čtyři odhady z Apple Health během 90 dnů."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono quattro stime di Apple Health in 90 giorni prima che l’app possa indicare una direzione."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A trend meghatározásához legalább négy Apple Health-becslés kell 90 napon belül."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația are nevoie de patru estimări Apple Health în 90 de zile pentru a indica o tendință."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρειάζονται τέσσερις εκτιμήσεις Apple Health μέσα σε 90 ημέρες για να προσδιοριστεί η τάση."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja określi trend, gdy Apple Health zapisze co najmniej cztery oszacowania w ciągu 90 dni."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na určenie trendu potrebuje aplikácia aspoň štyri odhady Apple Health za 90 dní."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen behöver fyra Apple Health-uppskattningar inom 90 dagar för att visa en riktning."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרשים ארבעה אומדנים מ-Apple Health במהלך 90 יום כדי שהאפליקציה תציג מגמה."
          }
        }
      }
    },
