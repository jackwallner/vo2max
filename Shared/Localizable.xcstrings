    "Trial wasn't started. Tap again to continue.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trial wasn't started. Tap again to continue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Testphase wurde nicht gestartet. Tippe erneut, um fortzufahren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’essai n’a pas démarré. Touchez à nouveau pour continuer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De proefperiode is niet gestart. Tik opnieuw om door te gaan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用尚未開始。請再次點一下以繼續。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробный период не начался. Нажмите ещё раз, чтобы продолжить."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يبدأ الإصدار التجريبي. اضغط مرة أخرى للمتابعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El periodo de prueba no se inició. Toca de nuevo para continuar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアルを開始できませんでした。もう一度タップして続けてください。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มช่วงทดลองใช้ฟรีไม่สำเร็จ แตะอีกครั้งเพื่อดำเนินการต่อ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkušební období se nespustilo. Klepnutím pokračuj."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il periodo di prova non è iniziato. Tocca di nuovo per continuare."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A próbaidőszak nem indult el. Koppints újra a folytatáshoz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Perioada de probă nu a început. Atinge din nou pentru a continua."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η δοκιμή δεν ξεκίνησε. Πατήστε ξανά για να συνεχίσετε."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okres próbny nie został rozpoczęty. Stuknij ponownie, aby kontynuować."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skúšobné obdobie sa nespustilo. Ťukni znova a pokračuj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Provperioden startade inte. Tryck igen för att fortsätta."
          }
        }
      }
    },
