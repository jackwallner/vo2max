    "Widgets and Apple Watch show your latest estimate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets and Apple Watch show your latest estimate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets und Apple Watch zeigen deine letzte Schätzung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les widgets et l’Apple Watch affichent votre dernière estimation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets en Apple Watch tonen je laatste schatting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小工具和 Apple Watch 會顯示最新估算值。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виджеты и Apple Watch показывают вашу последнюю оценку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُظهر الأدوات وApple Watch أحدث تقدير."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los widgets y el Apple Watch muestran tu última estimación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットとApple Watchに最新の推定値が表示されます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูค่าประมาณล่าสุดได้จากวิดเจ็ตและ Apple Watch"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgety a Apple Watch ukazují tvůj poslední odhad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget e Apple Watch mostrano l’ultima stima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A widgetek és az Apple Watch mutatják a legutóbbi becslést."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgeturile și Apple Watch arată ultima estimare."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα widget και το Apple Watch δείχνουν την πιο πρόσφατη εκτίμηση."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgety i Apple Watch pokazują Twoje ostatnie oszacowanie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgety a Apple Watch ukazujú najnovší odhad."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgetar och Apple Watch visar den senaste uppskattningen."
          }
        }
      }
    },
    "See your cardio fitness estimate and trend from Apple Health.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See your cardio fitness estimate and trend from Apple Health."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardiofitness-Schätzung und Verlauf aus Apple Health an einem Ort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimation cardio d’Apple Health et son évolution, réunies au même endroit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je cardiofitnessschatting van Apple Health en het verloop, samen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一畫面查看 Apple Health 的心適能估算值與趨勢。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценка кардиовыносливости и её динамика из Apple Health."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد تقدير اللياقة القلبية من Apple Health واتجاهه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta tu estimación de capacidad aeróbica de Apple Health y su evolución."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Healthの心肺機能の推定値と推移をひと目で確認できます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูค่าประมาณคาร์ดิโอฟิตเนสจาก Apple Health และแนวโน้มได้ในหน้าเดียว"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhad kardio kondice z Apple Health a jeho vývoj na jednom místě."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stima cardio di Apple Health e il suo andamento, insieme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Health kardiofitnesz-becslése és annak alakulása egy helyen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimarea de fitness cardio din Apple Health și evoluția ei, într-un loc."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκτίμηση καρδιαγγειακής κατάστασης και τάση από το Apple Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz ocenę sprawności cardio z Apple Health i jej trend w jednym miejscu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhad kardio kondície z Apple Health a jeho vývoj na jednom mieste."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se Apple Healths konditionsuppskattning och utveckling på ett ställe."
          }
        }
      }
    },
    "We'll ask permission to read your VO2 max estimates. We never write to Apple Health.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll ask permission to read your VO2 max estimates. We never write to Apple Health."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir fragen, ob wir deine VO2-max-Schätzungen lesen dürfen. Wir schreiben nichts in Apple Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous demanderons l’accès aux estimations de VO2 max. Nous n’écrivons rien dans Apple Health."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We vragen toegang tot je VO2-max-schattingen. We schrijven niets naar Apple Health."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們會詢問是否讀取 VO2 max 估算值。我們不會寫入 Apple Health。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы попросим доступ к оценкам VO2 max. Мы не записываем данные в Apple Health."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنطلب إذنًا لقراءة تقديرات VO2 max. لا نكتب بيانات إلى Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pediremos permiso para leer tus estimaciones de VO2 max. No escribimos en Apple Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2 maxの推定値を読み取る許可をお願いします。Apple Healthには書き込みません。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะขออนุญาตอ่านค่าประมาณ VO2 max และจะไม่เขียนข้อมูลลงใน Apple Health"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požádáme o přístup k odhadům VO2 max. Do Apple Health nic nezapisujeme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiederemo il permesso di leggere le stime di VO2 max. Non scriviamo su Apple Health."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyt kérünk a VO2 max-becslések olvasásához. Az Apple Healthbe nem írunk."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom cere permisiunea de a citi estimările VO2 max. Nu scriem în Apple Health."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα ζητήσουμε άδεια ανάγνωσης των εκτιμήσεων VO2 max. Δεν γράφουμε στο Apple Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprosimy o dostęp do odczytu szacunków VO2 max. Nie zapisujemy niczego w Apple Health."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Požiadame o povolenie čítať odhady VO2 max. Do Apple Health nič nezapisujeme."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi ber om lov att läsa VO2 max-värden. Vi skriver inget i Apple Health."
          }
        }
      }
    }
