    "Read-only. Stays on your device. No account.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only. Stays on your device. No account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur lesend. Bleibt auf deinem Gerät. Kein Konto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture seule. Vos données restent sur votre appareil. Aucun compte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen-lezen. Blijft op je apparaat. Geen account."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "唯讀，資料保留在你的裝置上，不需帳戶。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только чтение. Данные хранятся на устройстве. Учётная запись не нужна."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للقراءة فقط. تبقى البيانات على جهازك. لا حاجة إلى حساب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lectura. Los datos permanecen en tu dispositivo. No necesitas una cuenta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用です。データはデバイス内に保存され、アカウントは不要です。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านอย่างเดียว ข้อมูลอยู่บนอุปกรณ์ ไม่ต้องมีบัญชี"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze ke čtení. Data zůstávají ve vašem zařízení. Bez účtu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lettura. I dati restano sul dispositivo. Nessun account."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak olvasható. Az eszközödön marad. Nincs szükség fiókra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar pentru citire. Datele rămân pe dispozitiv. Fără cont."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο για ανάγνωση. Παραμένει στη συσκευή σου. Χωρίς λογαριασμό."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko do odczytu. Dane pozostają na urządzeniu. Bez konta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Iba na čítanie. Údaje zostávajú v zariadení. Bez účtu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast läsning. Stannar på din enhet. Inget konto."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לקריאה בלבד. נשאר במכשיר. ללא חשבון."
          }
        }
      }
    },
