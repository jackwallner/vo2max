    "Walks, runs, hikes, rides, swims, rows, elliptical, and interval sessions recorded in Apple Health all count here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walks, runs, hikes, rides, swims, rows, elliptical, and interval sessions recorded in Apple Health all count here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Apple Health aufgezeichnete Spaziergänge, Läufe, Wanderungen, Radtouren, Schwimm- und Rudertrainings, Crosstrainer und Intervalleinheiten zählen dazu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les marches, courses, randonnées, sorties à vélo, séances de natation, d’aviron, de vélo elliptique et de fractionné enregistrées dans Apple Health sont prises en compte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandelingen, hardloopsessies, hikes, fietstochten, zwem- en roeitrainingen, crosstrainer- en intervaltrainingen uit Apple Health tellen mee."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 記錄的步行、跑步、健行、騎車、游泳、划船、橢圓機和間歇訓練都會列入計算。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь учитываются прогулки, пробежки, походы, велосипедные поездки, плавание, гребля, занятия на эллиптическом тренажёре и интервальные тренировки, записанные в Apple Health."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحتسب هنا تمارين المشي والجري والتنزه وركوب الدراجة والسباحة والتجديف والجهاز البيضاوي والفترات التدريبية المسجلة في Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí se cuentan las caminatas, carreras, rutas de senderismo, paseos en bicicleta, sesiones de natación, remo, elíptica e intervalos que registres en Apple Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Healthに記録されたウォーキング、ランニング、ハイキング、サイクリング、水泳、ローイング、エリプティカル、インターバルワークアウトが対象です。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นับการเดิน วิ่ง เดินป่า ปั่นจักรยาน ว่ายน้ำ พายเรือ เครื่องเดินวงรี และการออกกำลังกายแบบช่วงที่บันทึกใน Apple Health"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počítají se zde chůze, běhy, túry, jízdy na kole, plavání, veslování, tréninky na eliptickém trenažéru i intervalové tréninky zaznamenané v Apple Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui sono inclusi gli allenamenti registrati in Apple Health: camminata, corsa, escursionismo, ciclismo, nuoto, canottaggio, ellittica e intervalli."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Healthben rögzített séta, futás, túrázás, kerékpározás, úszás, evezés, ellipszistréneres és intervallumedzés is beleszámít."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aici se includ plimbările, alergările, drumețiile, ciclismul, înotul, canotajul, antrenamentele pe bicicleta eliptică și cele pe intervale înregistrate în Apple Health."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εδώ μετρούν οι περίπατοι, τα τρεξίματα, οι πεζοπορίες, η ποδηλασία, η κολύμβηση, η κωπηλασία, το ελλειπτικό και οι διαλειμματικές προπονήσεις που έχουν καταγραφεί στο Apple Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwzględniane są spacery, biegi, wędrówki, jazda na rowerze, pływanie, wioślarstwo, orbitrek i treningi interwałowe zapisane w Apple Health."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počítajú sa sem prechádzky, behy, túry, cyklistika, plávanie, veslovanie, eliptický trenažér aj intervalové tréningy zaznamenané v Apple Health."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Här räknas promenader, löprundor, vandringar, cykling, simning, rodd, crosstrainer och intervallpass som registrerats i Apple Health."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כאן נכללים אימוני הליכה, ריצה, טיולים, רכיבה, שחייה, חתירה, מכשיר אליפטי ואינטרוולים שתועדו ב-Apple Health."
          }
        }
      }
    },
    "We'll ask permission to read your VO2 max estimates. We never write to Apple Health.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll ask permission to read your VO2 max estimates. We never write to Apple Health."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir bitten dich um Erlaubnis, deine VO2max-Schätzwerte zu lesen. Wir schreiben nichts in Apple Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous demanderons l’autorisation de lire vos estimations de VO2 max. Nous n’écrivons aucune donnée dans Apple Health."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We vragen toestemming om je VO2max-schattingen te lezen. We schrijven niets naar Apple Health."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們會請求讀取 VO2 max 估算值的權限，不會寫入 Apple Health。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы запросим доступ на чтение оценок VO2 max. Данные в Apple Health не изменяются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنطلب إذن قراءة تقديرات VO2 max. لا يكتب التطبيق أي بيانات إلى Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te pediremos permiso para leer tus estimaciones de VO2 max. Nunca escribimos datos en Apple Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2 maxの推定値を読み取る許可を求めます。Apple Healthにデータを書き込むことはありません。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะขออนุญาตอ่านค่าประมาณ VO2 max โดยจะไม่เขียนข้อมูลลง Apple Health"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požádáme vás o povolení číst odhady VO2 max. Do Apple Health nikdy nic nezapisujeme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti chiederemo il permesso di leggere le stime VO2 max. Non scriviamo mai su Apple Health."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyt kérünk a VO2 max-becslések olvasásához. Soha nem írunk adatot az Apple Healthbe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îți vom cere permisiunea să citim estimările VO2 max. Nu scriem niciodată date în Apple Health."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα ζητήσουμε άδεια για ανάγνωση των εκτιμήσεων VO2 max. Δεν γράφουμε ποτέ δεδομένα στο Apple Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprosimy o zgodę na odczyt oszacowań VO2 max. Nigdy nie zapisujemy danych w Apple Health."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Požiadame o povolenie čítať tvoje odhady VO2 max. Do Apple Health nikdy nezapisujeme údaje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi ber om tillstånd att läsa dina VO2 max-uppskattningar. Vi skriver aldrig till Apple Health."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נבקש הרשאה לקרוא את אומדני VO2 max. לעולם איננו כותבים ל-Apple Health."
          }
        }
      }
    },
