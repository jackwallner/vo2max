          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione è attiva, quindi sono disponibili andatura e dislivello."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helymeghatározás engedélyezve van, így a tempó és a szintemelkedés is elérhető."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Localizarea este activată, așa că sunt disponibile ritmul și diferența de nivel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με ενεργή την τοποθεσία είναι διαθέσιμα ο ρυθμός και η υψομετρική διαφορά."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz lokalizację, aby zobaczyć tempo i zmianę wysokości."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapni polohu, aby boli dostupné tempo a prevýšenie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på platsinfo för att visa tempo och höjdskillnad."
          }
        },
        "he": {
