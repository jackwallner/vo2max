    "Feedback opens your mail app with a private draft. No analytics, no account.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback opens your mail app with a private draft. No analytics, no account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback öffnet deine Mail-App mit einem Entwurf, den nur du siehst. Kein Tracking, kein Konto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer un commentaire ouvre votre app Mail avec un brouillon privé. Sans suivi ni compte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback opent je e-mailapp met een privéconcept. Geen analysegegevens, geen account."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回饋功能會開啟郵件 App，並建立只有你看得到的草稿。不追蹤使用狀況，也不需帳戶。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откроется почта с готовым черновиком отзыва. Без аналитики и учётной записи."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح زر الملاحظات تطبيق البريد مع مسودة خاصة. لا تحليلات ولا حاجة إلى حساب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comentarios abren tu app de correo con un borrador privado. Sin análisis ni cuenta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードバックを選ぶと、メールアプリに下書きが作成されます。利用状況の分析やアカウント登録はありません。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งความคิดเห็นเพื่อเปิดอีเมลฉบับร่างส่วนตัว ไม่มีการวิเคราะห์การใช้งานและไม่ต้องมีบัญชี"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zpětná vazba otevře vaši e-mailovou aplikaci s připravenou zprávou. Bez analytiky a bez účtu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il feedback apre l’app Mail con un messaggio privato già pronto. Nessuna analisi e nessun account."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Visszajelzés megnyitja a levelezőappot egy előkészített üzenettel. Nincs analitika és nincs fiók."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedbackul deschide aplicația de e-mail cu un mesaj pregătit. Fără analiză de date și fără cont."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επιλογή «Αποστολή σχολίων» ανοίγει την εφαρμογή email με έτοιμο ιδιωτικό πρόχειρο. Χωρίς αναλυτικά στοιχεία και χωρίς λογαριασμό."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Formularz opinii otwiera aplikację pocztową z przygotowaną prywatną wiadomością. Bez analityki i bez konta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spätná väzba otvorí e-mailovú aplikáciu s pripravenou súkromnou správou. Bez analytiky a bez účtu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback öppnar din e-postapp med ett privat utkast. Ingen analys och inget konto."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשוב יפתח את אפליקציית הדוא״ל עם הודעה מוכנה לשליחה. בלי איסוף נתונים ובלי חשבון."
          }
        }
      }
    },
