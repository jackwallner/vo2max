          "stringUnit": {
            "state": "translated",
            "value": "A kardiofitness trend motivációs kontextus, nem orvosi értékelés."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O tendință de fitness cardio este un context motivațional, nu o evaluare medicală."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια τάση καρδιο φυσικής κατάστασης είναι ένα πλαίσιο κινήτρων, όχι μια ιατρική αξιολόγηση."
          }
        },
        "pl": {
