    "Broad extrapolation from recent Apple Health estimates, not a prediction or guarantee.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Broad extrapolation from recent Apple Health estimates, not a prediction or guarantee."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grobe Hochrechnung auf Grundlage aktueller Apple Health-Schätzungen, keine Vorhersage oder Garantie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Large extrapolation à partir des récentes estimations Apple Health, et non une prédiction ou une garantie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grove extrapolatie op basis van recente Apple Health-schattingen, geen voorspelling of garantie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據近期 Apple Health 估算值推算的大致方向，不代表預測或保證。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приблизительная оценка по последним данным Apple Health, а не прогноз или гарантия."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدير تقريبي بالاستناد إلى تقديرات Apple Health الأخيرة، وليس تنبؤًا أو ضمانًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una proyección general a partir de estimaciones recientes de Apple Health, no una predicción ni una garantía."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Healthの最近の推定値をもとにした大まかな推定であり、予測や保証ではありません。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การประเมินโดยคร่าวจากค่าประมาณล่าสุดใน Apple Health ไม่ใช่การทำนายหรือการรับประกัน"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Orientační odhad vycházející z nedávných údajů Apple Health, nikoli předpověď ani záruka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una proiezione indicativa basata sulle stime recenti di Apple Health, non una previsione né una garanzia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Általános becslés a legutóbbi Apple Health-adatok alapján. Nem előrejelzés vagy garancia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O estimare orientativă bazată pe datele recente Apple Health, nu o predicție sau o garanție."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενδεικτική εκτίμηση από τις πρόσφατες μετρήσεις Apple Health, όχι πρόβλεψη ή εγγύηση."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogólne oszacowanie na podstawie ostatnich danych Apple Health, a nie prognoza ani gwarancja."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Orientačný odhad podľa nedávnych údajov Apple Health, nie predpoveď ani záruka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ungefärlig uppskattning utifrån de senaste Apple Health-värdena, inte en prognos eller garanti."
          }
        },
        "he": {
          "stringUnit": {
