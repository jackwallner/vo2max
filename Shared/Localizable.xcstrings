    "A brisk outdoor walk, run, or hike of about 20 minutes with Apple Watch on your wrist lets Apple Health record a new one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A brisk outdoor walk, run, or hike of about 20 minutes with Apple Watch on your wrist lets Apple Health record a new one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein flotter Spaziergang, Lauf oder eine etwa 20-minütige Wanderung im Freien mit Apple Watch am Handgelenk lässt Apple Health einen neuen Rekord aufzeichnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une marche, une course ou une randonnée rapide en plein air d'environ 20 minutes avec Apple Watch à votre poignet permet à Apple Health d'en enregistrer une nouvelle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na een stevige wandeling, hardloopsessie of trektocht in de buitenlucht van ongeveer 20 minuten met Apple Watch om je pols, kan Apple Health een nieuwe opnemen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手腕上穿著 Apple Watch 進行大約 20 分鐘的快節奏戶外散步、跑步或健行，可以讓 Apple Health 記錄新的記錄。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрая прогулка, пробежка или поход на свежем воздухе продолжительностью около 20 минут с Apple Watch на запястье позволит Apple Health записать новое."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن المشي أو الجري أو المشي السريع في الهواء الطلق لمدة 20 دقيقة تقريبًا مع Apple Watch على معصمك يسمح لـ Apple Health بتسجيل رقم جديد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una caminata, carrera o caminata rápida al aire libre de aproximadamente 20 minutos con Apple Watch en tu muñeca le permite a Apple Health registrar uno nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch を手首に装着して屋外で約 20 分間の活発なウォーキング、ランニング、ハイキングを行うと、Apple Health で新しい記録を記録できます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเดิน วิ่ง หรือเดินป่ากลางแจ้งเร็วๆ ประมาณ 20 นาทีโดยมี Apple Watch บนข้อมือของคุณ ช่วยให้ Apple Health บันทึกข้อมูลใหม่ได้"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rychlá venkovní procházka, běh nebo asi 20minutová túra s Apple Watch na vašem zápěstí umožní Apple Health zaznamenat nový."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una camminata, una corsa o un'escursione veloce all'aperto di circa 20 minuti con Apple Watch al polso consente a Apple Health di registrarne una nuova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy körülbelül 20 perces gyors szabadtéri séta, futás vagy túrázás Apple Watch-val a csuklóján lehetővé teszi, hogy a Apple Health újat rögzítsen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O plimbare, alergare sau drumeție în aer liber de aproximativ 20 de minute cu Apple Watch la încheietura mâinii îi permite lui Apple Health să înregistreze una nouă."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας γρήγορος υπαίθριος περπάτημα, τρέξιμο ή πεζοπορία περίπου 20 λεπτών με το Apple Watch στον καρπό σας επιτρέπει στο Apple Health να καταγράψει ένα νέο."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Energiczny spacer na świeżym powietrzu, bieganie lub wędrówka trwająca około 20 minut z Apple Watch na nadgarstku pozwala Apple Health nagrać nowy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rýchla chôdza vonku, beh alebo túra v trvaní približne 20 minút s Apple Watch na zápästí umožní Apple Health zaznamenať nový."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En rask utomhuspromenad, löpning eller vandring på cirka 20 minuter med Apple Watch på handleden låter Apple Health spela in en ny."
          }
        }
      }
    },
    "A broad fitness-awareness summary of Apple Health estimates. Not a medical measurement, diagnosis, or clinical result.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A broad fitness-awareness summary of Apple Health estimates. Not a medical measurement, diagnosis, or clinical result."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine umfassende Zusammenfassung der Apple Health-Schätzungen zum Fitnessbewusstsein. Keine medizinische Messung, Diagnose oder klinisches Ergebnis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un résumé général de sensibilisation à la condition physique des estimations Apple Health. Il ne s'agit pas d'une mesure médicale, d'un diagnostic ou d'un résultat clinique."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een brede samenvatting van fitnessbewustzijn van Apple Health-schattingen. Geen medische meting, diagnose of klinisch resultaat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 估計的廣泛健身意識摘要。不是醫學測量、診斷或臨床結果。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Широкий обзор оценок Apple Health, касающихся фитнеса. Это не медицинское измерение, диагноз или клинический результат."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملخص واسع للتوعية باللياقة البدنية لتقديرات Apple Health. ليس قياسًا طبيًا أو تشخيصًا أو نتيجة سريرية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un amplio resumen de las estimaciones Apple Health sobre concienciación sobre el estado físico. No es una medición médica, diagnóstico o resultado clínico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health の推定値に関する広範なフィットネス意識の概要。医学的な測定、診断、または臨床結果ではありません。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สรุปการรับรู้ถึงฟิตเนสแบบกว้างๆ ของการประมาณการ Apple Health ไม่ใช่การวัดทางการแพทย์ การวินิจฉัย หรือผลลัพธ์ทางคลินิก"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Široké shrnutí odhadů Apple Health o kondici. Nejedná se o lékařské měření, diagnózu nebo klinický výsledek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ampio riepilogo della consapevolezza del fitness delle stime Apple Health. Non si tratta di una misurazione medica, di una diagnosi o di un risultato clinico."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Health becslések átfogó fitnesz-tudatossági összefoglalója. Nem orvosi mérés, diagnózis vagy klinikai eredmény."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rezumat amplu privind conștientizarea fitness-ului al estimărilor Apple Health. Nu este o măsurătoare medicală, un diagnostic sau un rezultat clinic."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια ευρεία περίληψη της ευαισθητοποίησης της φυσικής κατάστασης των εκτιμήσεων Apple Health. Δεν πρόκειται για ιατρική μέτρηση, διάγνωση ή κλινικό αποτέλεσμα."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szerokie podsumowanie świadomości sprawnościowej szacunków Apple Health. Nie jest to pomiar medyczny, diagnoza ani wynik kliniczny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Široký súhrn odhadov Apple Health o fitness povedomí. Nejde o lekárske meranie, diagnózu alebo klinický výsledok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En bred sammanfattning av konditionsmedvetenhet av Apple Health uppskattningar. Inte en medicinsk mätning, diagnos eller kliniskt resultat."
          }
        }
      }
    },
