    "A brisk outdoor walk, run, or hike of about 20 minutes with Apple Watch on your wrist lets Apple Health record a new one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A brisk outdoor walk, run, or hike of about 20 minutes with Apple Watch on your wrist lets Apple Health record a new one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein zügiger Spaziergang, Lauf oder eine Wanderung von etwa 20 Minuten mit Apple Watch am Handgelenk kann dazu führen, dass Apple Health einen neuen Schätzwert erfasst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une marche rapide, une course ou une randonnée d’environ 20 minutes en plein air avec l’Apple Watch au poignet permet à Apple Health d’enregistrer une nouvelle estimation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na een stevige wandeling, hardloopsessie of hike van ongeveer 20 minuten in de buitenlucht met Apple Watch om je pols kan Apple Health een nieuwe schatting registreren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "戴著 Apple Watch 在戶外快走、跑步或健行約 20 分鐘，可讓 Apple Health 記錄新的心肺適能估算值。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрая прогулка, пробежка или поход на свежем воздухе продолжительностью около 20 минут с Apple Watch на запястье позволит Apple Health записать новое."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يسجل Apple Health تقديرًا جديدًا بعد مشي سريع أو جري أو نزهة خارجية لنحو 20 دقيقة مع ارتداء Apple Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health puede registrar una nueva estimación si haces una caminata rápida, corres o haces senderismo al aire libre durante unos 20 minutos con el Apple Watch puesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watchを着けて屋外で約20分間、早歩き、ランニング、ハイキングをすると、Apple Healthに新しい推定値が記録されることがあります。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเดินเร็ว วิ่ง หรือเดินป่ากลางแจ้งประมาณ 20 นาทีขณะสวม Apple Watch อาจทำให้ Apple Health บันทึกค่าประมาณใหม่ได้"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při přibližně 20 minutách svižné venkovní chůze, běhu nebo túry s Apple Watch na zápěstí může Apple Health zaznamenat nový odhad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con circa 20 minuti di camminata veloce, corsa o escursione all’aperto e Apple Watch al polso, Apple Health può registrare una nuova stima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Körülbelül 20 perc lendületes szabadtéri séta, futás vagy túrázás Apple Watch-csal segíthet, hogy az Apple Health új becslést rögzítsen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O plimbare alertă, o alergare sau o drumeție în aer liber de aproximativ 20 de minute, cu Apple Watch la încheietură, poate ajuta Apple Health să înregistreze o estimare nouă."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα γρήγορο περπάτημα, τρέξιμο ή πεζοπορία σε εξωτερικό χώρο για περίπου 20 λεπτά, φορώντας Apple Watch, μπορεί να βοηθήσει το Apple Health να καταγράψει νέα εκτίμηση."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Około 20 minut energicznego spaceru, biegu lub wędrówki na świeżym powietrzu z Apple Watchem na nadgarstku może pomóc Apple Health zarejestrować nowe oszacowanie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Približne 20 minút svižnej chôdze, behu alebo turistiky vonku s Apple Watch na zápästí môže Apple Health pomôcť zaznamenať nový odhad."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En rask promenad, löprunda eller vandring utomhus på ungefär 20 minuter med Apple Watch på handleden kan hjälpa Apple Health att registrera en ny uppskattning."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הליכה מהירה, ריצה או טיול בחוץ במשך כ-20 דקות עם Apple Watch על פרק כף היד עשויים לאפשר ל-Apple Health לתעד אומדן חדש."
          }
        }
      }
    },
    "A broad fitness-awareness summary of Apple Health estimates. Not a medical measurement, diagnosis, or clinical result.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A broad fitness-awareness summary of Apple Health estimates. Not a medical measurement, diagnosis, or clinical result."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine grobe Einordnung der Apple Health-Schätzungen für deine Fitness. Keine medizinische Messung, Diagnose oder klinische Beurteilung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vue d’ensemble des estimations Apple Health pour suivre votre forme cardio. Ce n’est ni une mesure médicale, ni un diagnostic, ni un résultat clinique."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een globale samenvatting van Apple Health-schattingen voor je conditie. Geen medische meting, diagnose of klinisch resultaat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "概覽 Apple Health 的心肺適能估算值，協助你了解體適能趨勢。這不是醫療測量、診斷或臨床結果。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обзор оценок Apple Health для отслеживания физической формы. Это не медицинское измерение, диагноз или клиническое заключение."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملخص عام لتقديرات Apple Health لمتابعة اللياقة. هذا ليس قياسًا طبيًا أو تشخيصًا أو نتيجة سريرية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un resumen general de las estimaciones de Apple Health para conocer tu capacidad aeróbica. No es una medición médica, un diagnóstico ni un resultado clínico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Healthの推定値をもとに、心肺機能の傾向をまとめます。医療上の測定値、診断、臨床結果ではありません。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สรุปค่าประมาณจาก Apple Health เพื่อช่วยติดตามสมรรถภาพหัวใจและหลอดเลือด ไม่ใช่การวัดทางการแพทย์ การวินิจฉัย หรือผลทางคลินิก"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Orientační přehled odhadů kardiorespirační kondice z Apple Health. Nejde o lékařské měření, diagnózu ani klinický výsledek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un riepilogo generale delle stime di fitness cardiovascolare di Apple Health, pensato per aiutarti a conoscere la tua forma fisica. Non è una misurazione medica, una diagnosi o un risultato clinico."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Health kardiofitnesz-becsléseinek általános összefoglalója, a fittség nyomon követésére. Nem orvosi mérés, diagnózis vagy klinikai eredmény."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rezumat general al estimărilor Apple Health pentru a urmări fitnessul cardiovascular. Nu este o măsurătoare medicală, un diagnostic sau un rezultat clinic."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια γενική σύνοψη των εκτιμήσεων του Apple Health για την παρακολούθηση της καρδιοαναπνευστικής φυσικής κατάστασης. Δεν αποτελεί ιατρική μέτρηση, διάγνωση ή κλινικό αποτέλεσμα."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogólne podsumowanie oszacowań Apple Health, które pomaga śledzić kondycję kardio. To nie jest pomiar medyczny, diagnoza ani wynik kliniczny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všeobecný prehľad odhadov Apple Health na sledovanie kardiorespiračnej kondície. Nie je to zdravotné meranie, diagnóza ani klinický výsledok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En övergripande sammanfattning av Apple Health-uppskattningar för att följa konditionen. Det är ingen medicinsk mätning, diagnos eller klinisk bedömning."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סיכום כללי של אומדני הכושר האירובי מ-Apple Health, למודעות לכושר. זה אינו מדד רפואי, אבחנה או תוצאה קלינית."
          }
        }
      }
    },
    "A broad outlook toward your target when data supports it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A broad outlook toward your target when data supports it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine grobe Einschätzung des Wegs zu deinem Ziel, sofern die Daten dafür ausreichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une estimation générale de votre progression vers la cible lorsque les données le permettent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een grove inschatting van je voortgang richting je doel, als de gegevens dat toelaten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料足夠時，提供達成目標的大致趨勢。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общее представление о движении к цели, если данных достаточно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض تقريبي للتقدم نحو هدفك عندما تسمح البيانات بذلك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una orientación general sobre tu progreso hacia el objetivo cuando hay datos suficientes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データが十分な場合に、目標に向けた大まかな見通しを表示します。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงแนวโน้มโดยรวมไปสู่เป้าหมายเมื่อมีข้อมูลเพียงพอ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Orientační výhled směrem k vašemu cíli, pokud to data umožňují."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stima indicativa dell’avvicinamento al tuo obiettivo, quando i dati lo consentono."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Általános előretekintés a célod felé, ha az adatok ezt alátámasztják."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O estimare orientativă a progresului spre țintă, dacă datele permit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια ενδεικτική εικόνα της πορείας προς τον στόχο σου, όταν το επιτρέπουν τα δεδομένα."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogólna perspektywa drogi do celu, jeśli pozwalają na to dane."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Orientačný výhľad na cestu k cieľu, ak to údaje umožňujú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ungefärlig bild av vägen mot målet, när data ger stöd för det."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערכה כללית של ההתקדמות ליעד, כשהנתונים מאפשרים זאת."
          }
        }
      }
    },
    "A cardio fitness trend is motivational context, not a medical assessment.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cardio fitness trend is motivational context, not a medical assessment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Cardiofitness-Trend dient der Motivation und ist keine medizinische Beurteilung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tendance de forme cardio donne un repère motivant, pas une évaluation médicale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een cardiofitnesstrend is bedoeld als motivatie, niet als medische beoordeling."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "心肺適能趨勢可作為鼓勵參考，不是醫療評估。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Динамика кардиовыносливости помогает следить за прогрессом, но не является медицинской оценкой."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتجاه اللياقة القلبية للمساعدة على متابعة التقدم، وليس تقييمًا طبيًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tendencia de tu capacidad aeróbica sirve como referencia para motivarte, no como evaluación médica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心肺機能の推移は進捗を確認するための情報であり、医学的な評価ではありません。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนวโน้มสมรรถภาพหัวใจและหลอดเลือดใช้ติดตามความก้าวหน้า ไม่ใช่การประเมินทางการแพทย์"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trend kardiorespirační kondice slouží jako motivace, nejde o lékařské posouzení."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’andamento del fitness cardiovascolare è un riferimento motivazionale, non una valutazione medica."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kardiofitnesz trendje motivációs támpont, nem orvosi értékelés."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendința fitnessului cardiovascular oferă context motivațional, nu o evaluare medicală."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τάση της καρδιοαναπνευστικής φυσικής κατάστασης είναι ένα κίνητρο, όχι ιατρική αξιολόγηση."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trend kondycji kardio motywuje do działania, ale nie jest oceną medyczną."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Trend kardiorespiračnej kondície je motivačný kontext, nie zdravotné hodnotenie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En konditionstrend ger motivation, men är ingen medicinsk bedömning."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מגמת הכושר האירובי נועדה לספק הקשר ומוטיבציה, ולא לשמש הערכה רפואית."
          }
        }
      }
    },
    "A fitness-awareness signal, not a medical measurement. This app does not diagnose, treat, or monitor any condition. Discuss heart health concerns with a qualified clinician.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fitness-awareness signal, not a medical measurement. This app does not diagnose, treat, or monitor any condition. Discuss heart health concerns with a qualified clinician."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Hinweis zu deiner Fitness, keine medizinische Messung. Diese App diagnostiziert, behandelt oder überwacht keine Erkrankungen. Sprich bei Fragen zu deiner Herzgesundheit mit medizinischem Fachpersonal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un repère pour suivre votre forme, pas une mesure médicale. Cette app ne diagnostique, ne traite et ne surveille aucun problème de santé. Pour toute question concernant votre santé cardiaque, consultez un professionnel de santé qualifié."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een indicatie van je conditie, geen medische meting. Deze app stelt geen diagnoses, behandelt of volgt geen aandoeningen. Bespreek zorgen over je hartgezondheid met een gekwalificeerde zorgverlener."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是了解體適能的參考資訊，不是醫療測量。本 App 不會診斷、治療或監測任何疾病。如有心臟健康疑慮，請諮詢合格的醫療專業人員。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это показатель для отслеживания физической формы, а не медицинское измерение. Приложение не ставит диагнозы, не лечит и не отслеживает заболевания. По вопросам здоровья сердца обратитесь к квалифицированному врачу."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مؤشر لمتابعة اللياقة، وليس قياسًا طبيًا. لا يشخّص هذا التطبيق أي حالة ولا يعالجها أو يراقبها. استشر مختصًا صحيًا مؤهلًا بشأن أي مخاوف تتعلق بصحة القلب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una referencia sobre tu capacidad aeróbica, no una medición médica. Esta app no diagnostica, trata ni vigila ninguna afección. Si te preocupa la salud de tu corazón, consulta con un profesional sanitario cualificado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心肺機能を把握するための情報であり、医療上の測定値ではありません。このアプリは病気の診断、治療、経過観察を行いません。心臓の健康について心配なことがある場合は、医療専門家に相談してください。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลนี้ใช้ติดตามสมรรถภาพร่างกาย ไม่ใช่การวัดทางการแพทย์ แอปนี้ไม่วินิจฉัย รักษา หรือติดตามอาการ หากกังวลเรื่องสุขภาพหัวใจ โปรดปรึกษาบุคลากรทางการแพทย์ที่มีคุณสมบัติเหมาะสม"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jde o ukazatel kondice, nikoli lékařské měření. Aplikace nediagnostikuje, neléčí ani nesleduje žádné onemocnění. Zdravotní potíže se srdcem konzultujte s kvalifikovaným lékařem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un indicatore utile per conoscere la tua forma fisica, non una misurazione medica. L’app non diagnostica, cura né monitora alcuna patologia. Per dubbi sulla salute del cuore, rivolgiti a un medico qualificato."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fittség nyomon követését segítő jelzés, nem orvosi mérés. Az app nem diagnosztizál, nem kezel és nem figyel semmilyen egészségi állapotot. A szív egészségével kapcsolatos kérdéseiddel fordulj szakképzett orvoshoz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un indicator pentru urmărirea fitnessului, nu o măsurătoare medicală. Aplicația nu diagnostichează, nu tratează și nu monitorizează afecțiuni. Pentru probleme legate de sănătatea inimii, discută cu un medic calificat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα στοιχείο για την παρακολούθηση της φυσικής κατάστασης, όχι ιατρική μέτρηση. Η εφαρμογή δεν διαγιγνώσκει, δεν θεραπεύει και δεν παρακολουθεί παθήσεις. Για θέματα υγείας της καρδιάς, μίλησε με εξειδικευμένο επαγγελματία υγείας."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wskazówka pomagająca śledzić kondycję, a nie pomiar medyczny. Aplikacja nie diagnozuje, nie leczy ani nie monitoruje żadnych schorzeń. W razie obaw o zdrowie serca porozmawiaj z wykwalifikowanym lekarzem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to ukazovateľ na sledovanie kondície, nie zdravotné meranie. Aplikácia nediagnostikuje, nelieči ani nesleduje zdravotné ťažkosti. O obavách týkajúcich sa zdravia srdca sa poraď s kvalifikovaným lekárom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En signal för att följa konditionen, inte en medicinsk mätning. Appen diagnostiserar, behandlar eller övervakar inga sjukdomar. Prata med kvalificerad vårdpersonal om du oroar dig för hjärthälsan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זהו מדד למודעות לכושר, לא מדידה רפואית. האפליקציה אינה מאבחנת, מטפלת או עוקבת אחר מצב רפואי. בכל חשש לבריאות הלב יש להתייעץ עם רופא מוסמך."
          }
        }
      }
    },
    "A monthly recap of your cardio fitness trend, target progress, and best reading.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A monthly recap of your cardio fitness trend, target progress, and best reading."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Monatsrückblick auf deinen Cardiofitness-Trend, deinen Fortschritt zum Ziel und deinen Bestwert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bilan mensuel de votre tendance de forme cardio, de votre progression vers la cible et de votre meilleure estimation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een maandoverzicht van je cardiofitnesstrend, voortgang richting je doel en beste schatting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每月回顧心肺適能趨勢、目標進度和最佳估算值。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ежемесячный обзор динамики кардиовыносливости, прогресса к цели и лучшего результата."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملخص شهري لاتجاه لياقتك القلبية وتقدمك نحو الهدف وأفضل تقدير."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un resumen mensual de la tendencia de tu capacidad aeróbica, tu progreso hacia el objetivo y tu mejor estimación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心肺機能の推移、目標への進捗、最良の推定値を月ごとに振り返ります。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สรุปประจำเดือนเกี่ยวกับแนวโน้มสมรรถภาพหัวใจและหลอดเลือด ความคืบหน้าสู่เป้าหมาย และค่าประมาณที่ดีที่สุด"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měsíční přehled trendu kardiorespirační kondice, pokroku k cíli a nejlepší naměřené hodnoty."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un riepilogo mensile dell’andamento del fitness cardiovascolare, dei progressi verso l’obiettivo e del tuo miglior valore."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Havi összefoglaló a kardiofitnesz trendjéről, a célod felé tett lépésekről és a legjobb mérésedről."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rezumat lunar al tendinței fitnessului cardiovascular, al progresului spre țintă și al celei mai bune măsurători."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μηνιαία σύνοψη της τάσης της καρδιοαναπνευστικής φυσικής κατάστασης, της προόδου προς τον στόχο και της καλύτερης μέτρησής σου."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miesięczne podsumowanie trendu kondycji kardio, postępów w realizacji celu i najlepszego pomiaru."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesačné zhrnutie trendu kardiorespiračnej kondície, pokroku k cieľu a najlepšieho merania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En månadssammanfattning av konditionstrenden, dina framsteg mot målet och ditt bästa värde."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סיכום חודשי של מגמת הכושר האירובי, ההתקדמות ליעד והמדידה הטובה ביותר."
          }
        }
      }
    },
