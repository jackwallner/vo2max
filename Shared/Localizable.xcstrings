        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробный период не начался. Нажмите ещё раз, чтобы продолжить."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تبدأ الفترة التجريبية. اضغط مرة أخرى للمتابعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se inició el período de prueba. Toca de nuevo para continuar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアルが開始されませんでした。もう一度タップして続けてください。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มช่วงทดลองใช้ฟรีไม่สำเร็จ แตะอีกครั้งเพื่อดำเนินการต่อ"
