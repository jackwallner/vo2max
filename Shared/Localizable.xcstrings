    "How far your heart rate falls in the minute after a workout, trended across the range you pick.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far your heart rate falls in the minute after a workout, trended across the range you pick."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark deine Herzfrequenz in der ersten Minute nach einem Training sinkt, im Verlauf des ausgewählten Zeitraums."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ampleur de la baisse de votre fréquence cardiaque pendant la première minute après l’entraînement, sur la période choisie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe sterk je hartslag daalt in de eerste minuut na een training, over de gekozen periode."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看你在運動後第一分鐘內的心率下降幅度，並追蹤所選期間的變化。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение пульса за первую минуту после тренировки и его динамика за выбранный период."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع مقدار انخفاض نبض القلب خلال الدقيقة الأولى بعد التمرين على مدى الفترة التي تختارها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta cuánto baja tu frecuencia cardíaca durante el primer minuto tras entrenar y cómo cambia en el período que elijas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークアウト後の最初の1分間に心拍数がどれだけ低下したかを、選択した期間で確認できます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูว่าอัตราการเต้นของหัวใจลดลงเท่าใดในนาทีแรกหลังออกกำลังกาย และติดตามแนวโน้มตลอดช่วงเวลาที่เลือก"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak se mění pokles srdeční frekvence během první minuty po tréninku ve zvoleném období."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come varia la diminuzione della frequenza cardiaca nel primo minuto dopo l’allenamento, nel periodo che scegli."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A pulzuscsökkenés alakulása az edzés utáni első percben, az általad választott időszakban."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cum variază scăderea frecvenței cardiace în primul minut după antrenament, pe perioada aleasă."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο μειώνεται ο καρδιακός ρυθμός στο πρώτο λεπτό μετά από προπόνηση, παρακολουθούμενος στην περίοδο που επιλέγεις."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak zmienia się spadek tętna w pierwszej minucie po treningu w wybranym okresie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako sa mení pokles srdcového tepu počas prvej minúty po tréningu vo vybranom období."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ hur mycket pulsen sjunker under den första minuten efter träning under perioden du väljer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המעקב אחר הירידה בדופק בדקה שאחרי אימון לאורך התקופה שנבחרה."
          }
        }
      }
    },
