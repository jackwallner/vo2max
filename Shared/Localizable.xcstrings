    "Four Apple Health estimates within 90 days are needed before the app labels a direction.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four Apple Health estimates within 90 days are needed before the app labels a direction."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind vier Apple Health-Schätzungen innerhalb von 90 Tagen erforderlich, bevor die App eine Richtung kennzeichnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre estimations Apple Health dans un délai de 90 jours sont nécessaires avant que l'application n'indique une direction."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn vier Apple Health-schattingen binnen 90 dagen nodig voordat de app een richting aangeeft."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在應用程式標記方向之前，需要在 90 天內進行四次 Apple Health 估計。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем приложение определит направление, необходимо четыре оценки Apple Health в течение 90 дней."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك حاجة إلى أربعة تقديرات Apple Health خلال 90 يومًا قبل أن يقوم التطبيق بتسمية الاتجاه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesitan cuatro estimaciones Apple Health dentro de 90 días antes de que la aplicación etiquete una dirección."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが方向をラベル付けする前に、90 日以内に 4 つの Apple Health 推定値が必要です。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำเป็นต้องมีการประมาณค่า Apple Health สี่รายการภายใน 90 วันก่อนที่แอปจะติดป้ายกำกับทิศทาง"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než aplikace označí směr, jsou potřeba čtyři odhady Apple Health během 90 dnů."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono necessarie quattro stime Apple Health entro 90 giorni prima che l'app etichetti una direzione."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Négy Apple Health becslésre van szükség 90 napon belül, mielőtt az alkalmazás felcímkéz egy irányt."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt necesare patru estimări Apple Health în 90 de zile înainte ca aplicația să eticheteze o direcție."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαιτούνται τέσσερις εκτιμήσεις Apple Health εντός 90 ημερών προτού η εφαρμογή χαρακτηρίσει μια κατεύθυνση."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanim aplikacja wyznaczy kierunek, potrzebne są cztery szacunki Apple Health w ciągu 90 dni."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sú potrebné štyri odhady Apple Health do 90 dní, kým aplikácia označí smer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyra Apple Health uppskattningar inom 90 dagar behövs innan appen märker en riktning."
          }
        }
      }
    },
