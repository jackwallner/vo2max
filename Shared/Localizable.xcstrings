    "%@. One-time purchase. Lifetime access, no subscription.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. One-time purchase. Lifetime access, no subscription."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Einmaliger Kauf. Lebenslanger Zugriff, kein Abonnement."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Achat unique. Accès à vie, sans abonnement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Eenmalige aankoop. Levenslange toegang, geen abonnement."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。一次性購買。終身訪問，無需訂閱。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Разовая покупка. Доступ пожизненный, без подписки."
