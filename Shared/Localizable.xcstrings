    "No resting heart rate readings in %@. Choose a longer range, or check that Apple Health has this data.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No resting heart rate readings in %1$@. Choose a longer range, or check that Apple Health has this data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Ruheherzfrequenzwerte in %1$@. Wähle einen größeren Bereich oder prüfe, ob Apple Health über diese Daten verfügt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune lecture de fréquence cardiaque au repos dans %1$@. Choisissez une plage plus longue ou vérifiez que Apple Health dispose de ces données."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen hartslagmetingen in rust in %1$@. Kies een groter bereik, of controleer of Apple Health over deze gegevens beschikt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 中沒有靜止心率讀數。選擇更長的範圍，或檢查 Apple Health 是否有此數據。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет показаний пульса в состоянии покоя в %1$@. Выберите более длинный диапазон или убедитесь, что Apple Health содержит эти данные."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد قراءات لمعدل ضربات القلب أثناء الراحة في %1$@. اختر نطاقًا أطول، أو تأكد من أن Apple Health لديه هذه البيانات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay lecturas de frecuencia cardíaca en reposo en %1$@. Elige un rango más largo o comprueba que Apple Health ten estos datos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ には安静時の心拍数の測定値がありません。より長い範囲を選択するか、Apple Health にこのデータがあることを確認してください。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการอ่านค่าอัตราการเต้นของหัวใจขณะพักใน %1$@ เลือกช่วงที่ยาวขึ้น หรือตรวจสอบว่า Apple Health มีข้อมูลนี้"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné údaje o tepové frekvenci v klidu v %1$@. Zvolte delší rozsah nebo zkontrolujte, zda Apple Health má tato data."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna lettura della frequenza cardiaca a riposo in %1$@. Scegli un intervallo più lungo o verifica che Apple Health disponga di questi dati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ban nincs nyugalmi pulzusszám. Válasszon hosszabb tartományt, vagy ellenőrizze, hogy a Apple Health rendelkezik-e ezekkel az adatokkal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără citiri ale ritmului cardiac în repaus în %1$@. Alegeți un interval mai lung sau verificați dacă Apple Health are aceste date."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ενδείξεις καρδιακών παλμών σε ηρεμία στο %1$@. Επιλέξτε μεγαλύτερο εύρος ή ελέγξτε ότι το Apple Health έχει αυτά τα δεδομένα."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak odczytów tętna spoczynkowego w %1$@. Wybierz większy zasięg lub sprawdź, czy Apple Health ma te dane."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadne pokojové hodnoty srdcového tepu v %1$@. Vyberte dlhší rozsah alebo skontrolujte, či má Apple Health tieto údaje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga vilopulsavläsningar i %1$@. Välj ett längre intervall eller kontrollera att Apple Health har dessa data."
          }
        }
      }
    },
