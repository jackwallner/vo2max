    "Compare each period with the matching one before it once both windows contain Apple Health estimates.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare each period with the matching one before it once both windows contain Apple Health estimates."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche jeden Zeitraum mit dem gleich langen vorherigen, sobald für beide Apple Health-Schätzungen vorliegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez chaque période à la période précédente de même durée, dès que les deux contiennent des estimations Apple Health."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijk elke periode met de vorige periode van dezelfde lengte zodra beide Apple Health-schattingen bevatten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩段期間都有 Apple Health 估算值後，即可比較每段期間與前一段同長期間的差異。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда в обоих периодах будут оценки Apple Health, сравните каждый период с таким же предыдущим."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تتضمن الفترتان تقديرات Apple Health، قارن كل فترة بالفترة السابقة المماثلة لها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando ambos períodos incluyan estimaciones de Apple Health, compara cada uno con el período anterior de la misma duración."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の期間にApple Healthの推定値がある場合、各期間をその前の同じ長さの期間と比較できます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อทั้งสองช่วงมีค่าประมาณจาก Apple Health แล้ว ให้เปรียบเทียบแต่ละช่วงกับช่วงก่อนหน้าที่มีระยะเวลาเท่ากัน"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakmile obě období obsahují odhady z Apple Health, porovnejte každé období se stejně dlouhým předchozím obdobím."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando entrambi i periodi contengono stime di Apple Health, confronta ciascuno con il periodo precedente di uguale durata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha mindkét időszakban vannak Apple Health-becslések, hasonlítsd össze őket az azonos hosszúságú előző időszakkal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când ambele perioade conțin estimări Apple Health, compară fiecare perioadă cu cea anterioară de aceeași durată."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν και οι δύο περίοδοι έχουν εκτιμήσεις Apple Health, σύγκρινε την καθεμία με την προηγούμενη ίσης διάρκειας."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy w obu okresach są oszacowania Apple Health, porównaj każdy z poprzednim okresem o tej samej długości."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď obe obdobia obsahujú odhady Apple Health, porovnaj každé z nich s predchádzajúcim obdobím rovnakej dĺžky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När båda perioderna innehåller Apple Health-uppskattningar kan du jämföra varje period med den föregående perioden av samma längd."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשיש אומדני Apple Health בשתי התקופות, אפשר להשוות כל תקופה לקודמת באותו אורך."
          }
        }
      }
    },
