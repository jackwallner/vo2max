            "value": "لم تكتمل عملية الشراء. اضغط مرة أخرى للمتابعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se completó la compra. Toca de nuevo para continuar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入が完了しませんでした。もう一度タップして続けてください。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซื้อไม่สำเร็จ แตะอีกครั้งเพื่อดำเนินการต่อ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup nebyl dokončen. Klepněte znovu a pokračujte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisto non completato. Tocca di nuovo per continuare."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vásárlás nem fejeződött be. Koppints újra a folytatáshoz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achiziția nu s-a finalizat. Atinge din nou pentru a continua."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αγορά δεν ολοκληρώθηκε. Πάτησε ξανά για να συνεχίσεις."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup nie został sfinalizowany. Stuknij ponownie, aby kontynuować."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup sa nedokončil. Ťukni znova a pokračuj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köpet slutfördes inte. Tryck igen för att fortsätta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרכישה לא הושלמה. אפשר ללחוץ שוב כדי להמשיך."
          }
        }
      }
    },
    "Purchases are disabled in the simulator. Use the local Pro override in Settings to inspect subscriber screens.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases are disabled in the simulator. Use the local Pro override in Settings to inspect subscriber screens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Käufe sind im Simulator deaktiviert. Aktiviere Pro in den Einstellungen lokal, um die Abo-Ansichten zu prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les achats sont désactivés dans le simulateur. Activez Pro localement dans Réglages pour afficher les écrans réservés aux abonnés."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aankopen zijn uitgeschakeld in de simulator. Schakel Pro lokaal in via Instellingen om de abonneeweergaven te bekijken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模擬器中無法購買。請在「設定」中於本機啟用 Pro，以查看訂閱功能畫面。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В симуляторе покупки отключены. Чтобы просмотреть экраны подписки, включите Pro на этом устройстве в «Настройках»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشراء غير متاح في المحاكي. فعّل Pro على هذا الجهاز من «الإعدادات» لمعاينة شاشات المشتركين."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las compras están desactivadas en el simulador. Activa Pro en este dispositivo desde «Configuración» para revisar las pantallas de suscripción."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレータでは購入できません。「設定」でこのデバイスのProを有効にすると、サブスクリプション画面を確認できます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซื้อถูกปิดใช้งานในตัวจำลอง เปิด Pro บนอุปกรณ์นี้ในการตั้งค่าเพื่อดูหน้าจอสำหรับสมาชิก"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákupy jsou v simulátoru vypnuté. Obrazovky předplatného si můžete prohlédnout po zapnutí místního režimu Pro v Nastavení."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli acquisti sono disattivati nel simulatore. Per vedere le schermate degli abbonamenti, attiva la modalità Pro locale in Impostazioni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vásárlás szimulátorban nem érhető el. Az előfizetői képernyők megtekintéséhez kapcsold be a helyi Pro módot a Beállításokban."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achizițiile sunt dezactivate în simulator. Activează modul Pro local din Setări pentru a vedea ecranele abonatului."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αγορές είναι απενεργοποιημένες στον προσομοιωτή. Ενεργοποίησε την τοπική παράκαμψη Pro στις Ρυθμίσεις για να δεις τις οθόνες συνδρομητών."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakupy są wyłączone w symulatorze. Włącz lokalny tryb Pro w Ustawieniach, aby zobaczyć ekrany subskrybenta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákupy sú v simulátore vypnuté. Zapni miestny režim Pro v Nastaveniach a pozri si obrazovky pre predplatiteľov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köp är avstängda i simulatorn. Slå på lokal Pro-åtkomst i Inställningar för att se prenumerantskärmarna."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רכישות מושבתות בסימולטור. להפעלת מסכי המנויים, יש להפעיל את Pro המקומי בהגדרות."
          }
        }
      }
    },
    "Purchases are temporarily unavailable. Your free features are still ready to use.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases are temporarily unavailable. Your free features are still ready to use."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Käufe sind vorübergehend nicht verfügbar. Deine kostenlosen Funktionen kannst du weiter nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les achats sont temporairement indisponibles. Vous pouvez toujours utiliser les fonctions gratuites."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aankopen zijn tijdelijk niet beschikbaar. Je kunt de gratis functies blijven gebruiken."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法購買，你仍可使用免費功能。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупки временно недоступны, но бесплатные функции по-прежнему работают."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشراء غير متاح مؤقتًا، ويمكنك مواصلة استخدام الميزات المجانية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las compras no están disponibles temporalmente, pero puedes seguir usando las funciones gratuitas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在購入できませんが、無料機能は引き続き利用できます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้ไม่สามารถซื้อได้ แต่ยังใช้ฟีเจอร์ฟรีได้ตามปกติ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákupy jsou dočasně nedostupné. Bezplatné funkce můžete dál používat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli acquisti non sono al momento disponibili. Puoi continuare a usare le funzioni gratuite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vásárlás átmenetileg nem érhető el. Az ingyenes funkciókat továbbra is használhatod."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achizițiile nu sunt disponibile momentan. Poți folosi în continuare funcțiile gratuite."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αγορές δεν είναι προσωρινά διαθέσιμες. Μπορείς να συνεχίσεις να χρησιμοποιείς δωρεάν τις λειτουργίες της εφαρμογής."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakupy są chwilowo niedostępne. Nadal możesz korzystać z bezpłatnych funkcji."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákupy momentálne nie sú dostupné. Bezplatné funkcie môžeš naďalej používať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köp är inte tillgängliga just nu. Du kan fortfarande använda gratisfunktionerna."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרכישות אינן זמינות כרגע. אפשר להמשיך להשתמש בתכונות החינמיות."
          }
        }
      }
    },
    "Put the recent cardio fitness trend in target context when the data supports it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the recent cardio fitness trend in target context when the data supports it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordne den aktuellen Cardiofitness-Trend anhand der verfügbaren Daten deinem Zielbereich zu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez la tendance récente de forme cardio en regard de votre cible lorsque les données le permettent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de recente cardiofitnesstrend in de context van je doel als de gegevens dat toelaten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料足夠時，將近期心肺適能趨勢與目標範圍一起呈現。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если данных достаточно, покажите недавнюю динамику кардиовыносливости относительно цели."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض الاتجاه الأخير للياقة القلبية مقارنةً بالهدف عند توفر بيانات كافية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara la tendencia reciente de capacidad aeróbica con tu objetivo cuando haya datos suficientes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データが十分な場合に、最近の心肺機能の推移を目標と比較します。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงแนวโน้มสมรรถภาพหัวใจและหลอดเลือดล่าสุดเทียบกับเป้าหมายเมื่อมีข้อมูลเพียงพอ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud to data umožňují, zobrazte nedávný trend kardiorespirační kondice v souvislosti s cílovým rozmezím."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando i dati lo consentono, mostra l’andamento recente del fitness cardiovascolare rispetto all’intervallo obiettivo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha az adatok lehetővé teszik, mutasd meg a legutóbbi kardiofitnesz-trendet a céltartományhoz viszonyítva."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când datele permit, compară tendința recentă de fitness cardiovascular cu intervalul țintă."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν το επιτρέπουν τα δεδομένα, σύγκρινε την πρόσφατη τάση καρδιοαναπνευστικής φυσικής κατάστασης με το εύρος στόχου."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli pozwalają na to dane, porównaj ostatni trend kondycji kardio z zakresem docelowym."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak to údaje umožňujú, porovnaj nedávny trend kardiorespiračnej kondície s cieľovým rozpätím."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jämför den senaste konditionstrenden med målintervallet när data ger stöd för det."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשהנתונים מאפשרים זאת, הצגת מגמת הכושר האירובי האחרונה ביחס לטווח היעד."
          }
        }
      }
    },
    "Qualifying is the share of your weekly minutes from outdoor walks, runs, and hikes — the only sessions Apple Health can draw a new estimate from.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualifying is the share of your weekly minutes from outdoor walks, runs, and hikes — the only sessions Apple Health can draw a new estimate from."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der geeignete Anteil umfasst deine wöchentlichen Minuten bei Spaziergängen, Läufen und Wanderungen im Freien. Aus diesen Trainingseinheiten kann Apple Health neue Schätzwerte ableiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les minutes admissibles sont celles de vos marches, courses et randonnées en plein air. Ce sont les seules séances à partir desquelles Apple Health peut enregistrer une nouvelle estimation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschikte minuten zijn de minuten van wandelingen, hardloopsessies en hikes in de buitenlucht. Dit zijn de enige trainingen waarop Apple Health een nieuwe schatting kan baseren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "符合條件的運動分鐘數，是指每週戶外步行、跑步和健行的分鐘數。Apple Health 會根據這些運動記錄新的估算值。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время подходящих тренировок включает прогулки, пробежки и походы на улице. Только по ним Apple Health может рассчитать новую оценку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشمل الدقائق المستوفية للشروط المشي والجري والتنزه في الخارج، وهي التمارين التي يعتمد عليها Apple Health لتسجيل تقدير جديد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los minutos válidos son los que acumulas caminando, corriendo o haciendo senderismo al aire libre, los únicos entrenamientos que Apple Health usa para generar una estimación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "条件を満たす運動時間は、屋外のウォーキング、ランニング、ハイキングに費やした週あたりの時間です。Apple Healthで新しい推定値につながるのはこれらのワークアウトです。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาทีที่เข้าเงื่อนไขคือเวลารายสัปดาห์ที่ใช้เดิน วิ่ง หรือเดินป่ากลางแจ้ง ซึ่งเป็นกิจกรรมที่ Apple Health ใช้บันทึกค่าประมาณใหม่ได้"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuty při venkovní chůzi, běhu a túrách tvoří část vaší týdenní aktivity, ze které může Apple Health vytvořit nový odhad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La percentuale di minuti settimanali dedicata a camminate, corse ed escursioni all’aperto indica la quota delle attività da cui Apple Health può ricavare una nuova stima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A heti percek közül a szabadtéri sétákra, futásokra és túrákra jutó rész számít bele. Ezekből a tevékenységekből készíthet új becslést az Apple Health."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arată ce parte din minutele săptămânale de activitate vine din plimbări, alergări și drumeții în aer liber. Doar din aceste antrenamente poate Apple Health calcula o estimare nouă."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείχνει τι ποσοστό των εβδομαδιαίων λεπτών προέρχεται από υπαίθριους περιπάτους, τρεξίματα και πεζοπορίες. Μόνο από αυτές τις δραστηριότητες μπορεί το Apple Health να υπολογίσει νέα εκτίμηση."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To udział tygodniowych minut aktywności przypadający na spacery, biegi i wędrówki na świeżym powietrzu. Tylko na podstawie tych treningów Apple Health może utworzyć nowe oszacowanie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukazuje, aká časť týždenných minút pochádza z prechádzok, behov a túr vonku. Iba z týchto aktivít môže Apple Health vytvoriť nový odhad."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar hur stor andel av veckans minuter som kommer från promenader, löprundor och vandringar utomhus. Det är de enda aktiviteterna som kan ge en ny Apple Health-uppskattning."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדקות מהליכות, מריצות ומטיולים בחוץ הן החלק מתוך הפעילות השבועית שעל סמכו Apple Health עשוי ליצור אומדן חדש."
          }
        }
      }
    },
    "Qualifying is the share of your weekly minutes from outdoor walks, runs, and hikes, the only sessions Apple Health can draw a new estimate from.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualifying is the share of your weekly minutes from outdoor walks, runs, and hikes, the only sessions Apple Health can draw a new estimate from."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als relevant zählen Minuten aus Spaziergängen, Läufen und Wanderungen im Freien. Nur dabei kann Apple Health eine neue Schätzung erfassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les minutes prises en compte proviennent des marches, courses et randonnées en plein air. Apple Health ne peut enregistrer une nouvelle estimation qu’après ces séances."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meetellende minuten komen van buitenwandelingen, hardlopen en trektochten. Alleen na zulke activiteiten kan Apple Health een nieuwe schatting vastleggen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "符合條件的分鐘數來自戶外步行、跑步和健行；Apple Health 只能在這些運動後記錄新的估算值。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В расчёт входят минуты прогулок, бега и походов на улице. Только после таких занятий Apple Health может записать новую оценку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحتسب دقائق المشي والجري والتنزه في الهواء الطلق. ولا يستطيع Apple Health تسجيل تقدير جديد إلا بعد هذه الأنشطة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cuentan los minutos de caminatas, carreras y excursiones al aire libre. Apple Health solo puede registrar una nueva estimación después de estas actividades."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象となるのは、屋外でのウォーキング、ランニング、ハイキングの時間です。Apple Healthが新しい推定値を記録できるのは、これらのワークアウトの後です。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาทีที่เข้าเกณฑ์มาจากการเดิน วิ่ง และเดินป่ากลางแจ้ง โดย Apple Health จะบันทึกค่าประมาณใหม่ได้หลังออกกำลังกายเหล่านี้เท่านั้น"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Započítávají se minuty venkovní chůze, běhu a turistiky. Apple Health může zaznamenat nový odhad jen po těchto aktivitách."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rientrano nel conteggio i minuti di camminate, corse ed escursioni all’aperto. Apple Health può registrare una nuova stima solo dopo queste attività."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדקות שנחשבות הן מהליכות, ריצות וטיולים בחוץ. Apple Health יכולה לתעד הערכה חדשה רק אחרי הפעילויות האלה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszámított percek szabadtéri sétákból, futásokból és túrákból származnak. Az Apple Health csak ezek után tud új becslést rögzíteni."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt luate în calcul minutele de mers, alergare și drumeții în aer liber. Apple Health poate înregistra o estimare nouă doar după aceste activități."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνυπολογίζονται τα λεπτά από υπαίθριους περιπάτους, τρέξιμο και πεζοπορία. Το Apple Health μπορεί να καταγράψει νέα εκτίμηση μόνο μετά από αυτές τις δραστηριότητες."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczą się minuty spacerów, biegania i wędrówek na świeżym powietrzu. Apple Health może zapisać nowe oszacowanie tylko po tych aktywnościach."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Započítavajú sa minúty chôdze, behu a turistiky vonku. Apple Health môže zaznamenať nový odhad len po týchto aktivitách."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvalificerande minuter kommer från promenader, löpning och vandring utomhus. Apple Health kan bara registrera en ny uppskattning efter sådana pass."
          }
        }
      }
    },
