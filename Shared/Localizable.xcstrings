    "Choose a reference option in Settings to see this context.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a reference option in Settings to see this context."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle in den Einstellungen ein Referenzprofil aus, um diese Einordnung zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un profil de référence dans Réglages pour afficher ces repères."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een referentieprofiel in Instellingen om deze context te zien."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中選擇參考個人檔案，以查看這項資訊。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы увидеть эти данные, выберите профиль для сравнения в «Настройках»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ملفًا مرجعيًا من «الإعدادات» لعرض هذه المقارنة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un perfil de referencia en «Configuración» para ver esta información."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この情報を見るには、「設定」で参照プロフィールを選択してください。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกโปรไฟล์อ้างอิงในการตั้งค่าเพื่อดูข้อมูลนี้"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto srovnání zobrazíte výběrem referenčního profilu v Nastavení."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per vedere questo confronto, scegli un profilo di riferimento in Impostazioni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összehasonlításhoz válassz referenciaprofilt a Beállításokban."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a vedea comparația, alege un profil de referință din Setări."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να δεις αυτή τη σύγκριση, επίλεξε προφίλ αναφοράς στις Ρυθμίσεις."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zobaczyć to porównanie, wybierz profil odniesienia w Ustawieniach."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chceš zobraziť toto porovnanie, vyber referenčný profil v Nastaveniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en referensprofil i Inställningar för att se jämförelsen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לראות את ההשוואה, יש לבחור פרופיל ייחוס בהגדרות."
          }
        }
      }
    },
