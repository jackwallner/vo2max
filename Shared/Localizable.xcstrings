    "Read-only. Stays on your device. No account.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only. Stays on your device. No account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibgeschützt. Bleibt auf deinem Gerät. Kein Konto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture seule. Reste sur votre appareil. Aucun compte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen-lezen. Blijft op je apparaat. Geen account."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只讀。保留在您的裝置上。沒有帳戶。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для чтения. Остается на вашем устройстве. Нет аккаунта."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للقراءة فقط. يبقى على جهازك. لا يوجد حساب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lectura. Permanece en tu dispositivo. Sin cuenta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用。デバイス上に残ります。アカウントがありません。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านอย่างเดียว อยู่บนอุปกรณ์ของคุณ ไม่มีบัญชี."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze pro čtení. Zůstane na vašem zařízení. Žádný účet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sola lettura. Resta sul tuo dispositivo. Nessun account."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak olvasható. A készüléken marad. Nincs fiók."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numai citire. Rămâne pe dispozitivul dvs. Niciun cont."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο για ανάγνωση. Παραμένει στη συσκευή σας. Χωρίς λογαριασμό."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko do odczytu. Pozostaje na Twoim urządzeniu. Brak konta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Iba na čítanie. Zostane na vašom zariadení. Žiadny účet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivskyddad. Blir kvar på din enhet. Inget konto."
          }
        }
      }
    },
