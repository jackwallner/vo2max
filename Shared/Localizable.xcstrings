    "Location enabled so pace and elevation are available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location enabled so pace and elevation are available."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standortzugriff aktiviert, damit Tempo und Höhenmeter verfügbar sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Localisation activée pour rendre disponibles l’allure et le dénivelé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatie ingeschakeld zodat tempo en hoogte beschikbaar zijn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已啟用定位，因此可查看步速和海拔。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Местоположение включено, поэтому доступны темп и высота."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموقع مفعّل، لذا تتوفر بيانات السرعة والارتفاع."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubicación habilitada para que el ritmo y la elevación estén disponibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報を有効にすると、ペースと高度も表示されます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้งานตำแหน่งเพื่อให้สามารถก้าวและระดับความสูงได้"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
