    "Get a notification when Apple Health logs a new VO2 max estimate, with how it compares.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a notification when Apple Health logs a new VO2 max estimate, with how it compares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte eine Benachrichtigung, wenn Apple Health eine neue VO2-max-Schätzwert protokolliert, mit deren Vergleich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez une notification lorsque Apple Health enregistre une nouvelle estimation VO2 max, avec sa comparaison."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontvang een melding wanneer Apple Health een nieuwe VO2 max-schatting registreert, met hoe deze zich verhoudt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 Apple Health 記錄新的 VO2 max 估計值及其比較方式時收到通知。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получите уведомление, когда Apple Health зарегистрирует новую оценку VO2 max, с описанием ее сравнения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على إشعار عندما يقوم Apple Health بتسجيل تقدير VO2 max الجديد، مع كيفية مقارنته."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reciba una notificación cuando Apple Health registre una nueva estimación VO2 max y cómo se compara."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health が新しい VO2 max 推定値をログに記録したときに、その比較方法とともに通知を受け取ります。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับการแจ้งเตือนเมื่อ Apple Health บันทึกการประมาณการ VO2 max ใหม่ พร้อมวิธีเปรียบเทียบ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Získejte upozornění, když Apple Health zaznamená nový odhad VO2 max s tím, jak se porovnává."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi una notifica quando Apple Health registra una nuova stima VO2 max, con il suo confronto."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értesítést kaphat, ha a Apple Health új VO2 max becslést naplóz az összehasonlítással."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Primiți o notificare când Apple Health înregistrează o nouă estimare VO2 max, cu modul în care se compară."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λάβετε μια ειδοποίηση όταν το Apple Health καταγράφει μια νέα εκτίμηση VO2 max, με τον τρόπο σύγκρισης."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
