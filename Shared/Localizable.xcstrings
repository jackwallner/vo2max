    "Nothing recorded between %@. Choose a longer window, or return after Apple Health records another cardio fitness estimate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing recorded between %1$@. Choose a longer window, or return after Apple Health records another cardio fitness estimate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischen %1$@ wurde nichts aufgezeichnet. Wähle ein längeres Zeitfenster oder kehren du zurück, nachdem Apple Health eine weitere Cardio-Fitness-Schätzung aufgezeichnet hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d'enregistré entre %1$@. Choisissez une fenêtre plus longue ou revenez après que Apple Health ait enregistré une autre estimation de la condition cardio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets opgenomen tussen %1$@. Kies een langere periode of keer terug nadat Apple Health nog een schatting van de cardiofitness heeft vastgelegd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 之間沒有任何記錄。選擇較長的窗口，或在 Apple Health 記錄另一個有氧健身估計後返回。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Между %1$@ ничего не записано. Выберите более длительный период или вернитесь после того, как Apple Health запишет еще одну оценку кардиотренированности."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تسجيل أي شيء بين %1$@. اختر نافذة أطول، أو ارجع بعد أن يسجل Apple Health تقديرًا آخر للياقة القلب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se registró nada entre %1$@. Elige una ventana más larga o regrese después de que Apple Health registre otra estimación de aptitud cardiovascular."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ の間には何も記録されていません。より長いウィンドウを選択するか、Apple Health が別の心肺機能の推定値を記録した後に戻ります。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการบันทึกระหว่าง %1$@ เลือกหน้าต่างที่ยาวขึ้น หรือย้อนกลับหลังจาก Apple Health บันทึกการประเมินสมรรถภาพหัวใจแบบคาร์ดิโออื่น"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezi %1$@ nebylo zaznamenáno nic. Zvolte delší okno nebo se vraťte poté, co Apple Health zaznamená další odhad kardiokondice."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato registrato nulla tra %1$@. Scegli una finestra più lunga o torna dopo che Apple Health ha registrato un'altra stima dell'attività cardio."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi sem rögzített %1$@ között. Válasszon egy hosszabb időtartamot, vagy térjen vissza, miután a Apple Health újabb kardiofitnesz-becslést rögzít."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a înregistrat nimic între %1$@. Alegeți o fereastră mai lungă sau reveniți după ce Apple Health înregistrează o altă estimare de fitness cardio."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν καταγράφηκε τίποτα μεταξύ %1$@. Επιλέξτε μεγαλύτερο παράθυρο ή επιστρέψτε αφού το Apple Health καταγράψει μια άλλη εκτίμηση φυσικής κατάστασης για καρδιο."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zostało zarejestrowane pomiędzy %1$@. Wybierz dłuższe okno lub wróć po tym, jak Apple Health zarejestruje kolejną ocenę wydolności cardio."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Medzi %1$@ nebolo zaznamenané nič. Vyberte si dlhšie okno alebo sa vráťte po tom, čo Apple Health zaznamená ďalší odhad kardio fitness."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget inspelat mellan %1$@. Välj ett längre fönster eller återvänd efter att Apple Health har registrerat ytterligare en konditionsberäkning."
          }
        }
      }
    },
    "Notification extras stay off until you turn them on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification extras stay off until you turn them on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungs-Extras bleiben deaktiviert, bis du sie aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les extras de notification restent désactivés jusqu'à ce que vous les activiez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra's voor meldingen blijven uitgeschakeld totdat je ze inschakelt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知附加功能將保持關閉狀態，直到您將其開啟。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнительные уведомления остаются отключенными, пока вы их не включите."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظل إضافات الإشعارات متوقفة حتى تقوم بتشغيلها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones adicionales permanecen desactivadas hasta que las activas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加の通知は、オンにするまでオフのままです。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสมบัติพิเศษของการแจ้งเตือนจะปิดอยู่จนกว่าคุณจะเปิดใช้งาน"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doplňky upozornění zůstanou vypnuté, dokud je nezapnete."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli extra di notifica rimangono disattivati ​​finché non li attivi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítési extrák kikapcsolva maradnak, amíg be nem kapcsolja őket."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificările suplimentare rămân dezactivate până când le activați."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πρόσθετες ειδοποιήσεις παραμένουν απενεργοποιημένες μέχρι να τις ενεργοποιήσετε."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatki do powiadomień pozostają wyłączone, dopóki ich nie włączysz."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Doplnkové upozornenia zostanú vypnuté, kým ich nezapnete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviseringstillägg förblir avstängda tills du slår på dem."
          }
        }
      }
    },
    "Off. Turn nudges on in Settings to be told when your estimate goes overdue against your own cadence.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off. Turn nudges on in Settings to be told when your estimate goes overdue against your own cadence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus. Aktiviere die Hinweise in den Einstellungen, damit du erfährst, wenn eine neue Schätzung länger auf sich warten lässt als für dich üblich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé. Activez les rappels dans Réglages pour savoir si votre prochaine estimation tarde par rapport à votre rythme habituel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uit. Schakel de herinneringen in Instellingen in om te weten wanneer je volgende schatting langer op zich laat wachten dan gebruikelijk."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已關閉。請在「設定」中開啟估算更新提醒，若下一次估算比你平常的間隔晚到，就會收到通知。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено. Включи напоминания в настройках, чтобы узнавать, если новая оценка задерживается дольше обычного."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقفة. فعّل التذكيرات في الإعدادات لتعرف إذا تأخر التقدير التالي عن موعده المعتاد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado. Activa los recordatorios en Configuración para saber si la siguiente estimación tarda más de lo habitual."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ。設定で更新通知をオンにすると、次の推定値がいつもの間隔より遅れているときにお知らせします。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดอยู่ เปิดการแจ้งเตือนใน “การตั้งค่า” เพื่อรับทราบเมื่อค่าประมาณครั้งต่อไปมาช้ากว่าช่วงเวลาปกติของคุณ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnuto. Zapněte upozornění v Nastavení, abyste věděli, že další odhad přichází později, než je u vás obvyklé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato. Attiva i promemoria in Impostazioni per sapere se la stima successiva tarda più del solito."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikapcsolva. Kapcsold be az emlékeztetőket a Beállításokban, hogy értesülj róla, ha a következő becslés a szokásosnál később érkezik."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivat. Activează mementourile în Configurări pentru a afla dacă următoarea estimare întârzie față de ritmul tău obișnuit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανενεργό. Ενεργοποίησε τις υπενθυμίσεις στις Ρυθμίσεις για να ενημερώνεσαι αν καθυστερεί η επόμενη εκτίμηση σε σχέση με το συνηθισμένο σου διάστημα."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączone. Włącz przypomnienia w Ustawieniach, aby dowiedzieć się, gdy kolejna ocena pojawia się później niż zwykle."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnuté. Zapnite si upozornenia v Nastaveniach, aby ste vedeli, keď ďalší odhad prichádza neskôr, než je u vás zvykom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Av. Aktivera påminnelser i Inställningar om du vill få veta när nästa uppskattning dröjer längre än vanligt."
          }
        }
      }
    },
    "On. You'll get a nudge when an estimate is overdue against your own cadence, at most once every five days.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On. You'll get a nudge when an estimate is overdue against your own cadence, at most once every five days."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An. Du erhältst höchstens einmal alle fünf Tage einen Hinweis, wenn eine neue Schätzung länger auf sich warten lässt als für dich üblich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé. Vous recevrez un rappel si votre prochaine estimation tarde par rapport à votre rythme habituel, au maximum une fois tous les cinq jours."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aan. Je krijgt maximaal eens per vijf dagen een herinnering als je volgende schatting langer op zich laat wachten dan gebruikelijk."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已開啟。若下一次估算比你平常的間隔晚到，你會收到提醒，每五天最多一次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено. Ты получишь напоминание, если новая оценка задерживается дольше обычного, но не чаще одного раза в пять дней."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفعّلة. ستتلقى تذكيرًا إذا تأخر التقدير التالي عن موعده المعتاد، وبحد أقصى مرة كل خمسة أيام."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado. Recibirás un recordatorio si la siguiente estimación tarda más de lo habitual, como máximo una vez cada cinco días."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン。次の推定値がいつもの間隔より遅れているときに、5日に1回を上限としてお知らせします。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดอยู่ คุณจะได้รับการแจ้งเตือนเมื่อค่าประมาณครั้งต่อไปมาช้ากว่าช่วงเวลาปกติ โดยแจ้งได้สูงสุดทุกห้าวัน"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnuto. Upozorníme vás, pokud další odhad přichází později, než je u vás obvyklé, nejvýše jednou za pět dní."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivato. Riceverai un promemoria se la stima successiva tarda più del solito, al massimo una volta ogni cinque giorni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekapcsolva. Emlékeztetőt kapsz, ha a következő becslés a szokásosnál később érkezik, legfeljebb ötnaponta egyszer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activat. Primești un memento dacă următoarea estimare întârzie față de ritmul tău obișnuit, cel mult o dată la cinci zile."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργό. Θα λάβεις υπενθύμιση αν καθυστερεί η επόμενη εκτίμηση σε σχέση με το συνηθισμένο σου διάστημα, το πολύ μία φορά κάθε πέντε ημέρες."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączone. Otrzymasz przypomnienie, gdy kolejna ocena pojawia się później niż zwykle, najwyżej raz na pięć dni."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnuté. Dostanete upozornenie, ak ďalší odhad prichádza neskôr, než je u vás zvykom, najviac raz za päť dní."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På. Du får en påminnelse om nästa uppskattning dröjer längre än vanligt, högst en gång var femte dag."
          }
        }
      }
    },
    "Once Apple Health records a few estimates this month, your recap will appear here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once Apple Health records a few estimates this month, your recap will appear here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald Apple Health diesen Monat einige Schätzungen erfasst, wird deine Zusammenfassung hier angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois que Apple Health aura enregistré quelques estimations ce mois-ci, votre récapitulatif apparaîtra ici."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra Apple Health deze maand enkele schattingen heeft geregistreerd, verschijnt je samenvatting hier."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦 Apple Health 本月記錄了一些估算，您的回顧將出現在此。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как только Apple Health запишет несколько оценок в этом месяце, здесь появится ваш отчет."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بمجرد أن يسجل Apple Health بعض التقديرات هذا الشهر، سيظهر الملخص الخاص بك هنا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez que Apple Health registre algunas estimaciones este mes, tu resumen aparecerá aquí."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月 Apple Health がいくつかの推定値を記録すると、ここに要約が表示されます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อ Apple Health บันทึกการประมาณการบางส่วนในเดือนนี้ ข้อมูลสรุปของคุณจะปรากฏที่นี่"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakmile Apple Health tento měsíc zaznamená několik odhadů, vaše rekapitulace se objeví zde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta che Apple Health avrà registrato alcune stime questo mese, il tuo riepilogo verrà visualizzato qui."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Miután a Apple Health rögzít néhány becslést ebben a hónapban, az összefoglaló itt jelenik meg."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Odată ce Apple Health înregistrează câteva estimări luna aceasta, recapitularea va apărea aici."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόλις το Apple Health καταγράψει μερικές εκτιμήσεις αυτόν τον μήνα, η ανακεφαλαίωση σας θα εμφανιστεί εδώ."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy Apple Health zarejestruje kilka szacunków w tym miesiącu, Twoje podsumowanie pojawi się tutaj."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď Apple Health tento mesiac zaznamená niekoľko odhadov, vaša rekapitulácia sa zobrazí tu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När Apple Health registrerar några uppskattningar denna månad, kommer din sammanfattning att visas här."
          }
        }
      }
    },
