    "No resting heart rate readings in %@. Choose a longer range, or check that Apple Health has this data.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No resting heart rate readings in %1$@. Choose a longer range, or check that Apple Health has this data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Ruheherzfrequenz-Messwerte für %1$@. Wähle einen längeren Zeitraum oder prüfe, ob diese Daten in Apple Health vorhanden sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune mesure de fréquence cardiaque au repos pour %1$@. Choisissez une période plus longue ou vérifiez que ces données figurent dans Apple Health."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen metingen van je hartslag in rust voor %1$@. Kies een langere periode of controleer of Apple Health deze gegevens bevat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 期間沒有靜止心率資料。請選擇較長的期間，或確認 Apple Health 中有這項資料。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет данных о пульсе в покое за %1$@. Выберите более длительный период или проверьте, есть ли эти данные в Apple Health."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد قراءات لمعدل ضربات القلب أثناء الراحة خلال %1$@. اختر فترة أطول أو تحقق من توفر البيانات في Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay datos de frecuencia cardíaca en reposo para %1$@. Elige un período más largo o comprueba si Apple Health tiene esos datos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の安静時心拍数データはありません。期間を長くするか、Apple Healthにデータがあるか確認してください。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีข้อมูลอัตราการเต้นของหัวใจขณะพักในช่วง %1$@ เลือกช่วงเวลาที่ยาวขึ้น หรือตรวจสอบว่า Apple Health มีข้อมูลนี้หรือไม่"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V období %1$@ nejsou žádná měření klidové srdeční frekvence. Zvolte delší období nebo ověřte, že jsou tato data v Apple Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna misurazione della frequenza cardiaca a riposo nel periodo %1$@. Scegli un periodo più lungo o verifica che Apple Health contenga questi dati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebben az időszakban nincs nyugalmi pulzusmérés: %1$@. Válassz hosszabb időszakot, vagy ellenőrizd az adatokat az Apple Healthben."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există măsurători ale frecvenței cardiace în repaus în perioada %1$@. Alege o perioadă mai lungă sau verifică datele din Apple Health."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν μετρήσεις καρδιακού ρυθμού σε ηρεμία την περίοδο %1$@. Επίλεξε μεγαλύτερη περίοδο ή έλεγξε αν υπάρχουν τα δεδομένα στο Apple Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak pomiarów tętna spoczynkowego w okresie %1$@. Wybierz dłuższy okres albo sprawdź, czy Apple Health ma te dane."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Za obdobie %1$@ nie sú merania pokojového srdcového tepu. Vyber dlhšie obdobie alebo skontroluj, či má Apple Health tieto údaje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga vilopulsmätningar under %1$@. Välj en längre period eller kontrollera att Apple Health har dessa data."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מדידות של דופק במנוחה בתקופה %1$@. אפשר לבחור תקופה ארוכה יותר או לבדוק אם הנתונים מופיעים ב-Apple Health."
          }
        }
      }
    },
