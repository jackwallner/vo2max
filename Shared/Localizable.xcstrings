    "Record a brisk outdoor walk, run, or hike with Apple Watch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a brisk outdoor walk, run, or hike with Apple Watch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne mit Apple Watch einen flotten Spaziergang, einen Lauf oder eine Wanderung im Freien auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une marche, une course ou une randonnée rapide en plein air avec Apple Watch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem een ​​stevige wandeling, hardloop of trektocht in de buitenlucht op met Apple Watch."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple Watch 記錄一次輕快的戶外散步、跑步或健行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите быструю прогулку, пробежку или поход на свежем воздухе с помощью Apple Watch."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتسجيل المشي أو الجري أو المشي السريع في الهواء الطلق باستخدام Apple Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre una caminata, carrera o caminata rápida al aire libre con Apple Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch を使用して、屋外での活発な散歩、ランニング、ハイキングを記録します。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกการเดิน วิ่ง หรือเดินป่ากลางแจ้งที่รวดเร็วด้วย Apple Watch"
