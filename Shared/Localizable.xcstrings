            "value": "Céltartomány: %1$@–%2$@ mL/kg/min. Legutóbbi: %3$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Interval țintă: %1$@–%2$@ mL/kg/min. Cel mai recent: %3$@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εύρος στόχου: %1$@–%2$@ mL/kg/min. Τελευταία: %3$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakres docelowy: %1$@–%2$@ mL/kg/min. Najnowsze: %3$@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cieľový rozsah: %1$@–%2$@ mL/kg/min. Najnovšie: %3$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Målintervall: %1$@–%2$@ mL/kg/min. Senaste: %3$@."
          }
        }
