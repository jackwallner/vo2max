    "VO2+ is active on this Apple ID. Restore Purchases remains available in Settings if access ever looks incorrect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ is active on this Apple ID. Restore Purchases remains available in Settings if access ever looks incorrect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ ist auf diesem Apple ID aktiv. Die Funktion „Käufe wiederherstellen“ bleibt in den Einstellungen verfügbar, falls der Zugriff jemals falsch erscheint."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ est actif sur ce Apple ID. La restauration des achats reste disponible dans les paramètres si l'accès semble incorrect."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ is actief op deze Apple ID. Aankopen herstellen blijft beschikbaar in Instellingen als de toegang ooit onjuist lijkt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ 在此 Apple ID 上處於作用中狀態。如果訪問看起來不正確，“恢復購買”仍然可以在“設定”中使用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ активен на этом Apple ID. Восстановление покупок остается доступным в настройках, если доступ когда-либо выглядит неправильным."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ نشط على Apple ID. تظل استعادة المشتريات متاحة في الإعدادات إذا بدا الوصول غير صحيح."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ está activo en este Apple ID. Restaurar compras permanece disponible en Configuración si el acceso alguna vez parece incorrecto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ はこの Apple ID でアクティブです。アクセスが正しくない場合でも、[設定] で購入内容を復元できます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ ใช้งานอยู่บน Apple ID นี้ คืนค่าการซื้อจะยังคงอยู่ในการตั้งค่าหากการเข้าถึงดูไม่ถูกต้อง"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ je aktivní na tomto Apple ID. Obnovit nákupy zůstane k dispozici v Nastavení, pokud bude přístup vypadat nesprávně."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ è attivo su questo Apple ID. Ripristina acquisti rimane disponibile in Impostazioni se l'accesso risulta errato."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A VO2+ aktív ezen a Apple ID-n. A Vásárlások visszaállítása továbbra is elérhető marad a Beállításokban, ha a hozzáférés helytelennek tűnik."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ este activ pe acest Apple ID. Restabilirea achizițiilor rămâne disponibilă în Setări dacă accesul pare incorect."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το VO2+ είναι ενεργό σε αυτό το Apple ID. Η Επαναφορά Αγορών παραμένει διαθέσιμη στις Ρυθμίσεις, εάν η πρόσβαση φαίνεται λανθασμένη."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ jest aktywny w tym Apple ID. Opcja Przywróć zakupy pozostaje dostępna w Ustawieniach, jeśli dostęp kiedykolwiek będzie wyglądał niepoprawnie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ je aktívny na tomto Apple ID. Obnoviť nákupy zostane dostupné v Nastaveniach, ak bude prístup vyzerať nesprávne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ är aktiv på denna Apple ID. Återställ köp förblir tillgängligt i Inställningar om åtkomsten någonsin ser felaktig ut."
          }
        }
      }
    },
