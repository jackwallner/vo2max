    "Record a brisk outdoor walk, run, or hike with Apple Watch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a brisk outdoor walk, run, or hike with Apple Watch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne mit Apple Watch einen zügigen Spaziergang, Lauf oder eine Wanderung im Freien auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une marche rapide, une course ou une randonnée en plein air avec l’Apple Watch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreer met Apple Watch een stevige wandeling, hardloopsessie of hike in de buitenlucht."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple Watch 記錄戶外快走、跑步或健行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите активную прогулку, пробежку или поход на улице с Apple Watch."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل مشيًا سريعًا أو جريًا أو تنزهًا في الخارج باستخدام Apple Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra una caminata rápida, una carrera o una ruta de senderismo al aire libre con el Apple Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watchで屋外の早歩き、ランニング、ハイキングを記録してください。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกการเดินเร็ว วิ่ง หรือเดินป่ากลางแจ้งด้วย Apple Watch"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenejte svižnou venkovní chůzi, běh nebo túru pomocí Apple Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra una camminata veloce, una corsa o un’escursione all’aperto con Apple Watch."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzíts lendületes szabadtéri sétát, futást vagy túrázást az Apple Watchoddal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează o plimbare alertă, o alergare sau o drumeție în aer liber cu Apple Watch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατέγραψε γρήγορο περπάτημα, τρέξιμο ή πεζοπορία σε εξωτερικό χώρο με το Apple Watch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarejestruj energiczny spacer, bieg lub wędrówkę na świeżym powietrzu z Apple Watchem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenaj svižnú prechádzku, beh alebo túru vonku pomocou Apple Watch."
          }
        },
        "sv": {
