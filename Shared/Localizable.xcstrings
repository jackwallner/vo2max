    "Latest, average, low, high, and the change against the previous window over 30 days, 90 days, 6 months, or a year.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest, average, low, high, and the change against the previous window over 30 days, 90 days, 6 months, or a year."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuester Wert, Durchschnitt, Tiefst- und Höchstwert sowie die Veränderung zum vorherigen Zeitraum für 30 Tage, 90 Tage, 6 Monate oder ein Jahr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière valeur, moyenne, minimum, maximum et évolution par rapport à la période précédente, sur 30 jours, 90 jours, 6 mois ou un an."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwste waarde, gemiddelde, laagste, hoogste en verandering ten opzichte van de vorige periode over 30 dagen, 90 dagen, 6 maanden of een jaar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 30 天、90 天、6 個月或 1 年期間的最新值、平均值、最低值、最高值，以及與前一段期間相比的變化。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последнее, среднее, минимальное и максимальное значения, а также изменение по сравнению с предыдущим периодом за 30 дней, 90 дней, 6 месяцев или год."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض أحدث قيمة ومتوسطها وأدناها وأعلاها والتغير مقارنةً بالفترة السابقة، على مدى 30 أو 90 يومًا أو 6 أشهر أو سنة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta el valor más reciente, el promedio, el mínimo, el máximo y el cambio frente al período anterior de 30 días, 90 días, 6 meses o un año."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30日、90日、6か月、1年の期間ごとに、最新値、平均、最低値、最高値、前の期間との変化を確認できます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูค่าล่าสุด ค่าเฉลี่ย ค่าต่ำสุด ค่าสูงสุด และการเปลี่ยนแปลงเทียบกับช่วงเวลาก่อนหน้า สำหรับช่วง 30 วัน 90 วัน 6 เดือน หรือ 1 ปี"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejnovější a průměrná hodnota, minimum, maximum a změna oproti předchozímu období. Vyberte 30 nebo 90 dnů, 6 měsíců či rok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultimo valore, media, minimo, massimo e variazione rispetto al periodo precedente. Scegli tra 30 o 90 giorni, 6 mesi e un anno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legutóbbi, átlagos, legalacsonyabb és legmagasabb érték, valamint a változás az előző időszakhoz képest. Válassz 30 vagy 90 napot, 6 hónapot vagy egy évet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cea mai recentă valoare, media, minimul, maximul și schimbarea față de perioada anterioară. Alege 30 sau 90 de zile, 6 luni ori un an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πιο πρόσφατη τιμή, μέσος όρος, ελάχιστο, μέγιστο και μεταβολή από την προηγούμενη περίοδο. Επίλεξε 30 ή 90 ημέρες, 6 μήνες ή ένα έτος."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najnowsza wartość, średnia, minimum, maksimum i zmiana względem poprzedniego okresu. Wybierz 30 lub 90 dni, 6 miesięcy albo rok."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najnovšia hodnota, priemer, minimum, maximum a zmena oproti predchádzajúcemu obdobiu. Vyber si 30 alebo 90 dní, 6 mesiacov či rok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Senaste värdet, genomsnitt, lägsta, högsta och förändringen jämfört med föregående period. Välj 30 eller 90 dagar, 6 månader eller ett år."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערך האחרון, הממוצע, הנמוך והגבוה, והשינוי לעומת התקופה הקודמת. אפשר לבחור 30 או 90 יום, 6 חודשים או שנה."
          }
        }
      }
    },
    "Latest, average, low, high, and the change against the previous window, over 30 days, 90 days, 6 months, or a year.": {
