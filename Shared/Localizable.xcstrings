    "Start date must be before end date.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start date must be before end date."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Startdatum muss vor dem Enddatum liegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date de début doit être antérieure à la date de fin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De startdatum moet vóór de einddatum liggen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始日期必須早於結束日期。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата начала должна предшествовать дате окончания."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون تاريخ البدء قبل تاريخ الانتهاء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha de inicio debe ser anterior a la fecha de finalización."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始日は終了日より前である必要があります。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่เริ่มต้นจะต้องอยู่ก่อนวันที่สิ้นสุด"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum zahájení musí předcházet datu ukončení."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La data di inizio deve essere antecedente alla data di fine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kezdő dátumnak a befejező dátum előtt kell lennie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Data de început trebuie să fie anterioară datei de încheiere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ημερομηνία έναρξης πρέπει να είναι πριν από την ημερομηνία λήξης."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Data rozpoczęcia musi być wcześniejsza niż data zakończenia."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dátum začiatku musí byť skorší ako dátum ukončenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Startdatumet måste vara före slutdatumet."
          }
        }
      }
    },
