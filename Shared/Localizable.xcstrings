    "Compare the latest estimate with broad reference values for your age and selected reference.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare the latest estimate with broad reference values for your age and selected reference."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche die neueste Schätzung mit allgemeinen Referenzwerten für dein Alter und die ausgewählte Referenz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez la dernière estimation avec des valeurs de référence larges pour votre âge et la référence sélectionnée."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijk de laatste schatting met brede referentiewaarden voor je leeftijd en geselecteerde referentie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將最新的估計值與您的年齡和所選參考的廣泛參考值進行比較。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравните последнюю оценку с общими эталонными значениями для вашего возраста и выбранного эталона."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قارن أحدث التقديرات بالقيم المرجعية الواسعة لعمرك والمرجع المحدد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara la última estimación con valores de referencia amplios para tu edad y la referencia seleccionada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新の推定値を、あなたの年齢および選択した基準の広範な基準値と比較します。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปรียบเทียบค่าประมาณล่าสุดกับค่าอ้างอิงแบบกว้างๆ สำหรับอายุของคุณและข้อมูลอ้างอิงที่เลือก"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Porovnejte nejnovější odhad se širokými referenčními hodnotami pro váš věk a vybranou referenci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta l'ultima stima con valori di riferimento ampi per la tua età e il riferimento selezionato."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasonlítsa össze a legfrissebb becslést az életkorára és a kiválasztott referenciára vonatkozó átfogó referenciaértékekkel."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparați cea mai recentă estimare cu valorile de referință ample pentru vârsta dvs. și referința selectată."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συγκρίνετε την πιο πρόσφατη εκτίμηση με ευρείες τιμές αναφοράς για την ηλικία σας και την επιλεγμένη αναφορά."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porównaj najnowsze szacunki z szerokimi wartościami referencyjnymi dla swojego wieku i wybranego odniesienia."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Porovnajte najnovší odhad so širokými referenčnými hodnotami pre váš vek a vybranú referenciu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jämför den senaste uppskattningen med breda referensvärden för din ålder och vald referens."
          }
        }
      }
    },
