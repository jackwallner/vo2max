            "value": "كل الميزات أدناه متاحة، وتعرض البيانات للفترة التي تختارها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las funciones siguientes están disponibles y muestran los datos del período que elijas."
