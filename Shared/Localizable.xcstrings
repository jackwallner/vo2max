    "Trial wasn't started. Tap again to continue.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trial wasn't started. Tap again to continue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Probezeitraum wurde nicht gestartet. Tippe erneut, um fortzufahren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La période d’essai n’a pas démarré. Touchez à nouveau pour continuer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De proefperiode is niet gestart. Tik opnieuw om verder te gaan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
