    "%@. Read directly from Apple Health and never written to it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Read directly from Apple Health and never written to it."
          }
        },
