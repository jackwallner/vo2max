          "stringUnit": {
            "state": "translated",
            "value": "Σύγκρινε την πιο πρόσφατη εκτίμηση Apple Health με γενικές τιμές αναφοράς για ηλικία %1$lld ετών και το προφίλ που επέλεξες."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porównaj najnowsze oszacowanie Apple Health z ogólnymi wartościami dla wieku %1$lld lat i wybranego profilu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Porovnaj najnovší odhad Apple Health so všeobecnými hodnotami pre vek %1$lld rokov a zvolený referenčný profil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jämför din senaste Apple Health-uppskattning med allmänna referensvärden för åldern %1$lld och din valda profil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השוואת אומדן Apple Health האחרון לערכי ייחוס כלליים לגיל %1$lld ולפרופיל שנבחר."
          }
        }
      }
    },
    "Your latest cardio fitness estimate and trend.": {
