    "A notification each time Apple Health logs a new VO2 max estimate, with context.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A notification each time Apple Health logs a new VO2 max estimate, with context."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mitteilung mit Kontext, sobald Apple Health einen neuen VO2max-Schätzwert erfasst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une notification avec du contexte à chaque nouvelle estimation de VO2 max enregistrée par Apple Health."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een melding met context zodra Apple Health een nieuwe VO2max-schatting registreert."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 記錄新的 VO2 max 估算值時，通知你並提供比較資訊。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомление с подробностями при каждой новой оценке VO2 max в Apple Health."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعار يتضمن التفاصيل كلما سجّل Apple Health تقديرًا جديدًا لـ VO2 max."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe una notificación con contexto cada vez que Apple Health registre una nueva estimación de VO2 max."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Healthに新しいVO2 max推定値が記録されるたびに、比較情報を含む通知を受け取れます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับการแจ้งเตือนพร้อมข้อมูลเปรียบเทียบทุกครั้งที่ Apple Health บันทึกค่าประมาณ VO2 max ใหม่"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornění pokaždé, když Apple Health zaznamená nový odhad VO2 max, včetně souvislostí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notifica con il confronto ogni volta che Apple Health registra una nuova stima VO2 max."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értesítést kapsz, amikor az Apple Health új VO2 max-becslést rögzít, összehasonlítással együtt."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O notificare de fiecare dată când Apple Health înregistrează o estimare VO2 max nouă, cu detalii de comparație."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ειδοποίηση κάθε φορά που το Apple Health καταγράφει νέα εκτίμηση VO2 max, μαζί με σύγκριση."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienie o każdym nowym oszacowaniu VO2 max w Apple Health wraz z porównaniem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornenie pri každom novom odhade VO2 max v Apple Health spolu s porovnaním."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En notis varje gång Apple Health registrerar en ny VO2 max-uppskattning, med en jämförelse."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבלת עדכון בכל פעם ש-Apple Health מתעד אומדן VO2 max חדש, עם פרטים להשוואה."
          }
        }
      }
    },
    "A nudge when Apple Health hasn't logged an estimate in a while, and what refreshes it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A nudge when Apple Health hasn't logged an estimate in a while, and what refreshes it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Hinweis, wenn Apple Health länger keine Schätzung erfasst hat, und was eine neue Schätzung ermöglicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel si Apple Health n’a pas enregistré d’estimation depuis un moment, avec des précisions sur ce qui peut en déclencher une nouvelle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een melding wanneer Apple Health al een tijd geen schatting heeft geregistreerd, met uitleg over wat een nieuwe schatting kan opleveren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 一段時間沒有記錄新估算值時提醒你，並說明如何取得新估算值。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминание, если Apple Health давно не записывал оценку, и сведения о том, что помогает получить новую."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنبيه عند تأخر تقدير Apple Health، مع توضيح ما يساعد على تحديثه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe un aviso si Apple Health tarda en registrar otra estimación y descubre qué puede actualizarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Healthの推定値がしばらく更新されていないときに通知し、更新につながる運動を案内します。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับการแจ้งเตือนเมื่อ Apple Health ไม่ได้บันทึกค่าประมาณมาระยะหนึ่ง พร้อมข้อมูลว่ากิจกรรมใดช่วยให้มีค่าใหม่"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornění, když Apple Health delší dobu nezaznamená nový odhad, a informace o tom, co může vést k jeho obnovení."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria quando Apple Health non registra una stima da un po’ e un’indicazione su come ottenerne una nuova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Emlékeztető, ha az Apple Health egy ideje nem rögzített becslést, és tippek egy új becsléshez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un memento când Apple Health nu a înregistrat o estimare de ceva timp și sugestii pentru a obține una nouă."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπενθύμιση όταν το Apple Health έχει καιρό να καταγράψει εκτίμηση, μαζί με συμβουλές για το πώς μπορεί να ανανεωθεί."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienie, gdy Apple Health od dawna nie zarejestrowało oszacowania, oraz wskazówki, jak uzyskać nowe."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripomenutie, keď Apple Health už dlhšie nezaznamenalo odhad, a tipy, ako získať nový."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En påminnelse när Apple Health inte har registrerat en uppskattning på ett tag, med tips om hur du får en ny."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תזכורת כשלא נרשם אומדן חדש ב-Apple Health במשך זמן מה, והסבר איך אפשר לקבל אומדן חדש."
          }
        }
      }
    },
    "A personal fitness target, not a medical threshold. It drives the Today ring and target lines in Trends.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
