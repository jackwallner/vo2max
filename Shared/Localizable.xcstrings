            "state": "translated",
            "value": "Apre i dettagli della stima dell’età fitness"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyitja a fitneszkor becslésének részleteit"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide detaliile estimării vârstei de fitness"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει τις λεπτομέρειες της εκτίμησης ηλικίας φυσικής κατάστασης"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera szczegóły szacowania wieku sprawnościowego"
          }
        },
        "sk": {
