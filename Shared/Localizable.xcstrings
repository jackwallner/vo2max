    "Apple Health records a VO2 max estimate after a qualifying outdoor workout with Apple Watch. %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health records a VO2 max estimate after a qualifying outdoor workout with Apple Watch. %1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health erfasst nach einem passenden Training im Freien mit Apple Watch einen VO2max-Schätzwert. %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health enregistre une estimation de VO2 max après une séance adaptée en plein air avec l’Apple Watch. %1$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health registreert een VO2max-schatting na een geschikte buitentraining met Apple Watch. %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple Watch 完成符合條件的戶外運動後，Apple Health 會記錄 VO2 max 估算值。%1$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health записывает оценку VO2 max после квалификационной тренировки на открытом воздухе с Apple Watch. %1$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجل Apple Health تقدير VO2 max بعد تمرين خارجي مستوفٍ للشروط باستخدام Apple Watch. %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health registra una estimación de VO2 max después de un entrenamiento al aire libre que cumpla los requisitos, con el Apple Watch puesto. %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "条件を満たす屋外ワークアウトをApple Watchで記録すると、Apple HealthにVO2 maxの推定値が記録されることがあります。%1$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health อาจบันทึกค่าประมาณ VO2 max หลังออกกำลังกายกลางแจ้งตามเงื่อนไขด้วย Apple Watch %1$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health může zaznamenat odhad VO2 max po vhodném venkovním tréninku s Apple Watch. %1$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health può registrare una stima VO2 max dopo un allenamento all’aperto adatto, svolto con Apple Watch. %1$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Health megfelelő szabadtéri, Apple Watch-csal rögzített edzés után VO2 max-becslést készíthet. %1$@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health poate înregistra o estimare VO2 max după un antrenament potrivit în aer liber, făcut cu Apple Watch. %1$@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple Health μπορεί να καταγράψει εκτίμηση VO2 max μετά από κατάλληλη υπαίθρια προπόνηση με Apple Watch. %1$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health może oszacować VO2 max po odpowiednim treningu na świeżym powietrzu z Apple Watchem. %1$@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health môže zaznamenať odhad VO2 max po vhodnom tréningu vonku s Apple Watch. %1$@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health kan registrera en VO2 max-uppskattning efter ett lämpligt träningspass utomhus med Apple Watch. %1$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health עשוי לתעד אומדן VO2 max אחרי אימון מתאים בחוץ עם Apple Watch. %1$@"
          }
        }
      }
    },
