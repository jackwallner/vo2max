          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع معدل ضربات القلب أثناء الراحة وتعافي القلب والحمل القلبي خلال الفترة التي تختارها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue la frecuencia cardíaca en reposo, la recuperación cardíaca y la carga cardiovascular durante el periodo que elijas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ期間の安静時心拍数、心拍数の回復、心肺負荷を追跡できます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตามอัตราการเต้นของหัวใจขณะพัก การฟื้นตัวของอัตราการเต้นของหัวใจ และภาระคาร์ดิโอในช่วงเวลาที่เลือก"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj klidovou tepovou frekvenci, obnovu tepu a kardio zátěž ve zvoleném období."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui la frequenza cardiaca a riposo, il recupero cardiaco e il carico cardio nel periodo scelto."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעקב אחר דופק במנוחה, התאוששות הדופק ועומס אירובי לאורך התקופה שתבחר."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kövesd a nyugalmi pulzust, a pulzus-visszaállást és a kardióterhelést a választott időszakban."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărește pulsul în repaus, recuperarea frecvenței cardiace și încărcarea cardio în perioada aleasă."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακολούθησε τον καρδιακό ρυθμό σε ηρεμία, την αποκατάσταση καρδιακού ρυθμού και το καρδιακό φορτίο στο διάστημα που επιλέγεις."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź tętno spoczynkowe, regenerację tętna i obciążenie kardio w wybranym okresie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj pokojový tep, regeneráciu srdcového tepu a kardio záťaž vo vybranom období."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ vilopuls, pulsåterhämtning och konditionsbelastning under perioden du väljer."
          }
        }
      }
    },
