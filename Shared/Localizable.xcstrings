    "Target outlook needs at least five readings across the last 180 days.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target outlook needs at least five readings across the last 180 days."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zielausblick erfordert mindestens fünf Messwerte in den letzten 180 Tagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les perspectives cibles nécessitent au moins cinq lectures au cours des 180 derniers jours."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor de doelvooruitzichten zijn minimaal vijf metingen nodig gedurende de afgelopen 180 dagen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標前景需要過去 180 天內至少 5 個讀數。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Целевой прогноз требует как минимум пяти показаний за последние 180 дней."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج التوقعات المستهدفة إلى خمس قراءات على الأقل خلال آخر 180 يومًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La perspectiva objetivo necesita al menos cinco lecturas en los últimos 180 días."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標の見通しには、過去 180 日間で少なくとも 5 回の測定値が必要です。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนวโน้มเป้าหมายต้องมีการอ่านอย่างน้อยห้าครั้งในช่วง 180 วันที่ผ่านมา"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cílový výhled potřebuje alespoň pět měření za posledních 180 dní."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prospettive target richiedono almeno cinque letture negli ultimi 180 giorni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Target Outlook legalább öt mérést igényel az elmúlt 180 nap során."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Perspectiva țintă necesită cel puțin cinci citiri în ultimele 180 de zile."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προοπτική στόχου χρειάζεται τουλάχιστον πέντε μετρήσεις τις τελευταίες 180 ημέρες."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Docelowa prognoza wymaga co najmniej pięciu odczytów w ciągu ostatnich 180 dni."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cieľový výhľad potrebuje aspoň päť meraní za posledných 180 dní."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Målutsikterna behöver minst fem avläsningar under de senaste 180 dagarna."
          }
        }
      }
    },
