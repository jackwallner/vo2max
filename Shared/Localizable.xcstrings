    "Latest, average, low, high, and the change against the previous window over 30 days, 90 days, 6 months, or a year.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest, average, low, high, and the change against the previous window over 30 days, 90 days, 6 months, or a year."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuell, Durchschnitt, Tief, Hoch und die Veränderung gegenüber dem vorherigen Fenster über 30 Tage, 90 Tage, 6 Monate oder ein Jahr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernier, moyen, faible, élevé et variation par rapport à la fenêtre précédente sur 30 jours, 90 jours, 6 mois ou un an."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laatste, gemiddelde, laag, hoog en de verandering ten opzichte van de vorige periode over 30 dagen, 90 dagen, 6 maanden of een jaar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最新、平均、最低、最高以及 30 天、90 天、6 個月或一年內相對於前一個窗口的變化。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последнее, среднее, минимальное, максимальное и изменение по сравнению с предыдущим окном за 30 дней, 90 дней, 6 месяцев или год."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأحدث والمتوسط والمنخفض والعالي والتغيير مقابل النافذة السابقة على مدار 30 يومًا أو 90 يومًا أو 6 أشهر أو سنة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Último, promedio, mínimo, máximo y el cambio con respecto a la ventana anterior durante 30 días, 90 días, 6 meses o un año."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新、平均、低値、高値、および 30 日、90 日、6 か月、または 1 年間にわたる前のウィンドウに対する変化。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล่าสุด เฉลี่ย ต่ำ สูง และการเปลี่ยนแปลงเทียบกับกรอบเวลาก่อนหน้าในช่วง 30 วัน 90 วัน 6 เดือน หรือหนึ่งปี"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejnovější, průměr, nízká, vysoká a změna oproti předchozímu období za 30 dní, 90 dní, 6 měsíců nebo rok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultimo, medio, minimo, massimo e la variazione rispetto alla finestra precedente nell'arco di 30 giorni, 90 giorni, 6 mesi o un anno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legutóbbi, átlagos, alacsony, magas és az előző ablakhoz viszonyított változás 30 nap, 90 nap, 6 hónap vagy egy év alatt."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel mai recent, mediu, scăzut, ridicat și modificarea față de fereastra anterioară pe 30 de zile, 90 de zile, 6 luni sau un an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τελευταία, μέση, χαμηλή, υψηλή και η αλλαγή σε σχέση με το προηγούμενο παράθυρο για 30 ημέρες, 90 ημέρες, 6 μήνες ή ένα έτος."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najnowsze, średnie, najniższe, wysokie i zmiana w stosunku do poprzedniego okna w ciągu 30 dni, 90 dni, 6 miesięcy lub roku."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najnovšie, priemerné, nízke, vysoké a zmena oproti predchádzajúcemu obdobiu za 30 dní, 90 dní, 6 mesiacov alebo rok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Senaste, genomsnittliga, låga, höga och förändringen mot föregående fönster under 30 dagar, 90 dagar, 6 månader eller ett år."
          }
        }
      }
    },
