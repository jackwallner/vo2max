    "Used for the broad fitness age estimate and VO2+ typical-range context. These are motivational estimates, not clinical results.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for the broad fitness age estimate and VO2+ typical-range context. These are motivational estimates, not clinical results."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird für die umfassende Schätzung des Fitnessalters und den VO2+ typischen Bereichskontext verwendet. Dabei handelt es sich um Motivationsschätzungen, nicht um klinische Ergebnisse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour l’estimation générale de l’âge de condition physique et le contexte de plage typique VO2+. Il s’agit d’estimations motivationnelles et non de résultats cliniques."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt voor de brede schatting van de fitnessleeftijd en de VO2+-context voor het typische bereik. Dit zijn motiverende schattingen, geen klinische resultaten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於廣泛的健康年齡估計和 VO2+ 典型範圍上下文。這些是動機估計，而不是臨床結果。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется для общей оценки возраста пригодности и контекста типичного диапазона VO2+. Это мотивационные оценки, а не клинические результаты."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم لتقدير عمر اللياقة البدنية الواسع وسياق النطاق النموذجي VO2+. هذه تقديرات تحفيزية، وليست نتائج سريرية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se utiliza para la estimación amplia de la edad física y el contexto de rango típico VO2+. Estas son estimaciones motivacionales, no resultados clínicos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広範なフィットネス年齢推定値と VO2+ の標準範囲のコンテキストに使用されます。これらは動機付けの推定値であり、臨床結果ではありません。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้สำหรับการประมาณอายุสมรรถภาพทางกายแบบกว้างและบริบทช่วงทั่วไปของ VO2+ สิ่งเหล่านี้เป็นเพียงการประมาณการเชิงสร้างแรงบันดาลใจ ไม่ใช่ผลลัพธ์ทางคลินิก"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používá se pro široký odhad fitness věku a VO2+ typického rozsahu. Jedná se o motivační odhady, nikoli klinické výsledky."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzato per la stima generale dell'età di fitness e per il contesto dell'intervallo tipico VO2+. Queste sono stime motivazionali, non risultati clinici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A széles körű fitnesz-életkor becsléséhez és a VO2+ tipikus tartomány kontextusához használják. Ezek motivációs becslések, nem klinikai eredmények."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosit pentru estimarea amplă a vârstei de fitness și contextul intervalului tipic VO2+. Acestea sunt estimări motivaționale, nu rezultate clinice."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιείται για την ευρεία εκτίμηση ηλικίας φυσικής κατάστασης και το τυπικό πλαίσιο VO2+. Αυτές είναι εκτιμήσεις κινήτρων, όχι κλινικά αποτελέσματα."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stosowany do szerokiego oszacowania wieku sprawnościowego i kontekstu typowego zakresu VO2+. Są to szacunki motywacyjne, a nie wyniki kliniczne."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Používa sa pre široký odhad fitness veku a kontext typického rozsahu VO2+. Ide o motivačné odhady, nie klinické výsledky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Används för den breda uppskattningen av konditionsåldern och VO2+ typiskt intervall. Dessa är motiverande uppskattningar, inte kliniska resultat."
          }
        }
      }
    },
