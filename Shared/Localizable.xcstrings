    "VO2+ is active on this Apple ID. Restore Purchases remains available in Settings if access ever looks incorrect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ is active on this Apple ID. Restore Purchases remains available in Settings if access ever looks incorrect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ ist mit dieser Apple-ID aktiv. Falls der Zugriff nicht stimmen sollte, kannst du in den Einstellungen weiterhin „Käufe wiederherstellen“ verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ est actif avec cet identifiant Apple. La fonction « Restaurer les achats » reste disponible dans Réglages si l’accès semble incorrect."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ is actief voor deze Apple ID. Aankopen herstellen blijft beschikbaar in Instellingen als er iets mis lijkt met je toegang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Apple ID 已啟用 VO2+。若訂閱權限有誤，可在「設定」中使用「回復購買項目」。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ подключена для этого Apple ID. Если доступ работает неправильно, восстановите покупки в «Настройках»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشتراك VO2+ نشط لهذا Apple ID. إذا لم يظهر الوصول كما ينبغي، يمكنك استعادة المشتريات من «الإعدادات»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ está activo para este Apple ID. Si el acceso no funciona, puedes restaurar las compras desde «Configuración»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple IDではVO2+が有効です。利用権に問題がある場合は、「設定」から購入を復元できます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ ใช้งานได้กับ Apple ID นี้ หากสิทธิ์ใช้งานมีปัญหา ให้กู้คืนรายการซื้อในการตั้งค่า"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ je pro toto Apple ID aktivní. Pokud přístup někdy nebude fungovat správně, můžete v Nastavení obnovit nákupy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ è attivo per questo ID Apple. Se l’accesso non sembra corretto, puoi ripristinare gli acquisti in Impostazioni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A VO2+ aktív ezen az Apple ID-n. Ha a hozzáférés nem megfelelő, visszaállíthatod a vásárlásokat a Beállításokban."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ este activ pentru acest Apple ID. Dacă accesul nu funcționează corect, poți restaura achizițiile din Setări."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το VO2+ είναι ενεργό για αυτό το Apple ID. Αν η πρόσβαση δεν λειτουργεί σωστά, μπορείς να επαναφέρεις τις αγορές από τις Ρυθμίσεις."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ jest aktywne na tym Apple ID. Jeśli dostęp nie działa prawidłowo, możesz przywrócić zakupy w Ustawieniach."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ je aktívne pre toto Apple ID. Ak prístup nefunguje správne, nákupy môžeš obnoviť v Nastaveniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ är aktivt för det här Apple-ID:t. Om åtkomsten inte fungerar kan du återställa köp i Inställningar."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2+ פעיל עבור Apple ID זה. אם הגישה אינה תקינה, אפשר לשחזר רכישות בהגדרות."
          }
        }
      }
    },
