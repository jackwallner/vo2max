    "An outdoor walk, run, or hike recorded with Apple Watch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An outdoor walk, run, or hike recorded with Apple Watch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Spaziergang, Lauf oder eine Wanderung im Freien, aufgezeichnet mit Apple Watch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une marche, une course ou une randonnée en plein air enregistrée avec Apple Watch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een wandeling, hardloopsessie of hike in de buitenlucht, opgenomen met Apple Watch."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple Watch 記錄的戶外步行、跑步或健行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогулка, пробежка или поход на свежем воздухе, записанные с помощью Apple Watch."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تسجيل المشي أو الجري أو المشي في الهواء الطلق باستخدام Apple Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una caminata, carrera o caminata al aire libre registrada con Apple Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch で記録された屋外のウォーキング、ランニング、またはハイキング。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเดิน วิ่ง หรือเดินป่ากลางแจ้งที่บันทึกไว้ด้วย Apple Watch"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Venkovní procházka, běh nebo túra zaznamenaná pomocí Apple Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una passeggiata, una corsa o un'escursione all'aperto registrata con Apple Watch."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kültéri séta, futás vagy túrázás a Apple Watch segítségével."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O plimbare, alergare sau drumeție în aer liber înregistrată cu Apple Watch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας υπαίθριος περίπατος, τρέξιμο ή πεζοπορία που καταγράφηκε με το Apple Watch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spacer, bieg lub wędrówka na świeżym powietrzu zarejestrowana za pomocą Apple Watch."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vonkajšia prechádzka, beh alebo túra zaznamenaná pomocou Apple Watch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En utomhuspromenad, löpning eller vandring inspelad med Apple Watch."
          }
        }
      }
    },
