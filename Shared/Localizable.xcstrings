    "No Cardio Recovery readings in %@. Choose a longer range, or check that Apple Health has this data.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Cardio Recovery readings in %1$@. Choose a longer range, or check that Apple Health has this data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Cardio-Erholungswerte für %1$@. Wähle einen längeren Zeitraum oder prüfe, ob diese Daten in Apple Health vorhanden sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune mesure de récupération cardio pour %1$@. Choisissez une période plus longue ou vérifiez que ces données figurent dans Apple Health."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen cardioherstelmetingen voor %1$@. Kies een langere periode of controleer of Apple Health deze gegevens bevat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 期間沒有心肺恢復資料。請選擇較長的期間，或確認 Apple Health 中有這項資料。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет данных о восстановлении пульса за %1$@. Выберите более длительный период или проверьте, есть ли эти данные в Apple Health."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد قراءات لتعافي القلب خلال %1$@. اختر فترة أطول أو تحقق من توفر البيانات في Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay datos de recuperación cardíaca para %1$@. Elige un período más largo o comprueba si Apple Health tiene estos datos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の心拍数回復データはありません。期間を長くするか、Apple Healthにデータがあるか確認してください。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีข้อมูลการฟื้นตัวของอัตราการเต้นของหัวใจในช่วง %1$@ เลือกช่วงเวลาที่ยาวขึ้น หรือตรวจสอบว่า Apple Health มีข้อมูลนี้หรือไม่"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V období %1$@ nejsou žádné údaje o obnově tepové frekvence. Zvolte delší období nebo ověřte, že jsou tato data v Apple Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna misurazione del recupero della frequenza cardiaca nel periodo %1$@. Scegli un periodo più lungo o verifica che Apple Health contenga questi dati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs pulzus-visszaállási mérés ebben az időszakban: %1$@. Válassz hosszabb időszakot, vagy ellenőrizd az adatokat az Apple Healthben."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există măsurători pentru recuperarea frecvenței cardiace în perioada %1$@. Alege o perioadă mai lungă sau verifică datele din Apple Health."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν μετρήσεις αποκατάστασης καρδιακού ρυθμού για την περίοδο %1$@. Επίλεξε μεγαλύτερη περίοδο ή έλεγξε αν υπάρχουν τα δεδομένα στο Apple Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak pomiarów regeneracji tętna w okresie %1$@. Wybierz dłuższy okres albo sprawdź, czy Apple Health ma te dane."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Za obdobie %1$@ nie sú merania regenerácie srdcového tepu. Vyber dlhšie obdobie alebo skontroluj, či má Apple Health tieto údaje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga värden för pulsåterhämtning under %1$@. Välj en längre period eller kontrollera att Apple Health har dessa data."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מדידות של התאוששות הדופק בתקופה %1$@. אפשר לבחור תקופה ארוכה יותר או לבדוק אם הנתונים מופיעים ב-Apple Health."
          }
        }
      }
    },
