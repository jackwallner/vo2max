          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดรายละเอียดการประมาณอายุความฟิต"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře podrobnosti odhadu kondičního věku"
          }
        },
        "it": {
