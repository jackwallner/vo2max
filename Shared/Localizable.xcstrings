    "How far your heart rate falls in the minute after a workout, trended across the range you pick.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far your heart rate falls in the minute after a workout, trended across the range you pick."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit deine Herzfrequenz in der Minute nach dem Training abfällt, im Trend über den von dir ausgewählten Bereich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans quelle mesure votre fréquence cardiaque diminue dans la minute qui suit une séance d'entraînement, tendance sur la plage que vous choisissez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe ver je hartslag daalt in de minuut na een training, trendmatig over het door je gekozen bereik."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "運動後一分鐘內您的心率下降了多少，在您選擇的範圍內呈現趨勢。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько сильно падает ваш пульс через минуту после тренировки, в зависимости от выбранного вами диапазона."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مدى انخفاض معدل ضربات قلبك في الدقيقة التالية للتمرين، وفقًا للنطاق الذي تختاره."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto cae tu frecuencia cardíaca en el minuto después de un entrenamiento, con tendencia en el rango que elijas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークアウト後の 1 分間に心拍数がどの程度低下するか、選択した範囲全体での傾向を示します。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัตราการเต้นของหัวใจของคุณลดลงแค่ไหนในนาทีหลังการออกกำลังกาย โดยมีแนวโน้มตามช่วงที่คุณเลือก"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak hluboko klesne vaše tepová frekvence za minutu po tréninku, trendová ve zvoleném rozsahu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di quanto diminuisce la tua frequenza cardiaca nel minuto successivo a un allenamento, con tendenza nell'intervallo selezionato."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyire esik le a pulzusszáma az edzés utáni percben, az Ön által kiválasztott tartományon belül."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de mult scade ritmul cardiac într-un minut după un antrenament, în tendințe în intervalul pe care îl alegeți."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο πέφτει ο καρδιακός σας ρυθμός ένα λεπτό μετά από μια προπόνηση, με τάση σε όλο το εύρος που επιλέγετε."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopień spadku tętna w ciągu minuty po treningu, trend w wybranym zakresie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako hlboko klesne vaša srdcová frekvencia za minútu po tréningu, trendová v rámci zvoleného rozsahu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur långt din puls faller på minuten efter ett träningspass, trendmässigt över det intervall du väljer."
          }
        }
      }
    },
