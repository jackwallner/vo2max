    "Compare each period with the matching one before it once both windows contain Apple Health estimates.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare each period with the matching one before it once both windows contain Apple Health estimates."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche jeden Zeitraum mit dem entsprechenden vorherigen, sobald beide Zeitfenster Apple Health-Schätzungen enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez chaque période à la période précédente correspondante lorsque les deux fenêtres contiennent des estimations d’Apple Health."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijk elke periode met de overeenkomstige vorige periode zodra beide vensters schattingen van Apple Health bevatten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦兩個視窗都包含 Apple Health 估計值，深度趨勢就會將每個時期與先前的匹配時期進行比較。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Глубокие тренды сравнивают каждый период с соответствующим периодом перед ним, как только оба окна содержат оценки Apple Health."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقارن الاتجاهات العميقة كل فترة بالفترة المطابقة التي تسبقها بمجرد أن تحتوي كلا النافذتين على تقديرات Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara cada período con el anterior correspondiente cuando ambos intervalos contengan estimaciones de Apple Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の期間に Apple Health の推定値がある場合、各期間を対応する前の期間と比較します。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปรียบเทียบแต่ละช่วงกับช่วงก่อนหน้าที่ตรงกัน เมื่อทั้งสองช่วงมีค่าประมาณจาก Apple Health"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hluboké trendy porovnávají každé období s odpovídajícím obdobím před ním, jakmile obě okna obsahují odhady Apple Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I trend profondi confrontano ciascun periodo con quello corrispondente precedente quando entrambe le finestre contengono stime Apple Health."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyes időszakokat a megfelelő korábbi időszakkal hasonlítja össze, ha mindkét időablak Apple Health-becsléseket tartalmaz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Compară fiecare perioadă cu cea corespunzătoare anterioară după ce ambele intervale conțin estimări Apple Health."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύγκρινε κάθε περίοδο με την αντίστοιχη προηγούμενη, όταν και τα δύο διαστήματα περιέχουν εκτιμήσεις Apple Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głębokie trendy porównują każdy okres z pasującym okresem poprzedzającym, gdy oba okna zawierają szacunki Apple Health."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlboké trendy porovnávajú každé obdobie so zodpovedajúcim obdobím pred ním, keď obe okná obsahujú odhady Apple Health."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jämför varje period med motsvarande föregående period när båda tidsfönstren innehåller Apple Health-uppskattningar."
          }
        }
      }
    },
