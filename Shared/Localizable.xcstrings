    "Generate a private PDF report of any period to keep or share with a coach or clinician.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate a private PDF report of any period to keep or share with a coach or clinician."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle einen privaten PDF-Bericht über einen beliebigen Zeitraum, um ihn aufzubewahren oder mit einem Trainer oder Kliniker zu teilen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Générez un rapport PDF privé de toute période à conserver ou à partager avec un coach ou un clinicien."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Genereer een privé PDF-rapport van elke periode om te bewaren of te delen met een coach of arts."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生任意時期的私人 PDF 報告，以保存或與教練或臨床醫生分享。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте частный отчет PDF за любой период, чтобы сохранить его или поделиться с тренером или врачом."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإنشاء تقرير PDF خاص لأي فترة للاحتفاظ به أو مشاركته مع المدرب أو الطبيب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genere un informe privado PDF de cualquier período para conservarlo o compartirlo con un entrenador o médico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意の期間のプライベート PDF レポートを生成し、コーチや臨床医と保存または共有します。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างรายงาน PDF ส่วนตัวในช่วงเวลาใดก็ได้เพื่อเก็บไว้หรือแบ่งปันกับโค้ชหรือแพทย์"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vygenerujte soukromou zprávu PDF za jakékoli období, kterou si můžete ponechat nebo sdílet s trenérem nebo lékařem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera un report privato PDF di qualsiasi periodo da conservare o condividere con un coach o un medico."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozzon létre privát PDF jelentést bármely időszakról, amelyet megtarthat vagy megoszthat egy edzővel vagy klinikussal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Generați un raport privat PDF pentru orice perioadă pentru a-l păstra sau a le împărtăși unui antrenor sau clinician."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε μια ιδιωτική αναφορά PDF οποιασδήποτε περιόδου για να κρατήσετε ή να μοιραστείτε με έναν προπονητή ή κλινικό γιατρό."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygeneruj prywatny raport PDF z dowolnego okresu, aby zachować go lub udostępnić trenerowi lub lekarzowi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vygenerujte si súkromnú správu PDF za akékoľvek obdobie, ktorú môžete uchovávať alebo zdieľať s trénerom alebo lekárom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa en privat PDF rapport för vilken period som helst att behålla eller dela med en coach eller läkare."
          }
        }
      }
    },
