        }
      }
    },
    "A fitness-awareness signal, not a medical measurement. This app does not diagnose, treat, or monitor any condition. Discuss heart health concerns with a qualified clinician.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fitness-awareness signal, not a medical measurement. This app does not diagnose, treat, or monitor any condition. Discuss heart health concerns with a qualified clinician."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fitness-Bewusstseinssignal, keine medizinische Messung. Diese App diagnostiziert, behandelt oder überwacht keine Erkrankungen. Besprich Herzgesundheitsprobleme mit einem qualifizierten Arzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un signal de sensibilisation à la condition physique, pas une mesure médicale. Cette application ne diagnostique, ne traite ni ne surveille aucune condition. Discutez de vos problèmes de santé cardiaque avec un clinicien qualifié."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een fitnessbewustzijnssignaal, geen medische meting. Deze app diagnosticeert, behandelt of bewaakt geen enkele aandoening. Bespreek zorgen over de hartgezondheid met een gekwalificeerde arts."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "健身意識訊號，而不是醫學測量。此應用程式不會診斷、治療或監測任何狀況。與合格的臨床醫生討論心臟健康問題。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигнал осведомленности о фитнесе, а не медицинское измерение. Это приложение не диагностирует, не лечит и не контролирует какие-либо состояния. Обсудите проблемы со здоровьем сердца с квалифицированным врачом."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشارة للتوعية باللياقة البدنية، وليست قياسًا طبيًا. لا يقوم هذا التطبيق بتشخيص أو علاج أو مراقبة أي حالة. ناقش المخاوف المتعلقة بصحة القلب مع طبيب مؤهل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una señal de concienciación sobre el estado físico, no una medición médica. Esta aplicación no diagnostica, trata ni monitorea ninguna condición. Consulta tus preocupaciones sobre la salud del corazón con un médico calificado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医学的な測定ではなく、フィットネス意識の信号です。このアプリは、いかなる状態も診断、治療、監視するものではありません。心臓の健康に関する懸念については、資格のある臨床医に相談してください。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัญญาณการรับรู้ถึงฟิตเนส ไม่ใช่การวัดผลทางการแพทย์ แอปนี้ไม่ได้วินิจฉัย รักษา หรือตรวจสอบอาการใดๆ ปรึกษาปัญหาสุขภาพหัวใจกับแพทย์ที่มีคุณสมบัติเหมาะสม"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Signál informující o kondici, nikoli lékařské měření. Tato aplikace nediagnostikuje, neléčí ani nesleduje žádný stav. Diskutujte o zdravotních problémech srdce s kvalifikovaným lékařem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un segnale di consapevolezza del fitness, non una misurazione medica. Questa app non diagnostica, tratta o monitora alcuna condizione. Discuti i problemi di salute del cuore con un medico qualificato."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitness-tudatosság jele, nem orvosi mérés. Ez az alkalmazás nem diagnosztizál, kezel vagy figyel semmilyen állapotot. Beszélje meg szív-egészségügyi problémáit egy képzett klinikussal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un semnal de conștientizare a fitnessului, nu o măsurătoare medicală. Această aplicație nu diagnosticează, tratează și nu monitorizează nicio afecțiune. Discutați problemele legate de sănătatea inimii cu un medic calificat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα σήμα ευαισθητοποίησης για τη φυσική κατάσταση, όχι μια ιατρική μέτρηση. Αυτή η εφαρμογή δεν κάνει διάγνωση, θεραπεία ή παρακολούθηση οποιασδήποτε πάθησης. Συζητήστε τις ανησυχίες για την υγεία της καρδιάς με έναν εξειδικευμένο κλινικό ιατρό."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sygnał świadomości sprawności fizycznej, a nie pomiar medyczny. Ta aplikacja nie diagnozuje, nie leczy ani nie monitoruje żadnego stanu. Omów problemy związane ze zdrowiem serca z wykwalifikowanym lekarzem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Signál informovania o kondícii, nie lekárske meranie. Táto aplikácia nediagnostikuje, nelieči ani nesleduje žiadny stav. Diskutujte o problémoch zdravia srdca s kvalifikovaným lekárom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En konditionsmedvetenhetssignal, inte en medicinsk mätning. Denna app diagnostiserar, behandlar eller övervakar inte något tillstånd. Diskutera hjärthälsa med en kvalificerad läkare."
          }
        }
      }
    },
    "A monthly recap of your cardio fitness trend, target progress, and best reading.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A monthly recap of your cardio fitness trend, target progress, and best reading."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Monatsrückblick auf deinen Cardiofitness-Trend, deinen Zielfortschritt und deinen besten Messwert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bilan mensuel de votre tendance cardio, de votre progression vers l’objectif et de votre meilleur résultat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een maandoverzicht van je cardioconditie, je voortgang richting je doel en je beste resultaat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每月回顧你的心適能趨勢、目標進度和最佳測量結果。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ежемесячный обзор динамики кардиовыносливости, прогресса к цели и лучшего результата."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملخص شهري لاتجاه لياقتك القلبية وتقدمك نحو هدفك وأفضل نتيجة لك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un resumen mensual de tu tendencia de capacidad aeróbica, el progreso hacia tu objetivo y tu mejor resultado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心肺機能の傾向、目標への進捗、最良の測定値を毎月まとめます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สรุปแนวโน้มคาร์ดิโอฟิตเนส ความคืบหน้าสู่เป้าหมาย และผลการวัดที่ดีที่สุดของคุณในแต่ละเดือน"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měsíční přehled trendu kardiovaskulární kondice, postupu k cíli a nejlepší naměřené hodnoty."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un riepilogo mensile del trend della forma cardiovascolare, dei progressi verso l’obiettivo e del tuo miglior risultato."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Havi összefoglaló a kardiofitnesz alakulásáról, a célod felé tett lépésekről és a legjobb mérési eredményedről."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rezumat lunar al tendinței capacității cardiovasculare, al progresului către obiectiv și al celui mai bun rezultat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μηνιαία σύνοψη της τάσης της καρδιοαναπνευστικής ικανότητάς σου, της προόδου προς τον στόχο και της καλύτερης μέτρησής σου."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miesięczne podsumowanie trendu wydolności kardio, postępów w realizacji celu i najlepszego wyniku."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesačný prehľad trendu kardiovaskulárnej kondície, pokroku smerom k cieľu a najlepšieho nameraného výsledku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En månadsöversikt över din konditionstrend, dina framsteg mot målet och ditt bästa mätvärde."
          }
        }
      }
    },
