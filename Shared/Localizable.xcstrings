    "Your latest Apple Health estimate compared with broad reference values for age %lld and your selected reference.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your latest Apple Health estimate compared with broad reference values for age %1$lld and your selected reference."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine letzte Apple Health-Schätzung im Vergleich mit allgemeinen Referenzwerten für das Alter %1$lld und deiner ausgewählten Referenz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre dernière estimation Apple Health comparée aux valeurs de référence générales pour l'âge %1$lld et la référence sélectionnée."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je laatste Apple Health-schatting vergeleken met brede referentiewaarden voor leeftijd %1$lld en je geselecteerde referentie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您最新的 Apple Health 估計值與年齡 %1$lld 的廣泛參考值和您選擇的參考值進行了比較。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша последняя оценка Apple Health в сравнении с общими эталонными значениями для возраста %1$lld и выбранной вами эталонной величины."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقديرك الأخير لـ Apple Health مقارنة بالقيم المرجعية العامة للعمر %1$lld والمرجع الذي حددته."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu última estimación Apple Health comparada con valores de referencia amplios para la edad %1$lld y tu referencia seleccionada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新の Apple Health 推定値を、年齢 %1$lld および選択した基準の広範な基準値と比較しました。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าประมาณ Apple Health ล่าสุดของคุณเปรียบเทียบกับค่าอ้างอิงแบบกว้างสำหรับอายุ %1$lld และข้อมูลอ้างอิงที่คุณเลือก"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš nejnovější odhad Apple Health ve srovnání s obecnými referenčními hodnotami pro věk %1$lld a vámi vybranou referencí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua ultima stima Apple Health rispetto ai valori di riferimento generali per l'età %1$lld e al riferimento selezionato."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Ön legutóbbi Apple Health becslése összehasonlítva a %1$lld életkor és a kiválasztott referencia általános referenciaértékeivel."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cea mai recentă estimare Apple Health în comparație cu valorile de referință ample pentru vârsta %1$lld și referința selectată de dvs."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τελευταία σας εκτίμηση Apple Health σε σύγκριση με τις ευρείες τιμές αναφοράς για την ηλικία %1$lld και την επιλεγμένη αναφορά σας."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje najnowsze szacunki Apple Health w porównaniu z ogólnymi wartościami referencyjnymi dla wieku %1$lld i wybranym przez Ciebie numerem referencyjnym."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš najnovší odhad Apple Health v porovnaní so širokými referenčnými hodnotami pre vek %1$lld a vami vybranú referenciu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din senaste Apple Health uppskattning jämfört med breda referensvärden för ålder %1$lld och din valda referens."
          }
        }
      }
    },
    "Your latest cardio fitness estimate and trend.": {
