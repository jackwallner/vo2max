    "Every cached Apple Health estimate, shown read-only.%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every cached Apple Health estimate, shown read-only.%1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede zwischengespeicherte Apple Health-Schätzung wird schreibgeschützt angezeigt.%1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque estimation Apple Health mise en cache, affichée en lecture seule.%1$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke in de cache opgeslagen Apple Health-schatting, alleen-lezen weergegeven.%1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個快取的 Apple Health 估計值均以唯讀方式顯示。 %1$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая кэшированная оценка Apple Health отображается только для чтения.%1$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل تقدير Apple Health مخبأ، يظهر للقراءة فقط.%1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada estimación Apple Health almacenada en caché se muestra como de solo lectura.%1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュされたすべての Apple Health 推定値は読み取り専用で表示されます。%1$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกการประมาณการ Apple Health ที่แคชไว้ แสดงแบบอ่านอย่างเดียว%1$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý odhad Apple Health uložený v mezipaměti, zobrazen pouze pro čtení.%1$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni stima Apple Health memorizzata nella cache, mostrata in sola lettura.%1$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden gyorsítótárazott Apple Health becslés, csak olvasható.%1$@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare estimare Apple Health stocată în cache, afișată numai în citire.%1$@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε αποθηκευμένη κρυφή εκτίμηση Apple Health, εμφανίζεται μόνο για ανάγνωση.%1$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie szacunki Apple Health zapisane w pamięci podręcznej są wyświetlane tylko do odczytu.%1$@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý odhad Apple Health uložený vo vyrovnávacej pamäti, zobrazený len na čítanie.%1$@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje cachad Apple Health uppskattning, visas skrivskyddad.%1$@"
          }
        }
      }
    },
    "Every screen below is unlocked, and reads the range you pick.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every screen below is unlocked, and reads the range you pick."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Bildschirm unten ist entsperrt und zeigt den von dir ausgewählten Bereich an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque écran ci-dessous est déverrouillé et lit la plage que vous choisissez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk scherm hieronder is ontgrendeld en leest het bereik dat je kiest."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下面的每個螢幕都已解鎖，並讀取您選擇的範圍。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый экран ниже разблокирован и отображает выбранный вами диапазон."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إلغاء قفل كل شاشة أدناه، وتقرأ النطاق الذي تختاره."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pantalla a continuación está desbloqueada y lee el rango que elijas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下のすべての画面のロックが解除され、選択した範囲が読み取られます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกหน้าจอด้านล่างจะถูกปลดล็อค และอ่านช่วงที่คุณเลือก"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá obrazovka níže je odemčená a zobrazuje rozsah, který si vyberete."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni schermata sottostante è sbloccata e legge l'intervallo selezionato."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden alábbi képernyő fel van oldva, és az Ön által kiválasztott tartományt olvassa el."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare ecran de mai jos este deblocat și citește intervalul pe care îl alegeți."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε οθόνη παρακάτω είναι ξεκλείδωτη και διαβάζει το εύρος που επιλέγετε."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy ekran poniżej jest odblokowany i wyświetla wybrany zakres."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá obrazovka nižšie je odomknutá a zobrazuje rozsah, ktorý si vyberiete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje skärm nedan är upplåst och läser intervallet du väljer."
          }
        }
      }
    },
