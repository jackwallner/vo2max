        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@，將 %3$@ 改為 %4$@。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@, измените %3$@ на %4$@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@، قم بتغيير %3$@ مقابل %4$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@, cambia %3$@ frente a %4$@."
          }
        },
        "ja": {
