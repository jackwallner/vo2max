    "Generate a private PDF report of any period to keep or share with a coach or clinician.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate a private PDF report of any period to keep or share with a coach or clinician."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle einen PDF-Bericht für einen beliebigen Zeitraum. Du kannst ihn speichern oder mit einer Trainerin, einem Trainer oder medizinischem Fachpersonal teilen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un rapport PDF privé pour la période de votre choix, à conserver ou à partager avec un coach ou un professionnel de santé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een privé-PDF-rapport over een periode naar keuze, om te bewaren of met een coach of zorgverlener te delen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生任意期間的私人 PDF 報告，方便儲存，或分享給教練或醫療專業人員。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте частный отчет PDF за любой период, чтобы сохранить его или поделиться с тренером или врачом."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ تقرير PDF خاصًا عن أي فترة لتحفظه أو تشاركه مع مدرب أو مختص صحي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un informe PDF privado de cualquier período para guardarlo o compartirlo con un entrenador o profesional sanitario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意の期間のPDFレポートを作成して保存したり、コーチや医療専門家と共有したりできます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างรายงาน PDF ส่วนตัวของช่วงเวลาใดก็ได้เพื่อเก็บไว้หรือแชร์กับโค้ชหรือบุคลากรทางการแพทย์"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořte soukromou zprávu PDF za libovolné období a uložte si ji nebo sdílejte s trenérem či lékařem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un report PDF privato per qualsiasi periodo, da conservare o condividere con un allenatore o un medico."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Készíts privát PDF-jelentést bármely időszakról, és mentsd el vagy oszd meg az edződdel vagy orvosoddal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creează un raport PDF privat pentru orice perioadă, pe care îl poți păstra sau partaja cu un antrenor ori un medic."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιούργησε ιδιωτική αναφορά PDF για όποια περίοδο θέλεις και αποθήκευσέ τη ή μοιράσου τη με προπονητή ή επαγγελματία υγείας."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz prywatny raport PDF z dowolnego okresu, aby go zachować lub udostępnić trenerowi albo lekarzowi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvor súkromný PDF prehľad za ľubovoľné obdobie a ulož si ho alebo ho zdieľaj s trénerom či lekárom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa en privat PDF-rapport för valfri period som du kan spara eller dela med en tränare eller läkare."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
