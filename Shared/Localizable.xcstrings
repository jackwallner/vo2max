    "No Cardio Recovery readings in %@. Choose a longer range, or check that Apple Health has this data.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Cardio Recovery readings in %1$@. Choose a longer range, or check that Apple Health has this data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Cardioerholungs-Messwerte in %1$@. Wähle einen längeren Zeitraum oder prüfe, ob Apple Health diese Daten hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune mesure de récupération cardiaque pour %1$@. Choisissez une période plus longue ou vérifiez qu’Apple Health contient ces données."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen metingen voor cardioherstel in %1$@. Kies een langere periode of controleer of Apple Health deze gegevens heeft."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %1$@ 內沒有心跳恢復記錄。請選擇較長的時間範圍，或確認 Apple Health 中有此資料。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет данных о восстановлении пульса за %1$@. Выберите более длительный период или проверьте, есть ли эти данные в Apple Health."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد قراءات لمعدل تعافي النبض خلال %1$@. اختر فترة أطول أو تحقق من وجود هذه البيانات في Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay mediciones de recuperación cardiaca en %1$@. Elige un periodo más largo o comprueba si Apple Health contiene estos datos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期間 %1$@ の心拍数回復データがありません。期間を長くするか、Apple Health にこのデータがあるか確認してください。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีข้อมูลอัตราการฟื้นฟูคาร์ดิโอใน %1$@ เลือกช่วงเวลาให้นานขึ้น หรือตรวจสอบว่ามีข้อมูลนี้ใน Apple Health"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V období %1$@ nejsou k dispozici údaje o zotavení srdce. Zvol delší období nebo ověř, zda jsou tato data v Apple Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna misurazione del recupero cardiaco in %1$@. Scegli un periodo più lungo o verifica che Apple Health contenga questi dati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %1$@ időszakban nincs pulzusmegnyugvási adat. Válassz hosszabb időszakot, vagy ellenőrizd, hogy az Apple Health tartalmazza-e ezeket az adatokat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există măsurători ale recuperării pulsului în %1$@. Alege un interval mai lung sau verifică dacă Apple Health are aceste date."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν μετρήσεις καρδιακής αποκατάστασης για το %1$@. Επιλέξτε μεγαλύτερο διάστημα ή ελέγξτε αν το Apple Health έχει αυτά τα δεδομένα."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak pomiarów normalizacji tętna w okresie %1$@. Wybierz dłuższy okres lub sprawdź, czy Apple Health zawiera te dane."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Za obdobie %1$@ nie sú dostupné údaje o kardio regenerácii. Vyber dlhšie obdobie alebo skontroluj, či má Apple Health tieto údaje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga mätvärden för återhämtningspuls under %1$@. Välj en längre period eller kontrollera att Apple Health har uppgifterna."
          }
        }
      }
    },
