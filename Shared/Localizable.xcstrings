          "stringUnit": {
            "state": "translated",
            "value": "Set your own start and end date and every screen follows it, not just the four fixed windows."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege dein eigenes Start- und Enddatum fest und jeder Bildschirm folgt diesem Datum, nicht nur die vier festen Fenster."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez votre propre date de début et de fin et chaque écran la suit, pas seulement les quatre fenêtres fixes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel je eigen begin- en einddatum in en elk scherm volgt deze, niet alleen de vier vaste vensters."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定您自己的開始和結束日期，每個螢幕都會遵循它，而不僅僅是四個固定視窗。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите свою собственную дату начала и окончания, и каждый экран будет следовать за ней, а не только четыре фиксированных окна."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتعيين تاريخ البدء والانتهاء الخاص بك وتتبعه كل شاشة، وليس فقط النوافذ الأربعة الثابتة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establezca tu propia fecha de inicio y finalización y todas las pantallas la seguirán, no solo las cuatro ventanas fijas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自の開始日と終了日を設定すると、4 つの固定ウィンドウだけでなく、すべての画面がその日付に従います。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดวันที่เริ่มต้นและสิ้นสุดของคุณเอง จากนั้นทุกหน้าจอจะตามมา ไม่ใช่แค่หน้าต่างคงที่สี่หน้าต่าง"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte si vlastní počáteční a koncové datum a každá obrazovka jej bude následovat, nejen čtyři pevná okna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta la tua data di inizio e fine e ogni schermata la seguirà, non solo le quattro finestre fisse."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítsa be saját kezdési és befejezési dátumát, és minden képernyő követi, nem csak a négy rögzített ablak."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setați-vă propria dată de începere și de sfârșit și fiecare ecran o urmează, nu doar cele patru ferestre fixe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορίστε τη δική σας ημερομηνία έναρξης και λήξης και κάθε οθόνη την ακολουθεί, όχι μόνο τα τέσσερα σταθερά παράθυρα."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw własną datę początkową i końcową, a każdy ekran będzie podążał za nią, a nie tylko cztery stałe okna."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte si vlastný dátum začiatku a konca a každá obrazovka ho bude nasledovať, nielen štyri pevné okná."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ in ditt eget start- och slutdatum och varje skärm följer det, inte bara de fyra fasta fönstren."
          }
        }
      }
    },
