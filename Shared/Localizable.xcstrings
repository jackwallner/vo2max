    "Your health data never leaves your devices. No account, no cloud sync.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your health data never leaves your devices. No account, no cloud sync."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Gesundheitsdaten bleiben auf deinen Geräten. Kein Konto, keine Cloud-Synchronisierung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données de santé restent sur vos appareils. Aucun compte ni synchronisation dans le cloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gezondheidsgegevens blijven op je apparaten. Geen account of cloudsynchronisatie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "健康資料只會留在你的裝置上。不需帳戶，也不會同步至雲端。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные о здоровье не покидают ваши устройства. Учётная запись и синхронизация с облаком не нужны."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تغادر بياناتك الصحية أجهزتك. لا حاجة إلى حساب أو مزامنة سحابية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos de salud no salen de tus dispositivos. No necesitas una cuenta y no se sincronizan en la nube."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "健康データがデバイスの外に送られることはありません。アカウント登録もクラウド同期も不要です。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลสุขภาพจะไม่ออกจากอุปกรณ์ ไม่ต้องมีบัญชีและไม่มีการซิงค์ขึ้นคลาวด์"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše zdravotní data nikdy neopustí vaše zařízení. Bez účtu a synchronizace s cloudem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati sanitari non lasciano mai i tuoi dispositivi. Nessun account, nessuna sincronizzazione cloud."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egészségügyi adataid soha nem hagyják el az eszközeidet. Nincs fiók és nincs felhőszinkronizálás."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele tale de sănătate nu părăsesc niciodată dispozitivele. Fără cont și fără sincronizare în cloud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δεδομένα υγείας σου δεν φεύγουν ποτέ από τις συσκευές σου. Χωρίς λογαριασμό και χωρίς συγχρονισμό στο cloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dane zdrowotne nigdy nie opuszczają urządzeń. Bez konta i bez synchronizacji z chmurą."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje zdravotné údaje nikdy neopustia tvoje zariadenia. Bez účtu a synchronizácie s cloudom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina hälsodata lämnar aldrig dina enheter. Inget konto och ingen molnsynkronisering."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתוני הבריאות נשארים במכשירים שלך. ללא חשבון וללא סנכרון לענן."
          }
        }
      }
    },
