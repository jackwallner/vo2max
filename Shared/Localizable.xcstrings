    "Compare the latest estimate with broad reference values for your age and selected reference.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare the latest estimate with broad reference values for your age and selected reference."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche die neueste Schätzung mit groben Referenzwerten für dein Alter und das ausgewählte Referenzprofil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez la dernière estimation aux valeurs de référence générales pour votre âge et le profil choisi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijk de nieuwste schatting met algemene referentiewaarden voor je leeftijd en het gekozen profiel."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比較最新估算值與你所選年齡及參考個人檔案的一般參考值。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравните последнюю оценку с общими ориентирами для вашего возраста и выбранного профиля."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قارن أحدث تقدير بالقيم المرجعية العامة لعمرك والملف الذي اخترته."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara la última estimación con los valores de referencia generales para tu edad y el perfil seleccionado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新の推定値を、年齢と選択した参照プロフィールの一般的な参考値と比較します。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปรียบเทียบค่าประมาณล่าสุดกับข้อมูลอ้างอิงทั่วไปตามอายุและโปรไฟล์ที่เลือก"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Porovnejte nejnovější odhad s obecnými referenčními hodnotami pro váš věk a zvolený profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta l’ultima stima con i valori generali di riferimento per la tua età e il profilo scelto."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasonlítsd össze a legutóbbi becslést az életkorodhoz és a kiválasztott referenciaprofilhoz tartozó általános értékekkel."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Compară cea mai recentă estimare cu valorile generale pentru vârsta ta și profilul de referință ales."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύγκρινε την πιο πρόσφατη εκτίμηση με τις γενικές τιμές αναφοράς για την ηλικία σου και το επιλεγμένο προφίλ."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porównaj najnowsze oszacowanie z ogólnymi wartościami dla Twojego wieku i wybranego profilu odniesienia."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Porovnaj najnovší odhad so všeobecnými hodnotami pre tvoj vek a zvolený referenčný profil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jämför den senaste uppskattningen med allmänna referensvärden för din ålder och valda profil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השוואת האומדן האחרון לערכי ייחוס כלליים לפי הגיל ופרופיל הייחוס שנבחר."
          }
        }
      }
    },
