        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. عملية شراء لمرة واحدة تمنحك وصولًا دائمًا بلا اشتراك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Compra única, acceso de por vida y sin suscripción."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。買い切りで、サブスクリプション不要です。"
