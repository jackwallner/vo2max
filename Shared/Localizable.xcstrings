    "Resting heart rate, Cardio Recovery, and cardio load, trended over the range you pick.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resting heart rate, Cardio Recovery, and cardio load, trended over the range you pick."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruheherzfrequenz, Cardio-Erholung und Cardio-Belastung, Trend über den von dir ausgewählten Bereich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fréquence cardiaque au repos, récupération cardio et charge cardio, tendances sur la plage que vous choisissez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hartslag in rust, Cardioherstel en cardiobelasting, trendmatig over het door je gekozen bereik."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靜止心率、心肺恢復和心肺負荷在您選擇的範圍內呈現趨勢。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Частота пульса в состоянии покоя, кардиовосстановление и кардионагрузка в зависимости от выбранного вами диапазона."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تحديد معدل ضربات القلب أثناء الراحة واستعادة القلب وحمل القلب عبر النطاق الذي تختاره."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Frecuencia cardíaca en reposo, recuperación cardiovascular y carga cardiovascular, con tendencia en el rango que elijas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安静時心拍数、心肺機能回復量、心肺機能負荷が、選択した範囲で傾向を示します。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัตราการเต้นของหัวใจขณะพัก การฟื้นฟูหัวใจ และภาระของคาร์ดิโอ มีแนวโน้มในช่วงที่คุณเลือก"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klidová tepová frekvence, kardio zotavení a kardio zátěž se mění ve vámi zvoleném rozsahu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequenza cardiaca a riposo, recupero cardiaco e carico cardio, con tendenza nell'intervallo selezionato."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyugalmi pulzusszám, a szívizom helyreállítása és a kardió terhelés trendje az Ön által választott tartományban."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Frecvența cardiacă în repaus, Recuperarea Cardio și încărcarea cardio, au avut tendințe în intervalul pe care îl alegeți."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι καρδιακοί παλμοί ηρεμίας, η αποκατάσταση καρδιαγγειακής άσκησης και η φόρτιση καρδιαγγειακής άσκησης παρουσιάζουν τάση στο εύρος που επιλέγετε."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tętno spoczynkowe, regeneracja układu krążenia i obciążenie kardio kształtowały się w wybranym zakresie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokojová srdcová frekvencia, kardio zotavenie a kardio záťaž sú trendované v rozsahu, ktorý si vyberiete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilopuls, kardioåterhämtning och konditionsbelastning, trendmässigt över det intervall du väljer."
          }
        }
      }
    },
