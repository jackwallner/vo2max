    "Your more recent Apple Health estimates are meaningfully higher than the earlier part of the 90-day window.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your more recent Apple Health estimates are meaningfully higher than the earlier part of the 90-day window."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine neueren Apple Health-Schätzungen liegen deutlich über dem früheren Teil des 90-Tage-Fensters."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos estimations Apple Health les plus récentes sont nettement plus élevées que la première partie de la fenêtre de 90 jours."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je recentere Apple Health-schattingen zijn aanzienlijk hoger dan het eerste deel van de periode van 90 dagen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您最近的 Apple Health 估計值明顯高於 90 天視窗的早期部分。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши недавние оценки Apple Health значительно выше, чем в более ранней части 90-дневного окна."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعد تقديرات Apple Health الأحدث أعلى بكثير من الجزء السابق من نافذة الـ 90 يومًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus estimaciones Apple Health más recientes son significativamente más altas que las de la primera parte del período de 90 días."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の Apple Health 推定値は、90 日間の期間の前半よりも大幅に高くなっています。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การประมาณการ Apple Health ล่าสุดของคุณสูงกว่าช่วงก่อนหน้าของกรอบเวลา 90 วันอย่างมาก"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše novější odhady Apple Health jsou podstatně vyšší než dřívější část 90denního okna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue stime Apple Health più recenti sono significativamente più elevate rispetto alla parte precedente della finestra di 90 giorni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Ön újabb Apple Health becslései értelemszerűen magasabbak, mint a 90 napos ablak korábbi része."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimările dvs. mai recente Apple Health sunt semnificativ mai mari decât partea anterioară a ferestrei de 90 de zile."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πιο πρόσφατες εκτιμήσεις σας για το Apple Health είναι σημαντικά υψηλότερες από το προηγούμενο τμήμα του παραθύρου των 90 ημερών."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje nowsze szacunki Apple Health są znacznie wyższe niż wcześniejsza część 90-dniowego okna."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše novšie odhady Apple Health sú podstatne vyššie ako v predchádzajúcej časti 90-dňového okna."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina senaste Apple Health uppskattningar är betydligt högre än den tidigare delen av 90-dagarsfönstret."
          }
        }
      }
    },
