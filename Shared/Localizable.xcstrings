        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. شراء لمرة واحدة. الوصول مدى الحياة، لا الاشتراك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Compra única. Acceso de por vida, sin suscripción."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。 1回限りの購入。永久アクセス、サブスクリプションなし。"
