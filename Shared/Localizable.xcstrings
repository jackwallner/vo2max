        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Jednorazowy zakup. Dostęp dożywotni, bez subskrypcji."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
