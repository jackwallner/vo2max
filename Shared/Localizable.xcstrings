    "This app reads these estimates and keeps a local display cache. To change or remove source health data, use Apple Health.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app reads these estimates and keeps a local display cache. To change or remove source health data, use Apple Health."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App liest diese Schätzungen und speichert einen lokalen Anzeigecache. Um Quellzustandsdaten zu ändern oder zu entfernen, verwenden du Apple Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette application lit ces estimations et conserve un cache d'affichage local. Pour modifier ou supprimer les données d’intégrité sources, utilisez Apple Health."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze app leest deze schattingen en houdt een lokale weergavecache bij. Gebruik Apple Health om brongezondheidsgegevens te wijzigen of te verwijderen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該應用程式讀取這些估計值並保留本地顯示器快取。若要變更或刪除來源運行狀況數據，請使用 Apple Health。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложение считывает эти оценки и сохраняет локальный кэш дисплея. Чтобы изменить или удалить исходные данные о работоспособности, используйте Apple Health."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ هذا التطبيق هذه التقديرات ويحتفظ بذاكرة تخزين مؤقت للعرض المحلي. لتغيير أو إزالة البيانات الصحية المصدر، استخدم Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta aplicación lee estas estimaciones y mantiene un caché de visualización local. Para cambiar o eliminar datos de salud de origen, usa Apple Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリはこれらの推定値を読み取り、ローカルの表示キャッシュを保持します。ソース健康データを変更または削除するには、Apple Health を使用します。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปนี้จะอ่านค่าประมาณเหล่านี้และเก็บแคชที่แสดงผลในเครื่อง หากต้องการเปลี่ยนหรือลบข้อมูลสถานภาพแหล่งที่มา ให้ใช้ Apple Health"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato aplikace čte tyto odhady a uchovává místní mezipaměť zobrazení. Chcete-li změnit nebo odebrat zdrojová zdravotní data, použijte Apple Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app legge queste stime e mantiene una cache di visualizzazione locale. Per modificare o rimuovere i dati sanitari di origine, utilizzare Apple Health."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az alkalmazás beolvassa ezeket a becsléseket, és megtartja a helyi kijelző gyorsítótárát. A forrás állapotadatok módosításához vagy eltávolításához használja a Apple Health parancsot."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această aplicație citește aceste estimări și păstrează un cache de afișare local. Pentru a modifica sau elimina datele de sănătate sursă, utilizați Apple Health."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η εφαρμογή διαβάζει αυτές τις εκτιμήσεις και διατηρεί μια τοπική προσωρινή μνήμη εμφάνισης. Για να αλλάξετε ή να καταργήσετε δεδομένα υγείας προέλευσης, χρησιμοποιήστε το Apple Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta aplikacja odczytuje te szacunki i przechowuje lokalną pamięć podręczną wyświetlacza. Aby zmienić lub usunąć źródłowe dane o kondycji, użyj Apple Health."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto aplikácia číta tieto odhady a uchováva miestnu vyrovnávaciu pamäť displeja. Ak chcete zmeniť alebo odstrániť zdrojové zdravotné údaje, použite Apple Health."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här appen läser dessa uppskattningar och håller en lokal visningscache. Använd Apple Health för att ändra eller ta bort källhälsodata."
          }
        }
      }
    },
