    "This app reads these estimates and keeps a local display cache. To change or remove source health data, use Apple Health.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app reads these estimates and keeps a local display cache. To change or remove source health data, use Apple Health."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App liest die Schätzwerte und speichert eine lokale Kopie zur Anzeige. Gesundheitsdaten kannst du in Apple Health ändern oder löschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app lit ces estimations et en conserve une copie locale pour les afficher. Pour modifier ou supprimer des données de santé, utilisez Apple Health."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze app leest de schattingen en bewaart lokaal een kopie voor weergave. Je kunt gezondheidsgegevens wijzigen of verwijderen in Apple Health."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 會讀取估算值，並在裝置上保留顯示用的快取。請在 Apple Health 中修改或刪除健康資料。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение считывает оценки и сохраняет их копию на устройстве. Чтобы изменить или удалить данные о здоровье, используйте Apple Health."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ التطبيق هذه التقديرات ويحفظ نسخة محلية للعرض. لتعديل بياناتك الصحية الأصلية أو حذفها، استخدم Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app lee estas estimaciones y guarda una copia local para mostrarlas. Para cambiar o borrar los datos de salud originales, usa Apple Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリは推定値を読み取り、表示用のデータをデバイス内に保存します。元の健康データを変更または削除するには、Apple Healthを使用してください。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปนี้อ่านค่าประมาณและเก็บสำเนาสำหรับแสดงผลไว้ในอุปกรณ์ หากต้องการแก้ไขหรือลบข้อมูลสุขภาพต้นฉบับ ให้ใช้ Apple Health"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace tyto odhady čte a ukládá jejich kopii pro zobrazení v zařízení. Zdrojová zdravotní data můžete změnit nebo smazat v Apple Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app legge queste stime e ne conserva una copia locale per mostrarle. Per modificare o eliminare i dati sanitari originali, usa Apple Health."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az app beolvassa ezeket a becsléseket, és helyi másolatot tárol a megjelenítéshez. Az eredeti egészségügyi adatokat az Apple Healthben módosíthatod vagy törölheted."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația citește estimările și păstrează o copie locală pentru afișare. Pentru a modifica sau șterge datele de sănătate originale, folosește Apple Health."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή διαβάζει αυτές τις εκτιμήσεις και κρατά τοπικό αντίγραφο για προβολή. Για να αλλάξεις ή να αφαιρέσεις τα αρχικά δεδομένα υγείας, χρησιμοποίησε το Apple Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja odczytuje te oszacowania i przechowuje lokalną kopię do wyświetlania. Aby zmienić lub usunąć źródłowe dane zdrowotne, użyj Apple Health."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácia číta tieto odhady a uchováva ich miestnu kópiu na zobrazenie. Zdrojové zdravotné údaje môžeš upraviť alebo odstrániť v Apple Health."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen läser uppskattningarna och sparar en lokal kopia för visning. Ändra eller ta bort hälsodata i Apple Health."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה קוראת את האומדנים ושומרת עותק מקומי להצגה. לשינוי או למחיקה של נתוני הבריאות המקוריים, יש להשתמש ב-Apple Health."
          }
        }
      }
    },
    "This comparison needs at least %lld stretches between estimates, with a few in each group. Keep recording workouts and it will fill in as Apple Health logs more estimates.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@n@"
          },
          "substitutions": {
            "n": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "This comparison needs at least %arg stretch between estimate, with a few in each group. Keep recording workouts and it will fill in as Apple Health logs more estimate."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "This comparison needs at least %arg stretches between estimates, with a few in each group. Keep recording workouts and it will fill in as Apple Health logs more estimates."
                    }
                  }
                }
              }
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@n@"
          },
          "substitutions": {
            "n": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Für diesen Vergleich brauchst du mindestens %arg Zeitabschnitt zwischen den Schätzwerten und einige Schätzungen pro Gruppe. Zeichne weiter Trainings auf, bis Apple Health weitere Schätzwerte erfasst."
                    }
                  },
                  "other": {
