    "Fitness age needs your age, reference profile, and at least one Apple Health estimate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitness age needs your age, reference profile, and at least one Apple Health estimate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Fitnessalter-Schätzung brauchst du dein Alter, ein Referenzprofil und mindestens eine Apple Health-Schätzung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’estimation de l’âge de forme nécessite votre âge, un profil de référence et au moins une estimation Apple Health."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor de fitnessleeftijd zijn je leeftijd, een referentieprofiel en minstens één Apple Health-schatting nodig."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "估算體適能年齡需要你的年齡、參考資料，以及至少一筆 Apple Health 估計值。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для оценки фитнес-возраста нужны ваш возраст, профиль для сравнения и хотя бы одна оценка из Apple Health."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب تقدير العمر اللياقي عمرك وملفًا مرجعيًا وتقديرًا واحدًا على الأقل من Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para estimar la edad física, se necesitan tu edad, un perfil de referencia y al menos una estimación de Apple Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィットネス年齢の推定には、年齢と参考プロフィールに加えて、Apple Healthの推定値が少なくとも1件必要です。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การประมาณอายุความฟิตต้องใช้ข้อมูลอายุ โปรไฟล์อ้างอิง และค่าประมาณจาก Apple Health อย่างน้อยหนึ่งรายการ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K odhadu kondičního věku potřebujete svůj věk, referenční profil a alespoň jeden odhad z Apple Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per stimare l’età fitness servono la tua età, un profilo di riferimento e almeno una stima di Apple Health."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fitneszkor becsléséhez szükség van az életkorodra, egy referenciaprofilra és legalább egy Apple Health-becslésre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru estimarea vârstei de fitness sunt necesare vârsta ta, un profil de referință și cel puțin o estimare Apple Health."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για την εκτίμηση της ηλικίας φυσικής κατάστασης χρειάζονται η ηλικία σου, ένα προφίλ αναφοράς και τουλάχιστον μία εκτίμηση από το Apple Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do oszacowania wieku sprawnościowego potrzebujesz swojego wieku, profilu referencyjnego i co najmniej jednego oszacowania z Apple Health."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na odhad kondičného veku potrebujete svoj vek, referenčný profil a aspoň jeden odhad z Apple Health."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att uppskatta konditionsålder behövs din ålder, en referensprofil och minst en uppskattning från Apple Health."
          }
        }
      }
    },
