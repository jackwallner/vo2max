    "Fitness age needs your age, reference profile, and at least one Apple Health estimate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitness age needs your age, reference profile, and at least one Apple Health estimate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Fitnessalter-Schätzung brauchst du dein Alter, ein Referenzprofil und mindestens einen Apple Health-Schätzwert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’estimation de l’âge de forme nécessite votre âge, un profil de référence et au moins une estimation Apple Health."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor je fitnessleeftijd zijn je leeftijd, een referentieprofiel en minstens één Apple Health-schatting nodig."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "估算體適能年齡需要你的年齡、參考個人檔案，以及至少一筆 Apple Health 估算值。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для оценки фитнес-возраста нужны ваш возраст, профиль для сравнения и хотя бы одна оценка из Apple Health."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب تقدير العمر اللياقي عمرك وملفك المرجعي وتقديرًا واحدًا على الأقل من Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para estimar tu edad física se necesitan tu edad, un perfil de referencia y al menos una estimación de Apple Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィットネス年齢の推定には、年齢、参照プロフィール、Apple Healthの推定値が少なくとも1件必要です。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การประเมินอายุฟิตเนสต้องมีอายุ โปรไฟล์อ้างอิง และค่าประมาณจาก Apple Health อย่างน้อยหนึ่งรายการ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K odhadu kondičního věku je potřeba zadat věk a referenční profil a mít alespoň jeden odhad z Apple Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per stimare l’età fitness servono la tua età, un profilo di riferimento e almeno una stima di Apple Health."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fitneszkor becsléséhez add meg az életkorodat, válassz referenciaprofilt, és legyen legalább egy Apple Health-becslésed."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a estima vârsta de fitness, ai nevoie de vârsta ta, de un profil de referință și de cel puțin o estimare Apple Health."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για την εκτίμηση της ηλικίας φυσικής κατάστασης χρειάζεσαι την ηλικία σου, ένα προφίλ αναφοράς και τουλάχιστον μία εκτίμηση Apple Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do oszacowania wieku kondycyjnego potrzebujesz swojego wieku, profilu odniesienia i co najmniej jednego oszacowania Apple Health."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na odhad kondičného veku potrebuješ svoj vek, referenčný profil a aspoň jeden odhad Apple Health."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att uppskatta konditionsålder behöver du ange din ålder, välja en referensprofil och ha minst en Apple Health-uppskattning."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחישוב גיל הכושר נדרשים גיל, פרופיל ייחוס ולפחות אומדן אחד מ-Apple Health."
          }
        }
      }
    },
