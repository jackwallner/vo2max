    "An outdoor walk, run, or hike recorded with Apple Watch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An outdoor walk, run, or hike recorded with Apple Watch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein mit der Apple Watch aufgezeichneter Spaziergang, Lauf oder eine Wanderung im Freien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une marche, une course ou une randonnée en plein air enregistrée avec l’Apple Watch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een wandeling, hardloopsessie of hike in de buitenlucht, geregistreerd met Apple Watch."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple Watch 記錄的戶外步行、跑步或健行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогулка, пробежка или поход на свежем воздухе, записанные с помощью Apple Watch."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مشي أو جري أو نزهة خارجية مسجلة باستخدام Apple Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una caminata, carrera o ruta de senderismo al aire libre registrada con el Apple Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watchで記録した屋外のウォーキング、ランニング、ハイキング。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเดิน วิ่ง หรือเดินป่ากลางแจ้งที่บันทึกด้วย Apple Watch"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Venkovní procházka, běh nebo túra zaznamenaná pomocí Apple Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una passeggiata, una corsa o un'escursione all'aperto registrata con Apple Watch."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch-csal rögzített szabadtéri séta, futás vagy túrázás."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O plimbare, alergare sau drumeție în aer liber înregistrată cu Apple Watch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπαίθρια προπόνηση καταγεγραμμένη με Apple Watch: περπάτημα, τρέξιμο ή πεζοπορία."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spacer, bieg lub wędrówka na świeżym powietrzu zarejestrowane przez Apple Watch."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prechádzka, beh alebo turistika vonku zaznamenaná pomocou Apple Watch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En promenad, löprunda eller vandring utomhus som registrerats med Apple Watch."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הליכה, ריצה או טיול בחוץ שתועדו באמצעות Apple Watch."
          }
        }
      }
    },
    "Anchored to age %lld: typical cardio fitness for your profile is %lld-%lld mL/kg/min. Fine-tune it if you like.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anchored to age %1$lld: typical cardio fitness for your profile is %2$lld-%3$lld mL/kg/min. Fine-tune it if you like."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An deinem Alter (%1$lld) orientiert, liegt die typische Cardiofitness für dein Profil bei %2$lld–%3$lld mL/kg/min. Passe den Bereich nach Wunsch an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fonction de votre âge (%1$lld), la plage habituelle de forme cardio pour votre profil est de %2$lld à %3$lld mL/kg/min. Vous pouvez l’ajuster."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afgestemd op je leeftijd (%1$lld): de gebruikelijke cardiofitness voor jouw profiel ligt tussen %2$lld en %3$lld mL/kg/min. Pas dit gerust aan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依照你的年齡（%1$lld 歲），符合你個人資料的典型心肺適能範圍為 %2$lld–%3$lld mL/kg/min。你也可以自行微調。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С учётом вашего возраста (%1$lld) типичный уровень кардиовыносливости для вашего профиля составляет %2$lld–%3$lld mL/kg/min. При желании настройте диапазон."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استنادًا إلى عمرك (%1$lld)، يتراوح مستوى اللياقة القلبية المعتاد لملفك بين %2$lld و%3$lld mL/kg/min. يمكنك تعديله كما تشاء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Según tu edad (%1$lld), el rango habitual de capacidad aeróbica para tu perfil es de %2$lld a %3$lld mL/kg/min. Puedes ajustarlo si quieres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年齢（%1$lld歳）をもとにした、あなたのプロフィールにおける心肺機能の一般的な範囲は%2$lld～%3$lld mL/kg/minです。必要に応じて調整できます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ้างอิงจากอายุ %1$lld ปี สมรรถภาพหัวใจและหลอดเลือดโดยทั่วไปสำหรับโปรไฟล์ของคุณอยู่ที่ %2$lld–%3$lld mL/kg/min คุณปรับช่วงนี้ได้ตามต้องการ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podle věku (%1$lld) je obvyklý rozsah kardiorespirační kondice pro tvůj profil %2$lld–%3$lld mL/kg/min. Můžeš si ho upravit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In base alla tua età (%1$lld), il livello tipico di fitness cardiovascolare per il tuo profilo va da %2$lld a %3$lld mL/kg/min. Puoi modificarlo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בהתאם לגילך (%1$lld), טווח הכושר האירובי המקובל לפרופיל שלך הוא %2$lld–%3$lld mL/kg/min. אפשר לכוונן אותו כרצונך."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A korod (%1$lld) alapján a profilodhoz tartozó szokásos kardiofitnesz-tartomány %2$lld–%3$lld mL/kg/min. Igény szerint módosíthatod."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În funcție de vârsta ta (%1$lld), intervalul obișnuit de fitness cardiovascular pentru profilul tău este de %2$lld–%3$lld mL/kg/min. Îl poți ajusta."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με βάση την ηλικία σου (%1$lld), το συνηθισμένο εύρος καρδιοαναπνευστικής φυσικής κατάστασης για το προφίλ σου είναι %2$lld–%3$lld mL/kg/min. Μπορείς να το προσαρμόσεις."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W zależności od wieku (%1$lld) typowy zakres kondycji kardio dla Twojego profilu wynosi %2$lld–%3$lld mL/kg/min. Możesz go dostosować."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podľa veku (%1$lld) je obvyklý rozsah kardiorespiračnej kondície pre tvoj profil %2$lld–%3$lld mL/kg/min. Môžeš si ho upraviť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utifrån din ålder (%1$lld) är det typiska konditionsintervallet för din profil %2$lld–%3$lld mL/kg/min. Du kan justera det om du vill."
          }
        }
      }
    },
