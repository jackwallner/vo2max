    "Your more recent Apple Health estimates are meaningfully higher than the earlier part of the 90-day window.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your more recent Apple Health estimates are meaningfully higher than the earlier part of the 90-day window."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine neueren Apple Health-Schätzwerte liegen deutlich über den Werten aus dem früheren Teil des 90-Tage-Zeitraums."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos estimations Apple Health les plus récentes sont nettement supérieures à celles de la première partie de la période de 90 jours."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je recentere Apple Health-schattingen liggen duidelijk hoger dan die uit de eerste helft van de periode van 90 dagen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "近期 Apple Health 估算值明顯高於前 90 天期間的早期數值。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последние оценки Apple Health заметно выше, чем в первой части 90-дневного периода."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقديرات Apple Health الأحدث أعلى بوضوح من تقديرات بداية فترة التسعين يومًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus estimaciones más recientes de Apple Health son claramente más altas que las de la primera parte del período de 90 días."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近のApple Health推定値は、90日間の前半と比べて明らかに高くなっています。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าประมาณล่าสุดจาก Apple Health สูงกว่าช่วงต้นของระยะเวลา 90 วันอย่างชัดเจน"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Novější odhady z Apple Health jsou výrazně vyšší než odhady z první části posledního 90denního období."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stime più recenti di Apple Health sono nettamente più alte rispetto alla prima parte del periodo di 90 giorni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legutóbbi Apple Health-becsléseid számottevően magasabbak, mint a 90 napos időszak korábbi részében."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimările Apple Health recente sunt semnificativ mai mari decât cele din prima parte a perioadei de 90 de zile."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πιο πρόσφατες εκτιμήσεις Apple Health είναι αισθητά υψηλότερες από εκείνες του πρώτου μέρους της περιόδου 90 ημερών."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowsze oszacowania Apple Health są wyraźnie wyższe niż te z wcześniejszej części okresu 90 dni."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedávne odhady Apple Health sú výrazne vyššie ako odhady z prvej časti 90-dňového obdobia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De senaste Apple Health-uppskattningarna är tydligt högre än värdena från den tidigare delen av 90-dagarsperioden."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אומדני Apple Health האחרונים גבוהים במידה ניכרת מהאומדנים בחלק הראשון של תקופת 90 הימים."
          }
        }
      }
    },
