    "A notification each time Apple Health logs a new VO2 max estimate, with context.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A notification each time Apple Health logs a new VO2 max estimate, with context."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Benachrichtigung jedes Mal, wenn Apple Health eine neue VO2-max-Schätzwert mit Kontext protokolliert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une notification à chaque fois que Apple Health enregistre une nouvelle estimation VO2 max, avec contexte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een melding telkens wanneer Apple Health een nieuwe VO2 max-schatting registreert, met context."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次 Apple Health 記錄新的 VO2 max 估計時都會收到通知，並附帶上下文。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомление каждый раз, когда Apple Health регистрирует новую оценку VO2 max с контекстом."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعار في كل مرة يقوم فيها Apple Health بتسجيل تقدير VO2 max جديد، مع السياق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notificación cada vez que Apple Health registra una nueva estimación VO2 max, con contexto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health が新しい VO2 max 推定をログに記録するたびに、コンテキスト付きの通知が送信されます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนแต่ละครั้ง Apple Health บันทึกการประมาณการ VO2 max ใหม่พร้อมบริบท"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení pokaždé, když Apple Health zaprotokoluje nový odhad VO2 max s kontextem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notifica ogni volta che Apple Health registra una nuova stima VO2 max, con contesto."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értesítés minden alkalommal, amikor a Apple Health új VO2 max becslést naplóz kontextussal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O notificare de fiecare dată când Apple Health înregistrează o nouă estimare VO2 max, cu context."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια ειδοποίηση κάθε φορά που το Apple Health καταγράφει μια νέα εκτίμηση VO2 max, με περιεχόμενο."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienie za każdym razem, gdy Apple Health rejestruje nowe oszacowanie VO2 max wraz z kontekstem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornenie zakaždým, keď Apple Health zaznamená nový odhad VO2 max s kontextom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett meddelande varje gång Apple Health loggar en ny VO2 max uppskattning, med sammanhang."
          }
        }
      }
    },
    "A nudge when Apple Health hasn't logged an estimate in a while, and what refreshes it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A nudge when Apple Health hasn't logged an estimate in a while, and what refreshes it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Hinweis, wenn Apple Health länger keine Schätzung erfasst hat, und was eine neue Schätzung auslöst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel si Apple Health n’a pas enregistré d’estimation depuis un moment, et les activités qui en déclenchent une nouvelle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een herinnering als Apple Health al een tijd geen schatting heeft vastgelegd, en wat een nieuwe schatting oplevert."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 Apple Health 有一段時間沒有記錄估算值時提醒你，並說明哪些活動會帶來新的估算。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминание, если Apple Health давно не записывал оценку, и сведения о том, что помогает получить новую."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكير إذا لم يسجل Apple Health تقديرًا منذ فترة، مع توضيح الأنشطة التي تساعد على تسجيل تقدير جديد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio si Apple Health lleva un tiempo sin registrar una estimación y qué actividades pueden generar otra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Healthでしばらく推定値が記録されていないときにお知らせし、新しい推定値につながる運動も確認できます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เตือนเมื่อ Apple Health ไม่ได้บันทึกค่าประมาณมาระยะหนึ่ง พร้อมบอกว่ากิจกรรมใดช่วยให้มีค่าประมาณใหม่"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornění, když Apple Health delší dobu nezaznamená odhad, a informace o tom, jaké aktivity vedou k novému odhadu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria se Apple Health non registra una stima da un po’ e le attività che possono generarne una nuova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Emlékeztető, ha az Apple Health egy ideje nem rögzített becslést, és tájékoztató arról, mely tevékenységek eredményezhetnek újat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un memento când Apple Health nu a înregistrat o estimare de ceva timp și informații despre activitățile care pot genera una nouă."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπενθύμιση όταν το Apple Health δεν έχει καταγράψει εκτίμηση εδώ και καιρό και πληροφορίες για τις δραστηριότητες που μπορούν να δώσουν νέα εκτίμηση."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienie, gdy Apple Health od dłuższego czasu nie zapisuje oceny, oraz informacje o aktywnościach, które mogą przynieść nową."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornenie, keď Apple Health dlhšie nezaznamenalo odhad, a informácie o aktivitách, ktoré môžu priniesť nový odhad."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En påminnelse när Apple Health inte har registrerat någon uppskattning på ett tag och information om vad som kan ge en ny."
          }
        }
      }
    },
    "A personal fitness target, not a medical threshold. It drives the Today ring and target lines in Trends.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A personal fitness target, not a medical threshold. It drives the Today ring and target lines in Trends."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein persönliches Fitnessziel, keine medizinische Schwelle. Es steuert die Today-Ring- und Target-Linien in Trends."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un objectif de forme physique personnel, pas un seuil médical. Il pilote l'anneau Aujourd'hui et les lignes cibles dans les tendances."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een persoonlijk fitnessdoel, geen medische drempel. Het stuurt de Today-ring en doellijnen in Trends aan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "個人健身目標，而不是醫療閾值。它驅動著今天的環線和趨勢中的目標線。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Личная фитнес-цель, а не медицинский порог. Он управляет кольцом Today и целевыми линиями в Trends."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هدف اللياقة الشخصية، وليس عتبة طبية. إنه يقود حلقة اليوم وخطوط الهدف في الاتجاهات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un objetivo de fitness personal, no un umbral médico. Impulsa el anillo Hoy y las líneas objetivo en Tendencias."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医学的な基準ではなく、個人のフィットネス目標です。それはトレンドの今日のリングとターゲットラインを動かします。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป้าหมายการออกกำลังกายส่วนบุคคล ไม่ใช่เกณฑ์ทางการแพทย์ มันขับเคลื่อนวงแหวนวันนี้และเส้นเป้าหมายในเทรนด์"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Osobní fitness cíl, ne lékařský práh. Pohání kruh Dnes a cílové řady v Trendech."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un obiettivo di fitness personale, non una soglia medica. Guida l'anello Oggi e le linee target in Trends."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Személyes fitneszcél, nem orvosi küszöb. Ez vezeti a mai gyűrűt és a Trends célvonalait."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O țintă personală de fitness, nu un prag medical. Acesta conduce inelul și liniile țintă de astăzi în Trends."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας προσωπικός στόχος φυσικής κατάστασης, όχι ένα ιατρικό όριο. Οδηγεί τις γραμμές Today ring και στόχου στο Trends."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osobisty cel fitness, a nie próg medyczny. Kieruje pierścieniem Dzisiaj i liniami docelowymi w Trendach."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cieľ osobnej kondície, nie zdravotný prah. Poháňa kruh Dnes a cieľové línie v Trendoch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett personligt träningsmål, inte en medicinsk tröskel. Den driver dagens ring- och mållinjer i Trender."
          }
        }
      }
    },
