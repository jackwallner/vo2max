    "Start date must be before end date.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start date must be before end date."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Startdatum muss vor dem Enddatum liegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date de début doit précéder la date de fin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De begindatum moet vóór de einddatum liggen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始日期必須早於結束日期。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата начала должна предшествовать дате окончания."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يسبق تاريخ البداية تاريخ النهاية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha de inicio debe ser anterior a la fecha de fin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始日は終了日より前に設定してください。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่เริ่มต้นต้องมาก่อนวันที่สิ้นสุด"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počáteční datum musí předcházet koncovému."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La data di inizio deve precedere quella di fine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kezdő dátumnak meg kell előznie a záró dátumot."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Data de început trebuie să fie înaintea datei de sfârșit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ημερομηνία έναρξης πρέπει να προηγείται της ημερομηνίας λήξης."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Data początkowa musi poprzedzać datę końcową."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dátum začiatku musí byť pred dátumom konca."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Startdatumet måste vara före slutdatumet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תאריך ההתחלה חייב להיות לפני תאריך הסיום."
          }
        }
      }
    },
