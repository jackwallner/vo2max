    "Every cached Apple Health estimate, shown read-only.%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every cached Apple Health estimate, shown read-only.%1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder zwischengespeicherte Apple Health-Schätzwert, nur lesbar. %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque estimation Apple Health mise en cache, affichée en lecture seule. %1$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke Apple Health-schatting uit de cache, alleen-lezen weergegeven. %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "唯讀顯示所有已快取的 Apple Health 估算值。%1$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все сохранённые оценки Apple Health доступны только для чтения. %1$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل تقديرات Apple Health المحفوظة معروضة للقراءة فقط. %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las estimaciones guardadas de Apple Health se muestran en modo de solo lectura. %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのApple Health推定値をすべて読み取り専用で表示します。%1$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงค่าประมาณจาก Apple Health ที่บันทึกไว้ทั้งหมดแบบอ่านอย่างเดียว %1$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny odhady z Apple Health v místní mezipaměti, pouze ke čtení. %1$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le stime di Apple Health salvate sul dispositivo, in sola lettura. %1$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszközön tárolt összes Apple Health-becslés, csak olvasható formában. %1$@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate estimările Apple Health păstrate pe dispozitiv, doar pentru citire. %1$@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλες οι εκτιμήσεις Apple Health που είναι αποθηκευμένες στη συσκευή, μόνο για ανάγνωση. %1$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie oszacowania Apple Health zapisane na urządzeniu, tylko do odczytu. %1$@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky odhady Apple Health uložené v zariadení, iba na čítanie. %1$@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla Apple Health-uppskattningar som sparats på enheten, endast för läsning. %1$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל אומדני Apple Health שנשמרו במטמון, לצפייה בלבד. %1$@"
          }
        }
      }
    },
    "Every screen below is unlocked, and reads the range you pick.": {
