    "Walks, runs, hikes, rides, swims, rows, elliptical, and interval sessions recorded in Apple Health all count here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walks, runs, hikes, rides, swims, rows, elliptical, and interval sessions recorded in Apple Health all count here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaziergänge, Läufe, Wanderungen, Fahrten, Schwimm-, Ruder-, Crosstrainer- und Intervalleinheiten, die in Apple Health aufgezeichnet wurden, zählen hier alle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les marches, courses, randonnées, balades, natations, rameurs, séances elliptiques et fractionnées enregistrées dans Apple Health comptent toutes ici."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandelingen, hardloopsessies, trektochten, ritten, zwemsessies, roeisessies, elliptische trainers en intervalsessies opgenomen in Apple Health tellen hier allemaal mee."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 中記錄的步行、跑步、遠足、騎行、游泳、划船、橢圓機和間歇訓練均計入此處。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь учитываются прогулки, пробежки, походы, поездки, плавание, гребля, занятия на эллиптическом тренажере и интервальные занятия, записанные в Apple Health."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم احتساب جلسات المشي، والجري، والمشي لمسافات طويلة، وركوب الخيل، والسباحة، والتجديف، والتمارين البيضاوية، والجلسات الفاصلة المسجلة في Apple Health هنا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las caminatas, carreras, caminatas, paseos en bicicleta, natación, remo, elíptica y sesiones de intervalos registradas en Apple Health cuentan aquí."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health に記録されたウォーキング、ランニング、ハイキング、ライド、スイム、ローイング、エリプティカル、インターバル セッションはすべてここでカウントされます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเดิน การวิ่ง การเดินป่า การขี่รถ ว่ายน้ำ แถว เครื่องเดินวงรี และเซสชันแบบเป็นช่วง ๆ ที่บันทึกไว้ใน Apple Health ทั้งหมดนี้นับรวมที่นี่"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde se počítají procházky, běhy, túry, vyjížďky, plavání, veslování, eliptické a intervalové relace zaznamenané v Apple Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sessioni di camminata, corsa, escursione, corsa, nuoto, remata, ellittica e a intervalli registrate in Apple Health contano tutte qui."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Health-ban rögzített séták, futások, túrák, lovaglások, úszások, sorozások, elliptikus és intervallum edzések mind számítanak itt."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plimbările, alergările, drumețiile, plimbările, înotul, rândurile, sesiunile eliptice și sesiunile pe intervale înregistrate în Apple Health toate sunt luate în considerare aici."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βόλτες, τρεξίματα, πεζοπορίες, βόλτες, κολύμπι, σειρές, ελλειπτικές και διαλειμματικές συνεδρίες που καταγράφονται στο Apple Health μετρούν όλα εδώ."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczą się tutaj spacery, biegi, wędrówki, przejażdżki, pływanie, wiosłowania, treningi na orbitreku i sesje interwałowe zarejestrowane w Apple Health."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sa počítajú prechádzky, beh, túry, jazdy, plávanie, veslovanie, eliptické a intervalové cvičenia zaznamenané v Apple Health."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Promenader, löpturer, vandringar, åkturer, simningar, roddturer, elliptiska och intervallpass som registrerats i Apple Health räknas här."
          }
        }
      }
    },
