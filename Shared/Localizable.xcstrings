          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mehr als deine letzte Schätzung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En hausse de %1$@ par rapport à votre dernière estimation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hoger dan je laatste schatting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比您上次的估計上漲 %1$@。"
