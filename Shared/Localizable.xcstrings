    "Get a notification the moment Apple Health logs a new VO2 max estimate, with how it compares.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a notification the moment Apple Health logs a new VO2 max estimate, with how it compares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte sofort eine Mitteilung, wenn Apple Health eine neue VO2max-Schätzung erfasst, samt Vergleich zum vorherigen Wert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez une notification dès qu’Apple Health enregistre une nouvelle estimation de VO2 max, avec une comparaison à la précédente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontvang een melding zodra Apple Health een nieuwe VO2 max-schatting registreert, met een vergelijking met de vorige."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 記錄新的 VO2 max 估算值時立即收到通知，並查看與先前估算值的比較。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получайте уведомление, как только Apple Health запишет новую оценку VO2 max, с её сравнением с предыдущей."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلقَّ إشعارًا فور تسجيل Apple Health تقديرًا جديدًا لـ VO2 max، مع مقارنة بالتقدير السابق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe una notificación en cuanto Apple Health registre una nueva estimación de VO2 max, con una comparación con la anterior."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Healthに新しいVO2 maxの推定値が記録されると、前回との比較とともにすぐ通知します。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับการแจ้งเตือนทันทีที่ Apple Health บันทึกค่าประมาณ VO2 max ใหม่ พร้อมข้อมูลเปรียบเทียบกับครั้งก่อน"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostaneš oznámení hned, jak Apple Health zaznamená nový odhad VO2 max, včetně porovnání s předchozím."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi una notifica appena Apple Health registra una nuova stima del VO2 max, con il confronto con quella precedente."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבל התראה ברגע ש-Apple Health מתעדת הערכת VO2 max חדשה, יחד עם השוואה לקודמת."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azonnal értesítést kapsz, amikor az Apple Health új VO2 max-becslést rögzít, az előzővel való összehasonlítással."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Primești o notificare imediat ce Apple Health înregistrează o estimare VO2 max nouă, împreună cu o comparație cu cea anterioară."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λάβε ειδοποίηση μόλις το Apple Health καταγράψει νέα εκτίμηση VO2 max, μαζί με σύγκριση με την προηγούμενη."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymuj powiadomienie, gdy tylko Apple Health zapisze nowe oszacowanie VO2 max, wraz z porównaniem z poprzednim."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostaneš upozornenie hneď, ako Apple Health zaznamená nový odhad VO2 max, aj s porovnaním s predchádzajúcim."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Få en notis direkt när Apple Health registrerar en ny VO2 max-uppskattning, med en jämförelse med den förra."
          }
        }
      }
    },
