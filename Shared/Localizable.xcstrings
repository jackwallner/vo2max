    "Restore failed. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore failed. Please try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellung fehlgeschlagen. Bitte versuchen du es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration a échoué. Veuillez réessayer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstellen mislukt. Probeer het opnieuw."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復失敗。請再試一次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление не удалось. Пожалуйста, попробуйте еще раз."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشلت عملية الاستعادة. يرجى المحاولة مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauración falló. Por favor inténtalo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元に失敗しました。もう一度試してください。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การคืนค่าล้มเหลว โปรดลองอีกครั้ง"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovení se nezdařilo. Zkuste to prosím znovu."
          }
        },
        "it": {
