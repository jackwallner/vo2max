            "value": "Nenastaveno"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non impostato"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs beállítva"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Neconfigurat"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχει οριστεί"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ustawiono"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenastavené"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte inställt"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הוגדר"
          }
        }
      }
    },
    "Nothing recorded between %@. Choose a longer window, or return after Apple Health records another cardio fitness estimate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing recorded between %1$@. Choose a longer window, or return after Apple Health records another cardio fitness estimate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischen %1$@ wurde nichts erfasst. Wähle einen längeren Zeitraum oder schau wieder vorbei, sobald Apple Health einen weiteren Cardiofitness-Schätzwert erfasst hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune donnée enregistrée entre %1$@. Choisissez une période plus longue ou revenez lorsqu’Apple Health aura enregistré une autre estimation de forme cardio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets geregistreerd tussen %1$@. Kies een langere periode of kom terug nadat Apple Health een nieuwe cardiofitnessschatting heeft geregistreerd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 期間沒有紀錄。請選擇較長的期間，或等 Apple Health 記錄新的心肺適能估算值後再查看。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За период между %1$@ нет записей. Выберите более длительный период или вернитесь, когда Apple Health добавит новую оценку кардиовыносливости."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد بيانات بين %1$@. اختر فترة أطول أو عُد بعد تسجيل Apple Health تقديرًا جديدًا للياقة القلبية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay datos entre %1$@. Elige un período más largo o vuelve cuando Apple Health registre otra estimación de capacidad aeróbica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の間に記録はありません。期間を長くするか、Apple Healthに新しい心肺機能の推定値が記録されてから、もう一度確認してください。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีข้อมูลระหว่าง %1$@ เลือกช่วงเวลาที่ยาวขึ้น หรือกลับมาดูหลังจาก Apple Health บันทึกค่าประมาณสมรรถภาพหัวใจและหลอดเลือดใหม่"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V období mezi %1$@ nebylo nic zaznamenáno. Zvolte delší období nebo se vraťte, až Apple Health zaznamená další odhad kardiorespirační kondice."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun dato registrato tra %1$@. Scegli un periodo più lungo o torna dopo che Apple Health avrà registrato un’altra stima del fitness cardiovascolare."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem történt rögzítés ebben az időszakban: %1$@. Válassz hosszabb időszakot, vagy térj vissza, ha az Apple Health új kardiofitnesz-becslést rögzített."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a înregistrat nimic între %1$@. Alege o perioadă mai lungă sau revino după ce Apple Health înregistrează o altă estimare de fitness cardiovascular."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχει καταγραφεί κάτι μεταξύ %1$@. Επίλεξε μεγαλύτερη περίοδο ή επέστρεψε όταν το Apple Health καταγράψει νέα εκτίμηση καρδιοαναπνευστικής φυσικής κατάστασης."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zapisów między %1$@. Wybierz dłuższy okres albo wróć, gdy Apple Health zarejestruje kolejne oszacowanie kondycji kardio."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Medzi dátumami %1$@ nie sú žiadne záznamy. Vyber dlhšie obdobie alebo sa vráť, keď Apple Health zaznamená ďalší odhad kardiorespiračnej kondície."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget registrerades mellan %1$@. Välj en längre period eller kom tillbaka när Apple Health har registrerat en ny konditionsuppskattning."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא תועדו נתונים בין %1$@. אפשר לבחור תקופה ארוכה יותר או לחזור אחרי ש-Apple Health יתעד אומדן כושר אירובי נוסף."
          }
        }
      }
    },
    "Notification extras stay off until you turn them on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification extras stay off until you turn them on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusätzliche Mitteilungen bleiben deaktiviert, bis du sie einschaltest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les options de notification restent désactivées jusqu’à ce que vous les activiez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra meldingsopties blijven uit totdat je ze inschakelt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知功能預設為關閉，開啟後才會收到通知。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнительные уведомления отключены, пока вы их не включите."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظل الإشعارات الإضافية متوقفة حتى تفعّلها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones adicionales están desactivadas hasta que las actives."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加通知は有効にするまでオフです。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนเพิ่มเติมจะปิดอยู่จนกว่าจะเปิดใช้"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Další oznámení zůstanou vypnutá, dokud je nezapnete."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche aggiuntive restano disattivate finché non le attivi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A további értesítések kikapcsolva maradnak, amíg be nem kapcsolod őket."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificările suplimentare rămân oprite până le activezi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πρόσθετες ειδοποιήσεις παραμένουν απενεργοποιημένες μέχρι να τις ενεργοποιήσεις."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatkowe powiadomienia pozostaną wyłączone, dopóki ich nie włączysz."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ďalšie upozornenia zostanú vypnuté, kým ich nezapneš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra notiser är avstängda tills du slår på dem."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדכונים נוספים יישארו כבויים עד להפעלתם."
          }
        }
      }
    },
    "Off. Turn nudges on in Settings to be told when your estimate goes overdue against your own cadence.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off. Turn nudges on in Settings to be told when your estimate goes overdue against your own cadence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus. Aktiviere die Hinweise in den Einstellungen, um zu erfahren, wenn eine neue Schätzung später kommt als für dich üblich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé. Activez les rappels dans Réglages pour être averti lorsque votre prochaine estimation tarde par rapport à votre rythme habituel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uit. Schakel de meldingen in Instellingen in om te horen wanneer je volgende schatting later komt dan voor jou gebruikelijk is."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已關閉。可在「設定」中開啟提醒，當估算值超過你平常的更新間隔時收到通知。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключено. Включите напоминания в «Настройках», чтобы узнать, если новая оценка задержится дольше вашего обычного интервала."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقف. فعّل التنبيهات في «الإعدادات» لتعرف عند تجاوز موعد التقدير المعتاد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado. Activa los avisos en «Configuración» para saber si una estimación tarda más de lo habitual en llegar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ。「設定」で通知を有効にすると、普段の間隔より推定値の更新が遅れたときにお知らせします。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดอยู่ เปิดการแจ้งเตือนใน «การตั้งค่า» เพื่อรับข้อความเมื่อค่าประมาณล่าช้ากว่ารอบปกติของคุณ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnuto. V Nastavení zapněte upozornění, abyste věděli, kdy se odhad opozdí oproti vašemu obvyklému intervalu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato. Attiva i promemoria in Impostazioni per sapere quando una stima è in ritardo rispetto alla tua frequenza abituale."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikapcsolva. Kapcsold be az emlékeztetőket a Beállításokban, hogy értesülj, ha a becslésed a megszokott ütemedhez képest késik."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprite. Activează mementourile în Setări ca să afli când estimarea întârzie față de ritmul tău obișnuit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανενεργό. Ενεργοποίησε τις υπενθυμίσεις στις Ρυθμίσεις για να μάθεις πότε καθυστερεί η εκτίμησή σου σε σχέση με τη συνηθισμένη συχνότητά σου."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączone. Włącz przypomnienia w Ustawieniach, aby wiedzieć, kiedy nowe oszacowanie się opóźnia względem Twojego zwykłego rytmu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnuté. Zapni pripomienky v Nastaveniach a dozvieš sa, keď sa nový odhad oneskorí oproti tvojmu zvyčajnému intervalu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Av. Slå på påminnelser i Inställningar för att få veta när din uppskattning dröjer längre än vanligt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבוי. אפשר להפעיל תזכורות בהגדרות כדי לקבל עדכון כשהאומדן מתעכב ביחס לתדירות האישית."
          }
        }
      }
    },
    "On. You'll get a nudge when an estimate is overdue against your own cadence, at most once every five days.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On. You'll get a nudge when an estimate is overdue against your own cadence, at most once every five days."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein. Du erhältst höchstens alle fünf Tage einen Hinweis, wenn eine neue Schätzung später kommt als für dich üblich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé. Vous recevrez un rappel lorsque votre prochaine estimation tarde par rapport à votre rythme habituel, au maximum une fois tous les cinq jours."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aan. Je krijgt maximaal eens per vijf dagen een melding wanneer je volgende schatting later komt dan voor jou gebruikelijk is."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已開啟。估算值超過你平常的更新間隔時會收到提醒，最多每五天一次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено. Если новая оценка задержится дольше вашего обычного интервала, вы получите напоминание, не чаще одного раза в пять дней."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفعّل. ستتلقى تنبيهًا عند تجاوز موعد التقدير المعتاد، بحد أقصى مرة كل خمسة أيام."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado. Recibirás un aviso si una estimación tarda más de lo habitual, como máximo una vez cada cinco días."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン。普段の間隔より推定値の更新が遅れたときに、最大5日に1回通知します。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดอยู่ คุณจะได้รับการแจ้งเตือนเมื่อค่าประมาณล่าช้ากว่ารอบปกติ โดยแจ้งได้ไม่เกินหนึ่งครั้งในทุก 5 วัน"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnuto. Upozorníme vás, pokud se odhad opozdí oproti vašemu obvyklému intervalu, nejvýše jednou za pět dnů."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivato. Riceverai un promemoria quando una stima è in ritardo rispetto alla tua frequenza abituale, al massimo una volta ogni cinque giorni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekapcsolva. Emlékeztetőt kapsz, ha a becslésed a megszokott ütemedhez képest késik, legfeljebb ötnaponta egyszer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activat. Primești un memento dacă estimarea întârzie față de ritmul tău obișnuit, cel mult o dată la cinci zile."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργό. Θα λάβεις υπενθύμιση όταν καθυστερεί η εκτίμηση σε σχέση με τη συνηθισμένη συχνότητά σου, το πολύ μία φορά κάθε πέντε ημέρες."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączone. Otrzymasz przypomnienie, gdy nowe oszacowanie opóźnia się względem Twojego zwykłego rytmu, najwyżej raz na pięć dni."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnuté. Keď sa odhad oneskorí oproti tvojmu zvyčajnému intervalu, dostaneš pripomienku najviac raz za päť dní."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På. Du får en påminnelse när en uppskattning dröjer längre än vanligt, högst en gång var femte dag."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעיל. תופיע תזכורת כשהאומדן מתעכב ביחס לתדירות האישית, לכל היותר פעם בחמישה ימים."
          }
        }
      }
    },
    "Once Apple Health records a few estimates this month, your recap will appear here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once Apple Health records a few estimates this month, your recap will appear here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald Apple Health in diesem Monat einige Schätzwerte erfasst hat, erscheint hier dein Rückblick."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre bilan apparaîtra ici lorsqu’Apple Health aura enregistré quelques estimations ce mois-ci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je maandoverzicht verschijnt hier zodra Apple Health deze maand enkele schattingen heeft geregistreerd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 本月記錄幾筆估算值後，每月回顧就會顯示在這裡。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как только Apple Health запишет несколько оценок в этом месяце, здесь появится ваш отчет."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيظهر الملخص هنا بعد أن يسجل Apple Health عدة تقديرات هذا الشهر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resumen aparecerá aquí cuando Apple Health registre varias estimaciones este mes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月Apple Healthに推定値が数件記録されると、ここにまとめが表示されます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สรุปจะแสดงที่นี่เมื่อ Apple Health บันทึกค่าประมาณหลายรายการในเดือนนี้"
          }
        },
        "cs": {
