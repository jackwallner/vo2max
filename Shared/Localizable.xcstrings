          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz średnie okna dopasowania i zmiany w ciągu 30, 90 i 180 dni."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozrite si priemery a zmeny zhody za 30, 90 a 180 dní."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se genomsnitt och förändringar i matchande fönster under 30, 90 och 180 dagar."
          }
        }
      }
    },
    "See matching-window averages, direction toward target, broad age-reference context, and personal bests.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See matching-window averages, direction toward target, broad age-reference context, and personal bests."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir die Durchschnittswerte im Matching-Fenster, die Richtung zum Ziel, den breiten Alterskontext und die persönlichen Bestleistungen an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les moyennes des fenêtres de correspondance, l’orientation vers l’objectif, le contexte général de référence par âge et les records personnels."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk de gemiddelden van het matching-venster, de richting richting het doel, de brede leeftijdsreferentiecontext en persoonlijke records."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看配對視窗平均值、目標方向、廣泛的年齡參考背景和個人最佳成績。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте средние значения окна соответствия, направление к цели, широкий возрастной контекст и личные рекорды."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع متوسطات نافذة المطابقة، والاتجاه نحو الهدف، والسياق المرجعي العمري الواسع، وأفضل النتائج الشخصية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira los promedios de las ventanas coincidentes, la dirección hacia el objetivo, el contexto amplio de referencia de edad y los récords personales."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マッチングウィンドウの平均、ターゲットに向けた方向性、幅広い年齢層の状況、自己ベストを確認します。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูค่าเฉลี่ยหน้าต่างการจับคู่ ทิศทางสู่เป้าหมาย บริบทอ้างอิงอายุแบบกว้าง และสิ่งที่ดีที่สุดส่วนบุคคล"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podívejte se na průměry odpovídajících oken, směr k cíli, široký kontext referenčních věků a osobní rekordy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizza le medie della finestra di corrispondenza, la direzione verso il target, il contesto generale di riferimento per età e i record personali."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekintse meg az egyezési ablakok átlagait, a cél felé vezető irányt, az életkor szerinti széleskörű kontextust és a személyes legjobb eredményeket."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedeți mediile ferestrei de potrivire, direcția către țintă, contextul larg de referință la vârstă și recordurile personale."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείτε τους μέσους όρους αντιστοίχισης παραθύρων, την κατεύθυνση προς τον στόχο, το ευρύ πλαίσιο αναφοράς ηλικίας και τα προσωπικά καλύτερα αποτελέσματα."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz średnie okna dopasowania, kierunek w stronę celu, szeroki kontekst odniesienia do wieku i rekordy życiowe."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozrite si priemery zhody, smerovanie k cieľu, široký kontext vekových referenčných hodnôt a osobné rekordy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se genomsnitt för matchande fönster, riktning mot målet, breda åldersreferenssammanhang och personbästa."
          }
        }
      }
    },
    "See whether recent estimates are moving toward your target range and get a broad timeframe when the data supports one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See whether recent estimates are moving toward your target range and get a broad timeframe when the data supports one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen du, ob sich aktuelle Schätzungen in Richtung deines Zielbereichs bewegen, und erhalte einen breiten Zeitrahmen, wenn die Daten dies unterstützen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez si les estimations récentes se rapprochent de votre plage cible et obtenez un délai large lorsque les données le soutiennent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk of recente schattingen in de richting van je doelbereik gaan en krijg een breed tijdsbestek wanneer de gegevens dit ondersteunen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看最近的估計是否正在接近您的目標範圍，並在數據支援時獲得廣泛的時間範圍。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите, приближаются ли последние оценки к вашему целевому диапазону, и получите широкий временной интервал, когда данные его поддерживают."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرف على ما إذا كانت التقديرات الأخيرة تتحرك نحو النطاق المستهدف واحصل على إطار زمني واسع عندما تدعم البيانات ذلك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira si las estimaciones recientes se están acercando a tu rango objetivo y obtenga un marco temporal amplio cuando los datos lo respalden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の推定値が目標範囲に向かって推移しているかどうかを確認し、データがそれをサポートしている場合は、幅広い期間を取得します。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูว่าค่าประมาณล่าสุดเคลื่อนไปสู่ช่วงเป้าหมายของคุณหรือไม่ และดูกรอบเวลากว้างๆ เมื่อข้อมูลสนับสนุน"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zjistěte, zda se nedávné odhady pohybují směrem k vašemu cílovému rozsahu, a získejte široký časový rámec, pokud jej data podporují."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri se le stime recenti si stanno avvicinando al tuo intervallo target e ottieni un intervallo di tempo ampio quando i dati lo supportano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekintse meg, hogy a legutóbbi becslések a céltartomány felé haladnak-e, és kapjon átfogó időkeretet, ha az adatok ezt támogatják."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedeți dacă estimările recente se îndreaptă spre intervalul dvs. țintă și obțineți un interval de timp larg atunci când datele acceptă unul."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείτε εάν οι πρόσφατες εκτιμήσεις κινούνται προς το εύρος στόχου σας και λάβετε ένα ευρύ χρονικό πλαίσιο όταν τα δεδομένα υποστηρίζουν ένα."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź, czy ostatnie szacunki zbliżają się do docelowego zakresu i uzyskaj szerokie ramy czasowe, jeśli dane to potwierdzają."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zistite, či sa najnovšie odhady pohybujú smerom k vášmu cieľovému rozsahu, a získajte široký časový rámec, keď ho údaje podporujú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se om de senaste uppskattningarna rör sig mot ditt målintervall och få en bred tidsram när data stöder en."
          }
        }
      }
    },
