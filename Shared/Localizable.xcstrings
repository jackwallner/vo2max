    "Resting heart rate, Cardio Recovery, and cardio load, trended over the range you pick.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resting heart rate, Cardio Recovery, and cardio load, trended over the range you pick."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruheherzfrequenz, Cardio-Erholung und Cardio-Belastung im Verlauf des ausgewählten Zeitraums."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fréquence cardiaque au repos, récupération cardio et charge cardio au fil de la période choisie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hartslag in rust, cardioherstel en cardiobelasting over de periode die je kiest."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依照所選期間查看靜止心率、心肺恢復和心肺負荷的變化。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Динамика пульса в покое, восстановления пульса и кардионагрузки за выбранный период."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع معدل ضربات القلب أثناء الراحة وتعافي القلب والحمل القلبي خلال الفترة التي تختارها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta la tendencia de tu frecuencia cardíaca en reposo, recuperación cardíaca y carga cardiovascular durante el período que elijas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した期間の安静時心拍数、心拍数の回復、心肺負荷の推移を確認できます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตามแนวโน้มอัตราการเต้นของหัวใจขณะพัก การฟื้นตัวของอัตราการเต้นของหัวใจ และภาระคาร์ดิโอตลอดช่วงเวลาที่เลือก"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte klidovou srdeční frekvenci, obnovu tepu a kardio zátěž za zvolené období."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui la frequenza cardiaca a riposo, il recupero della frequenza cardiaca e il carico cardio nel periodo che scegli."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kövesd a nyugalmi pulzust, a pulzus-visszaállást és a kardióterhelést a választott időszakban."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărește frecvența cardiacă în repaus, recuperarea frecvenței cardiace și încărcarea cardio pe perioada aleasă."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακολούθησε τον καρδιακό ρυθμό σε ηρεμία, την αποκατάσταση καρδιακού ρυθμού και το καρδιακό φορτίο στην περίοδο που επιλέγεις."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź tętno spoczynkowe, regenerację tętna i obciążenie kardio w wybranym okresie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj pokojový srdcový tep, regeneráciu srdcového tepu a kardio záťaž vo vybranom období."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ vilopuls, pulsåterhämtning och konditionsbelastning under perioden du väljer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעקב אחר דופק במנוחה, התאוששות הדופק ועומס אירובי לאורך התקופה שנבחרה."
          }
        }
      }
    },
