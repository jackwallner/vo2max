    "Your health data never leaves your devices. No account, no cloud sync.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your health data never leaves your devices. No account, no cloud sync."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Gesundheitsdaten verlassen niemals deine Geräte. Kein Konto, keine Cloud-Synchronisierung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données de santé ne quittent jamais vos appareils. Pas de compte, pas de synchronisation cloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gezondheidsgegevens verlaten nooit je apparaten. Geen account, geen cloudsynchronisatie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的健康數據永遠不會離開您的裝置。沒有帳戶，沒有雲端同步。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные о вашем здоровье никогда не покидают ваши устройства. Нет аккаунта, нет синхронизации с облаком."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بياناتك الصحية لا تترك أجهزتك أبدًا. لا يوجد حساب ولا مزامنة سحابية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos de salud nunca salen de tus dispositivos. Sin cuenta, sin sincronización en la nube."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "健康データがデバイスから流出することはありません。アカウントもクラウド同期もありません。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลสุขภาพของคุณจะไม่ออกจากอุปกรณ์ของคุณ ไม่มีบัญชี ไม่มีการซิงค์บนคลาวด์"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše zdravotní údaje nikdy neopustí vaše zařízení. Žádný účet, žádná synchronizace s cloudem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati sanitari non lasciano mai i tuoi dispositivi. Nessun account, nessuna sincronizzazione cloud."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egészségügyi adatai soha nem hagyják el eszközeit. Nincs fiók, nincs felhőszinkronizálás."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele dvs. de sănătate nu părăsesc niciodată dispozitivele dvs. Fără cont, fără sincronizare în cloud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δεδομένα υγείας σας δεν φεύγουν ποτέ από τις συσκευές σας. Χωρίς λογαριασμό, χωρίς συγχρονισμό στο cloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dane zdrowotne nigdy nie opuszczają Twoich urządzeń. Bez konta, bez synchronizacji w chmurze."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše zdravotné údaje nikdy neopustia vaše zariadenia. Žiadny účet, žiadna synchronizácia s cloudom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din hälsodata lämnar aldrig dina enheter. Inget konto, ingen molnsynkronisering."
          }
        }
      }
    },
