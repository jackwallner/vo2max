        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenejte svižnou venkovní procházku, běh nebo túru s Apple Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra una camminata, una corsa o un'escursione veloce all'aperto con Apple Watch."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzítsen egy lendületes szabadtéri sétát, futást vagy túrázást a Apple Watch segítségével."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrați o plimbare, alergare sau drumeție în aer liber cu Apple Watch."
          }
        },
        "el": {
          "stringUnit": {
