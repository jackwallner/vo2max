            "state": "translated",
            "value": "Il periodo di prova non è iniziato. Tocca di nuovo per continuare."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem indult el a próbaidőszak. Koppints újra a folytatáshoz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Perioada de probă nu a început. Atinge din nou pentru a continua."
          }
        },
