    "Used for the broad fitness age estimate and VO2+ typical-range context. These are motivational estimates, not clinical results.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for the broad fitness age estimate and VO2+ typical-range context. These are motivational estimates, not clinical results."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dient als Grundlage für die grobe Fitnessalter-Schätzung und den VO2+-Referenzbereich. Diese Schätzungen dienen der Orientierung und sind keine klinischen Ergebnisse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces données servent à estimer l’âge de forme et à situer la plage habituelle VO2+. Ce sont des repères indicatifs, pas des résultats cliniques."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze gegevens worden gebruikt voor de globale schatting van je fitnessleeftijd en de gebruikelijke VO2+-bereiken. Het zijn indicatieve schattingen, geen klinische resultaten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於概略估算體適能年齡，以及提供 VO2+ 一般範圍參考。這些估算僅供體適能參考，並非臨床結果。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется для приблизительной оценки фитнес-возраста и типичного диапазона VO2+. Это ориентиры для мотивации, а не клинические результаты."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم هذه البيانات لتقدير العمر اللياقي والنطاق المعتاد في VO2+ بصورة عامة. هذه تقديرات تحفيزية وليست نتائج سريرية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para calcular una edad física aproximada y ofrecer referencias generales en VO2+. Son estimaciones para motivarte, no resultados clínicos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィットネス年齢の概算とVO2+の一般的な範囲の参考に使用します。モチベーションのための推定値であり、臨床結果ではありません。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้คำนวณอายุฟิตเนสโดยคร่าวและเป็นข้อมูลอ้างอิงช่วงทั่วไปใน VO2+ ค่าประมาณเหล่านี้ใช้สร้างแรงจูงใจ ไม่ใช่ผลทางคลินิก"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slouží k orientačnímu odhadu kondičního věku a obvyklého rozmezí ve VO2+. Jde o motivační odhady, nikoli klinické výsledky."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usati per la stima indicativa dell’età fitness e per il confronto con gli intervalli tipici di VO2+. Sono stime motivazionali, non risultati clinici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezek szolgálnak a fitneszkor hozzávetőleges becsléséhez és a VO2+ szokásos tartományának összehasonlításához. Motivációs becslések, nem klinikai eredmények."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosit pentru estimarea orientativă a vârstei de fitness și pentru comparația VO2+ cu intervalul obișnuit. Sunt estimări motivaționale, nu rezultate clinice."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιείται για τη γενική εκτίμηση ηλικίας φυσικής κατάστασης και τη σύγκριση VO2+ με το συνηθισμένο εύρος. Πρόκειται για εκτιμήσεις με κίνητρο, όχι κλινικά αποτελέσματα."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Służy do ogólnego oszacowania wieku kondycyjnego i porównania VO2+ z typowym zakresem. To oszacowania motywacyjne, a nie wyniki kliniczne."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Používa sa na všeobecný odhad kondičného veku a porovnanie VO2+ s obvyklým rozsahom. Ide o motivačné odhady, nie klinické výsledky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Används för den ungefärliga uppskattningen av konditionsålder och VO2+-jämförelser med typiska intervall. Det är uppskattningar för motivation, inte kliniska resultat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משמש לאומדן כללי של גיל הכושר ולהשוואה לטווחים הרגילים ב-VO2+. אלה אומדנים למוטיבציה, לא תוצאות קליניות."
          }
        }
      }
    },
