    "Feedback opens your mail app with a private draft. No analytics, no account.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback opens your mail app with a private draft. No analytics, no account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback öffnet deine E-Mail-App mit einem privaten Entwurf. Keine Analyse, kein Konto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commentaires ouvrent votre application de messagerie avec un brouillon privé. Pas d'analyse, pas de compte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback opent je e-mailapp met een privéconcept. Geen analyses, geen account."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回饋會開啟您的郵件應用程序，其中包含私人草稿。沒有分析，就沒有帳戶。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отзыв открывает ваше почтовое приложение с личным черновиком. Никакой аналитики, никакого аккаунта."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفتح التعليقات تطبيق البريد الخاص بك بمسودة خاصة. لا تحليلات ولا حساب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comentarios abren tu aplicación de correo con un borrador privado. Sin análisis, sin cuenta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードバックにより、メール アプリがプライベートの下書きで開きます。分析もアカウントもありません。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผลตอบรับจะเปิดแอปอีเมลของคุณด้วยร่างจดหมายส่วนตัว ไม่มีการวิเคราะห์ ไม่มีบัญชี"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback otevře vaši poštovní aplikaci se soukromým konceptem. Žádná analytika, žádný účet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback apre la tua app di posta con una bozza privata. Nessuna analisi, nessun account."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Visszajelzés megnyitja a levelezőalkalmazást egy privát piszkozattal. Nincs elemzés, nincs fiók."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback vă deschide aplicația de e-mail cu o schiță privată. Fără analize, fără cont."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα σχόλια ανοίγουν την εφαρμογή αλληλογραφίας σας με ένα ιδιωτικό πρόχειρο. Χωρίς αναλυτικά στοιχεία, χωρίς λογαριασμό."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opinia otwiera Twoją aplikację pocztową z prywatną wersją roboczą. Żadnych analiz, żadnego konta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spätná väzba otvorí vašu poštovú aplikáciu so súkromným konceptom. Žiadna analytika, žiadny účet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback öppnar din e-postapp med ett privat utkast. Ingen analys, inget konto."
          }
        }
      }
    },
