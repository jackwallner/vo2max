    "Apple Health estimates are for fitness awareness. This app does not diagnose or treat health conditions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health estimates are for fitness awareness. This app does not diagnose or treat health conditions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health-Schätzungen dienen der Fitness-Einordnung. Diese App diagnostiziert oder behandelt keine Erkrankungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les estimations Apple Health servent à suivre votre forme cardio. Cette app ne diagnostique ni ne traite aucun problème de santé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health-schattingen helpen je je conditie te volgen. Deze app stelt geen diagnoses en behandelt geen gezondheidsproblemen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 估算值可供了解體適能趨勢。本 App 不會診斷或治療健康問題。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценки Apple Health предназначены для повышения осведомленности о фитнесе. Это приложение не диагностирует и не лечит заболевания."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقديرات Apple Health لمتابعة اللياقة. لا يشخّص هذا التطبيق الحالات الصحية ولا يعالجها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estimaciones de Apple Health te ayudan a conocer tu capacidad aeróbica. Esta app no diagnostica ni trata problemas de salud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Healthの推定値は心肺機能の把握に役立てるためのものです。このアプリは健康状態の診断や治療を行いません。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าประมาณจาก Apple Health ใช้ติดตามสมรรถภาพร่างกาย แอปนี้ไม่วินิจฉัยหรือรักษาปัญหาสุขภาพ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhady Apple Health slouží k lepšímu přehledu o kondici. Aplikace nediagnostikuje ani neléčí zdravotní potíže."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stime di Apple Health aiutano a conoscere la forma fisica. L’app non diagnostica né cura patologie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Health becslései a fittség nyomon követésére szolgálnak. Az app nem diagnosztizál és nem kezel egészségi állapotokat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimările Apple Health te ajută să urmărești fitnessul. Aplicația nu diagnostichează și nu tratează afecțiuni."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εκτιμήσεις του Apple Health βοηθούν στην παρακολούθηση της φυσικής κατάστασης. Η εφαρμογή δεν διαγιγνώσκει ούτε θεραπεύει παθήσεις."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszacowania Apple Health pomagają śledzić kondycję. Aplikacja nie diagnozuje ani nie leczy schorzeń."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhady Apple Health slúžia na sledovanie kondície. Aplikácia nediagnostikuje ani nelieči zdravotné ťažkosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health-uppskattningar hjälper dig att följa konditionen. Appen diagnostiserar eller behandlar inga sjukdomar."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אומדני Apple Health נועדו למודעות לכושר. האפליקציה אינה מאבחנת או מטפלת במצבים רפואיים."
          }
        }
      }
    },
