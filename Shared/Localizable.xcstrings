    "Apple Health estimates are for fitness awareness. This app does not diagnose or treat health conditions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health estimates are for fitness awareness. This app does not diagnose or treat health conditions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health-Schätzungen dienen dem Fitnessbewusstsein. Diese App diagnostiziert oder behandelt keine Gesundheitszustände."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les estimations Apple Health sont destinées à la sensibilisation à la condition physique. Cette application ne diagnostique ni ne traite les problèmes de santé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health-schattingen zijn bedoeld voor fitnessbewustzijn. Deze app diagnosticeert of behandelt geen gezondheidsproblemen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health估計是為了健身意識。此應用程式不診斷或治療健康狀況。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценки Apple Health предназначены для повышения осведомленности о фитнесе. Это приложение не диагностирует и не лечит заболевания."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقديرات Apple Health مخصصة للتوعية باللياقة البدنية. لا يقوم هذا التطبيق بتشخيص أو علاج الحالات الصحية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estimaciones Apple Health son para concienciar sobre el estado físico. Esta aplicación no diagnostica ni trata condiciones de salud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health の推定値は、フィットネスの意識を高めるためのものです。このアプリは健康状態を診断または治療するものではありません。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าประมาณ Apple Health มีไว้เพื่อการรับรู้ด้านฟิตเนส แอปนี้ไม่ได้วินิจฉัยหรือรักษาสภาวะสุขภาพ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health odhady jsou pro povědomí o fitness. Tato aplikace nediagnostikuje ani neléčí zdravotní stavy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stime Apple Health riguardano la consapevolezza del fitness. Questa app non diagnostica né tratta le condizioni di salute."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Health becslések a fitnesz tudatosságra vonatkoznak. Ez az alkalmazás nem diagnosztizál és nem kezel egészségügyi állapotokat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimările Apple Health sunt pentru conștientizarea fitnessului. Această aplicație nu diagnostichează și nu tratează condițiile de sănătate."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εκτιμήσεις Apple Health αφορούν ευαισθητοποίηση στη φυσική κατάσταση. Αυτή η εφαρμογή δεν κάνει διάγνωση ή θεραπεία παθήσεων υγείας."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacunki Apple Health dotyczą świadomości sprawności fizycznej. Ta aplikacja nie diagnozuje ani nie leczy schorzeń."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health odhady sú pre povedomie o kondícii. Táto aplikácia nediagnostikuje ani nelieči zdravotné stavy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health uppskattningar är för träningsmedvetenhet. Denna app diagnostiserar eller behandlar inte hälsotillstånd."
          }
        }
      }
    },
