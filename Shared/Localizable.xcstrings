    "At age %lld, the typical cardio fitness range for your profile is %lld–%lld mL/kg/min. Adjust it if you like.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At age %lld, the typical cardio fitness range for your profile is %lld–%lld mL/kg/min. Adjust it if you like."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit %1$lld Jahren liegt der typische Cardiofitness-Bereich für dein Profil bei %2$lld–%3$lld mL/kg/min. Du kannst ihn anpassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À %1$lld ans, la plage habituelle de forme cardio pour votre profil est de %2$lld à %3$lld mL/kg/min. Vous pouvez l’ajuster."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor je leeftijd van %1$lld jaar is het gebruikelijke cardiofitnessbereik voor je profiel %2$lld–%3$lld mL/kg/min. Je kunt dit aanpassen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以 %1$lld 歲來看，你的參考個人檔案之一般心肺適能範圍為 %2$lld–%3$lld mL/kg/min。你可以自行調整。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для возраста %1$lld лет типичный диапазон кардиовыносливости для вашего профиля: %2$lld–%3$lld mL/kg/min. При желании измените целевой диапазон."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في عمر %1$lld عامًا، يتراوح المستوى المعتاد للياقتك القلبية بين %2$lld و%3$lld mL/kg/min. يمكنك تعديل نطاق الهدف كما تشاء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A los %1$lld años, el rango habitual de capacidad aeróbica para tu perfil es de %2$lld a %3$lld mL/kg/min. Ajusta tu objetivo si quieres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年齢が%1$lld歳の場合、心肺機能の一般的な範囲は%2$lld～%3$lld mL/kg/minです。必要に応じて目標範囲を調整できます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่ออายุ %1$lld ปี ช่วงคาร์ดิโอฟิตเนสโดยทั่วไปสำหรับโปรไฟล์ของคุณคือ %2$lld–%3$lld mL/kg/min ปรับช่วงเป้าหมายได้ตามต้องการ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro věk %1$lld let je obvyklé rozmezí kardiorespirační kondice pro váš profil %2$lld–%3$lld mL/kg/min. Podle potřeby ho upravte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A %1$lld anni, l’intervallo tipico di fitness cardiovascolare per il tuo profilo è %2$lld–%3$lld mL/kg/min. Puoi modificarlo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld évesen a profilodra jellemző kardiofitnesz-tartomány %2$lld–%3$lld mL/kg/min. Igény szerint módosíthatod."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La %1$lld ani, intervalul obișnuit de fitness cardiovascular pentru profilul tău este %2$lld–%3$lld mL/kg/min. Îl poți ajusta."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στην ηλικία των %1$lld ετών, το συνηθισμένο εύρος καρδιοαναπνευστικής φυσικής κατάστασης για το προφίλ σου είναι %2$lld–%3$lld mL/kg/min. Μπορείς να το προσαρμόσεις."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla wieku %1$lld lat typowy zakres kondycji kardio w Twoim profilu wynosi %2$lld–%3$lld mL/kg/min. Możesz go zmienić."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre vek %1$lld rokov je obvyklý rozsah kardiorespiračnej kondície v tvojom profile %2$lld–%3$lld mL/kg/min. Môžeš ho upraviť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vid %1$lld års ålder är det typiska konditionsintervallet för din profil %2$lld–%3$lld mL/kg/min. Du kan justera det."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בגיל %1$lld, הטווח הרגיל של הכושר האירובי לפרופיל שלך הוא %2$lld–%3$lld mL/kg/min. אפשר לשנות אותו לפי הצורך."
          }
        }
      }
    },
    "At least 20 minutes of steady, brisk effort.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least 20 minutes of steady, brisk effort."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens 20 Minuten gleichmäßige, zügige Bewegung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins 20 minutes d’effort régulier et soutenu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minstens 20 minuten gelijkmatige, stevige inspanning."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少持續 20 分鐘的穩定快走或運動。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не менее 20 минут непрерывной активной нагрузки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما لا يقل عن 20 دقيقة من النشاط المستمر والنشط."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos 20 minutos de actividad continua e intensa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "20分以上、一定のペースで活発に運動してください。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกกำลังกายอย่างต่อเนื่องและกระฉับกระเฉงอย่างน้อย 20 นาที"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Alespoň 20 minut souvislé svižné aktivity."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Almeno 20 minuti di sforzo costante e vivace."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legalább 20 perc egyenletes, lendületes erőfeszítés."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel puțin 20 de minute de efort constant și vioi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τουλάχιστον 20 λεπτά σταθερής, ζωηρής προσπάθειας."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co najmniej 20 minut stałego, energicznego wysiłku."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspoň 20 minút vytrvalého, svižného úsilia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minst 20 minuter med jämn, rask ansträngning."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לפחות 20 דקות של פעילות נמרצת ורציפה."
          }
        }
      }
    },
