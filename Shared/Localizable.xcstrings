    "Location enabled so pace and elevation are available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location enabled so pace and elevation are available."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standort aktiviert, sodass Tempo und Höhe verfügbar sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Localisation activée afin que le rythme et l'élévation soient disponibles."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatie ingeschakeld, zodat tempo en hoogte beschikbaar zijn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位置已啟用，因此步速和海拔高度可用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Местоположение включено, поэтому доступны темп и высота."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تمكين الموقع حتى تتوفر السرعة والارتفاع."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubicación habilitada para que el ritmo y la elevación estén disponibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報が有効になっているため、ペースと高度が利用可能です。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้งานตำแหน่งเพื่อให้สามารถก้าวและระดับความสูงได้"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poloha povolena, takže je k dispozici rychlost a nadmořská výška."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posizione abilitata in modo che ritmo e altitudine siano disponibili."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helymeghatározás engedélyezve van, így elérhető a tempó és a magasság."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Locația este activată, astfel încât ritmul și altitudinea sunt disponibile."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τοποθεσία είναι ενεργοποιημένη, ώστε ο ρυθμός και το υψόμετρο να είναι διαθέσιμα."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
