            "value": "การลดลงของอัตราการเต้นของหัวใจในนาทีแรกหลังออกกำลังกาย"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokles srdeční frekvence během první minuty po skončení zaznamenaného tréninku"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La diminuzione della frequenza cardiaca nel primo minuto dopo la fine di un allenamento"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulzuscsökkenés az edzés utáni első percben"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scăderea frecvenței cardiace în primul minut după antrenament"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μείωση καρδιακού ρυθμού στο πρώτο λεπτό μετά το τέλος της προπόνησης"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spadek tętna w pierwszej minucie po zakończeniu treningu"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokles srdcového tepu počas prvej minúty po tréningu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsens minskning under första minuten efter ett träningspass"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הירידה בדופק בדקה שאחרי סיום אימון שתועד"
          }
        }
      }
    },
    "The recent cardio fitness trend is flat or declining, so a time-to-target estimate is not meaningful.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recent cardio fitness trend is flat or declining, so a time-to-target estimate is not meaningful."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Cardiofitness-Trend ist derzeit stabil oder rückläufig. Daher lässt sich keine aussagekräftige Zeit bis zum Ziel schätzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tendance récente de forme cardio est stable ou en baisse. Le délai pour atteindre la cible ne peut donc pas être estimé utilement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De recente cardiofitnesstrend is stabiel of dalend. Een schatting van de tijd tot je doel is daarom niet zinvol."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "近期心肺適能趨勢持平或下降，因此無法合理估算達到目標所需的時間。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кардиовыносливость не растёт или снижается, поэтому срок достижения цели рассчитать нельзя."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتجاه اللياقة القلبية ثابت أو متراجع، لذلك لا يمكن تقدير المدة اللازمة للوصول إلى الهدف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tendencia reciente de capacidad aeróbica se mantiene o desciende, así que no tiene sentido estimar el plazo para alcanzar el objetivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の心肺機能は横ばいまたは低下しているため、目標までの期間は算出できません。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนวโน้มสมรรถภาพหัวใจและหลอดเลือดคงที่หรือลดลง จึงไม่สามารถประเมินเวลาที่จะถึงเป้าหมายได้อย่างมีความหมาย"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedávný trend kardiorespirační kondice je stabilní nebo klesá, proto nelze smysluplně odhadnout čas do dosažení cíle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’andamento recente del fitness cardiovascolare è stabile o in calo, quindi non è possibile stimare in modo utile il tempo per raggiungere l’obiettivo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legutóbbi kardiofitnesz-trend stabil vagy csökkenő, ezért nem lehet érdemben megbecsülni, mikor éred el a célt."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendința recentă de fitness cardiovascular este stabilă sau în scădere, așa că nu se poate estima în mod util timpul până la țintă."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρόσφατη τάση της καρδιοαναπνευστικής φυσικής κατάστασης είναι σταθερή ή πτωτική, οπότε δεν έχει νόημα να εκτιμηθεί ο χρόνος μέχρι τον στόχο."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatni trend kondycji kardio jest stabilny lub spadkowy, więc oszacowanie czasu do celu nie byłoby miarodajne."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedávny trend kardiorespiračnej kondície je stabilný alebo klesá, preto odhad času do cieľa nemá význam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den senaste konditionstrenden är stabil eller sjunkande, så en uppskattning av tiden till målet är inte meningsfull."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מגמת הכושר האירובי האחרונה יציבה או בירידה, ולכן אין משמעות להערכת הזמן עד הגעה ליעד."
          }
        }
      }
    },
    "The recent direction is positive, but too gradual for a useful timeframe.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recent direction is positive, but too gradual for a useful timeframe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Trend zeigt nach oben, doch die Veränderung ist zu gering für einen hilfreichen Zeitrahmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tendance récente est positive, mais son évolution est trop lente pour estimer un délai utile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De recente trend is positief, maar verandert te langzaam voor een bruikbare tijdsinschatting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "近期趨勢向上，但變化太小，無法提供實用的時間估算。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Динамика положительная, но рост слишком медленный, чтобы рассчитать срок."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاتجاه الأخير إيجابي، لكن التغير تدريجي جدًا لتقدير مدة مفيدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tendencia reciente es positiva, pero avanza demasiado despacio para calcular un plazo útil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近は上向きですが、変化が緩やかなため期間を算出できません。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนวโน้มล่าสุดดีขึ้น แต่ค่อยเป็นค่อยไปเกินกว่าจะประเมินระยะเวลาได้"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedávný trend se zlepšuje, ale příliš pomalu na užitečný časový odhad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tendenza recente è positiva, ma troppo graduale per stimare una tempistica utile."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legutóbbi trend pozitív, de túl lassú ahhoz, hogy hasznos időbecslést adjon."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendința recentă este pozitivă, dar prea lentă pentru o estimare utilă a timpului."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρόσφατη τάση είναι θετική, αλλά πολύ αργή για χρήσιμη εκτίμηση χρόνου."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatni trend jest wzrostowy, ale zbyt powolny, by oszacować przydatny czas."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedávny trend je pozitívny, no príliš pozvoľný na užitočný odhad času."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den senaste trenden är positiv, men för långsam för en användbar tidsuppskattning."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המגמה האחרונה חיובית, אך איטית מכדי לספק הערכת זמן מועילה."
          }
        }
      }
    },
