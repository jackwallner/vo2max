    "Target outlook needs at least five readings across the last 180 days.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target outlook needs at least five readings across the last 180 days."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für den Ausblick auf dein Ziel brauchst du mindestens fünf Messwerte aus den letzten 180 Tagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La projection vers la cible nécessite au moins cinq mesures sur les 180 derniers jours."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor een vooruitblik op je doel zijn minstens vijf metingen in de afgelopen 180 dagen nodig."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去 180 天內至少需要五筆測量值，才能顯示目標進度展望。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для прогноза нужны как минимум пять оценок за последние 180 дней."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب عرض التقدم نحو الهدف خمسة تقديرات على الأقل خلال آخر 180 يومًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para estimar el progreso hacia el objetivo se necesitan al menos cinco estimaciones en los últimos 180 días."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標への見通しを表示するには、過去180日間に推定値が5件以上必要です。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การประเมินแนวโน้มสู่เป้าหมายต้องมีค่าประมาณอย่างน้อย 5 รายการในช่วง 180 วันที่ผ่านมา"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K výhledu k cíli je potřeba alespoň pět měření za posledních 180 dnů."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per stimare l’avvicinamento all’obiettivo servono almeno cinque misurazioni negli ultimi 180 giorni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A cél felé vezető előretekintéshez legalább öt mérés kell az elmúlt 180 napból."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimarea spre țintă are nevoie de cel puțin cinci măsurători în ultimele 180 de zile."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για την εκτίμηση πορείας προς τον στόχο χρειάζονται τουλάχιστον πέντε μετρήσεις στις τελευταίες 180 ημέρες."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do określenia perspektywy celu potrzeba co najmniej pięciu pomiarów z ostatnich 180 dni."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na výhľad k cieľu potrebuješ aspoň päť meraní za posledných 180 dní."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att visa vägen mot målet behövs minst fem mätningar under de senaste 180 dagarna."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להציג תחזית ליעד נדרשות לפחות חמש מדידות במהלך 180 הימים האחרונים."
          }
        }
      }
    },
