          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2 Max Daily Tracker จะไม่เขียนข้อมูลใดๆ ลง Apple Health"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2 Max Daily Tracker nikdy nezapisuje data do Apple Health."
          }
        },
        "it": {
