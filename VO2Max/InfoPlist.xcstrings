            "state": "translated",
            "value": "Το VO2 Max Daily Tracker δεν γράφει ποτέ δεδομένα στο Apple Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2 Max Daily Tracker nigdy nie zapisuje danych w Apple Health."
          }
        },
        "sk": {
