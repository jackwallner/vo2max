            "state": "translated",
            "value": "VO2 Max Daily Tracker schreibt keine Daten in Apple Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2 Max Daily Tracker n’écrit aucune donnée dans Apple Health."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2 Max Daily Tracker schrijft geen gegevens naar Apple Health."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2 Max Daily Tracker 不會寫入任何資料至 Apple Health。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2 Max Daily Tracker никогда не записывает данные в Apple Health."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يكتب VO2 Max Daily Tracker أي بيانات إلى Apple Health."
          }
        },
