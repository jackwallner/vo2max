            "state": "translated",
            "value": "VO2 Max Daily Tracker non scrive mai dati su Apple Health."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A VO2 Max soha nem ír adatot az Apple Healthbe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2 Max Daily Tracker nu scrie niciodată date în Apple Health."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το VO2 Max Daily Tracker δεν γράφει ποτέ δεδομένα στο Apple Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2 Max Daily Tracker nigdy nie zapisuje danych w Apple Health."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2 Max Daily Tracker nikdy nezapisuje údaje do Apple Health."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2 Max Daily Tracker skriver aldrig data till Apple Health."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2 Max Daily Tracker לעולם אינה כותבת נתונים ל-Apple Health."
          }
        }
      }
    }
  },
